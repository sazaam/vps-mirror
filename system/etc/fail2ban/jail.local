# fail2ban tuning — managed by vps-mirror
# Bans IPs hitting sshd hard, enforced through ufw (DROP = stealth, all ports).

[DEFAULT]
# Whitelist: localhost + optional trusted IP. Replace/track this per deployment;
# do not commit a personal or dynamic public address.
ignoreip = 127.0.0.1/8 ::1 REPLACE_WITH_TRUSTED_IP

# 10 failed attempts in 10 minutes earns a 1-hour ban
bantime  = 1h
findtime = 10m
maxretry = 10

# Ban via the packaged ufw action, overriding REJECT -> DENY (DROP = no reply)
banaction = ufw[blocktype=deny]
banaction_allports = ufw[blocktype=deny]

backend = auto

[sshd]
enabled  = true
port     = 2022
logpath  = /var/log/auth.log
maxretry = 10
