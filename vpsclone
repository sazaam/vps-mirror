def os_pretty() -> str:
    try:
        return platform.freedesktop_os_release().get("PRETTY_NAME", platform.platform())
    except OSError:
        return platform.platform()


def detect_timezone() -> str:
    rc, out = cmd(["timedatectl", "show", "-p", "Timezone", "--value"], quiet=True)
    if rc == 0 and out.strip():
        return out.strip()
    return read_text("/etc/timezone").strip() or "UTC"


def detect_ssh_port() -> str:
    port = None
    files = [Path("/etc/ssh/sshd_config")]
    d = Path("/etc/ssh/sshd_config.d")
    if d.exists():
        files += sorted(d.glob("*.conf"))
    for f in files:
        for line in read_text(f).splitlines():
            m = re.match(r"^\s*Port\s+(\d+)", line)
            if m:
                port = m.group(1)
    return port or "22"


def detect_ufw_allow(port: str) -> list[str]:
    attempts = [["ufw", "status", "verbose"]] if is_root() else [
        ["sudo", "-n", "ufw", "status", "verbose"],
    ]
    for argv in attempts:
        rc, out = cmd(argv, quiet=True)
        if rc != 0:
            continue
        rules = []
        for line in out.splitlines():
            if not re.search(r"\bALLOW\b", line):
                continue
            # ufw prints "[ 1] 2022/tcp ALLOW IN ..."; the bracketed number is
            # a rule id, not a port. Strip it and read the first To-column token.
            s = re.sub(r"^\s*\[\s*\d+\]\s*", "", line)
            parts = s.split()
            if not parts:
                continue
            to = parts[0]
            if re.fullmatch(r"[A-Za-z0-9_.-]+(?:/(?:tcp|udp))?", to):
                rules.append(to)
        sshrule = f"{port}/tcp"
        if sshrule not in rules:
            rules.insert(0, sshrule)
        return sorted(set(rules))
    log("ufw status unreadable; seeding ssh port only - rerun capture with sudo", "WARN")
    return [f"{port}/tcp"]


def enabled_services() -> list[str]:
    rc, out = cmd(["systemctl", "list-unit-files", "--state=enabled",
                   "--no-pager", "--plain"], quiet=True)
    found = set()
    if rc == 0:
        for line in out.splitlines():
            parts = line.split()
            if not parts:
                continue
            name = parts[0]
            if name in SAFE_SERVICES or name.replace(".service", "") in SAFE_SERVICES:
                found.add(name)
    return sorted(found) or ["ssh", "fail2ban", "cron"]


def mise_tools(home: str) -> list[str]:
    p = Path(home) / ".config/mise/config.toml"
    if not p.exists():
        return []
    try:
        with p.open("rb") as f:
            d = tomllib.load(f)
    except Exception:
        return []
    out = []
    for k, v in d.get("tools", {}).items():
        if isinstance(v, str):
            out.append(f"{k}@{v}")
        elif isinstance(v, dict):
            out.append(f"{k}@{v.get('version', 'latest')}")
        elif isinstance(v, list):
            out += [f"{k}@{x}" for x in v]
    return out


