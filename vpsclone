def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="vpsclone", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    c = sub.add_parser("capture", help="read current machine into the manifest")
    c.add_argument("--user", help="target login user (default: SUDO_USER or current)")
    c.add_argument("--name", help="baseline name")
    c.add_argument("--users",
                   help="comma-separated additional users to capture (explicit allowlist)")
    c.add_argument("--clear-users", action="store_true",
                   help="drop existing [[users]] entries from the manifest")
    c.set_defaults(func=op_capture)

    c = sub.add_parser("audit", help="local audit -> mirror.toml + generated manifest")
    c.add_argument("--user", help="target login user (default: SUDO_USER or current)")
    c.add_argument("--name", help="baseline name")
    c.add_argument("--users", help="comma-separated additional users to capture")
    c.add_argument("--clear-users", action="store_true",
                   help="drop existing [[users]] entries from the manifest")
    c.add_argument("--out", default="mirror.toml", help="descriptor output path")
    c.set_defaults(func=op_audit)

    c = sub.add_parser("drive", help="resolve mirror.toml prompts, apply on target")
    c.add_argument("--plan", default="mirror.toml", help="mirror descriptor")
    c.add_argument("--apply", action="store_true",
                   help="run apply after materialising manifest")
    c.add_argument("--dry-run", action="store_true", help="pass --dry-run to apply")
    c.add_argument("--only", help="comma-separated steps when --apply is used")
    c.add_argument("--no-verify", action="store_true", help="skip post-apply verify")
    c.add_argument("--tui", action="store_true",
                   help="launch the curses task driver after resolving prompts")
    c.set_defaults(func=op_drive)

    c = sub.add_parser("plan", help="show desired vs current")
    c.set_defaults(func=op_plan)

    c = sub.add_parser("apply", help="replay manifest on a fresh box")
    c.add_argument("--dry-run", action="store_true")
    c.add_argument("--only", help="comma-separated steps: " + ",".join(STEP_ORDER))
    c.add_argument("--hostname", help="override target hostname")
    c.add_argument("--ssh-port", type=int, help="override ssh port")
    c.add_argument("--no-verify", action="store_true")
    c.set_defaults(func=op_apply)

    c = sub.add_parser("verify", help="post-apply health checks")
    c.set_defaults(func=op_verify)

    c = sub.add_parser("toolchain",
                       help="install managers required by the manifest")
    c.add_argument("--yes", action="store_true",
                   help="accept every install recipe without prompting")
    c.set_defaults(func=op_ensure_toolchain)

    c = sub.add_parser("install-node-deps",
                       help="ask per Node project, then install dependencies")
    c.add_argument("--yes", action="store_true",
                   help="accept every project without prompting")
    c.set_defaults(func=op_install_node_deps)

    c = sub.add_parser("install-cargo-deps",
