def invoking_home() -> Path:
    """Home of the human who invoked us, even through sudo."""
    user = os.environ.get("SUDO_USER")
    if user and user != "root":
        try:
            return Path(pwd.getpwnam(user).pw_dir)
        except KeyError:
            pass
    return Path(os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir).expanduser()


