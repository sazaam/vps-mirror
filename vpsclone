def pkg_installed(pkg: str) -> bool:
    rc, out = cmd(["dpkg-query", "-W", "-f=${Status}", pkg], quiet=True)
    return rc == 0 and "install ok installed" in out


def op_plan(args) -> None:
    m = load_manifest()
    home = m["target"]["home"]
    rows = []

    pkgs = m.get("packages", {})
    missing = [p for p in pkgs.get("apt", []) if not pkg_installed(p)]
    rows.append(("apt packages", f"{len(missing)} to install" if missing else "ok",
                 ", ".join(missing[:8]) + (" ..." if len(missing) > 8 else "")))
    def pinned_count(installer: str) -> int:
        return sum(1 for v in expected_versions(m, installer).values() if v)

    rows.append(("npm/pipx", "ok",
                 f"{len(expected_versions(m, 'npm'))}/{len(expected_versions(m, 'pipx'))} "
                 f"configured ({pinned_count('npm')}/{pinned_count('pipx')} pinned)"))
    rows.append(("cargo", "ok",
                 f"{len(expected_versions(m, 'cargo'))} recorded "
                 f"({pinned_count('cargo')} pinned) - replayed via cargo install"))

    users = effective_users(m)
    missing_users = [u["name"] for u in users if not user_exists(u["name"])]
    rows.append(("users", f"{len(missing_users)} to create" if missing_users else "ok",
                 ", ".join(missing_users[:8])))

    df = []
    for target, src in m.get("dotfiles", {}).items():
        s, d = REPO / src, expand(target, home)
        if not s.is_file():
            df.append(f"MISSING SOURCE {src}")
        elif not d.is_file() or d.read_bytes() != s.read_bytes():
            df.append(target)
    rows.append(("dotfiles", f"{len(df)} to write" if df else "ok", ", ".join(df[:8])))

    sf = []
    for target, src in m.get("system_files", {}).items():
        s, d = REPO / src, Path(target)
        if not s.is_file():
            sf.append(f"MISSING SOURCE {src}")
        elif not d.is_file() or d.read_bytes() != s.read_bytes():
            sf.append(target)
    rows.append(("system files", f"{len(sf)} to write" if sf else "ok", ", ".join(sf[:5])))

    port = str(m["ssh"]["port"])
    allow = m.get("firewall", {}).get("allow", [])
    rows.append(("firewall", "open " + ",".join(allow) if allow else "no rules",
                 f"ssh={port}/tcp"))

    svcs = m.get("services", {}).get("enable", [])
    noton = []
    for s in svcs:
        rc, out = cmd(["systemctl", "is-enabled", s], quiet=True)
        if rc != 0:
            noton.append(s)
    rows.append(("services", f"{len(noton)} to enable" if noton else "ok", ", ".join(noton)))

    repos = m.get("repos", [])
    pinnedrepos = sum(1 for r in repos if str(r.get("commit", "")).strip())
    missingrepos = [r["path"] for r in repos if not expand(r["path"], home).exists()]
    rows.append(("repos", f"{len(missingrepos)} to clone" if missingrepos else "ok",
                 f"{pinnedrepos} commit-pinned; " + ", ".join(missingrepos[:6])))

    bins = [b["name"] for b in m.get("binaries", [])
            if not expand(b["path"], home).exists()]
    noinstall = [b["name"] for b in m.get("binaries", [])
                 if not b.get("install", "").strip()]
    rows.append(("binaries", f"{len(bins)} missing" if bins else "ok",
                 f"no installer configured: {', '.join(noinstall[:4])}"))

    print(f"\nPLAN  target={m['target']['user']}@{m['target']['hostname']}  "
          f"manifest schema={m['meta']['schema']}\n")
    print(f"  {'AREA':<16} {'STATUS':<22} DETAIL")
    print("  " + "-" * 76)
    for area, status, detail in rows:
        print(f"  {area:<16} {status:<22} {detail[:52]}")
    print()
    if all(s == "ok" for _, s, _ in rows):
        log("already converged - nothing to do")
    else:
        log("dry plan only; run `sudo vpsclone apply --dry-run` for the real preflight")


