#!/usr/bin/env python3
"""
vpsclone - capture and replay a curated Ubuntu VPS baseline.

Stdlib only. Idempotent. Dry-runnable. Secret-aware.

  capture    read the current machine, write manifest + dotfiles (never mutates source)
  audit      local read/author pass: write mirror.toml + generated manifest.toml
  drive      target pass: resolve prompts, materialise manifest, apply or --tui
  plan       show what apply would change
  apply      replay the manifest on a fresh Ubuntu box
  verify     post-apply health check
  keygen     generate passphrase-protected ssh key locally, scp it, print pubkey
  bundle     make a small self-contained tar.gz for zero-dependency first boot
  sync-data  rsync only the explicit data allowlist
  rollback   restore the files touched by the last apply
  doctor     preflight checks for a fresh target
"""
