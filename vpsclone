# ------------------------------------------------------------------ helpers
def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path) -> str:
    return sha256_bytes(Path(path).read_bytes())


def log(msg: str, level: str = "INFO") -> None:
    print(f"[{level}] {msg}", flush=True)


def die(msg: str, code: int = 1) -> None:
    print(f"[ERROR] {msg}", file=sys.stderr)
    raise SystemExit(code)


def cmd(args, *, check=False, as_user=None, env=None, cwd=None,
        quiet=False, capture=True, input_text=None, timeout=None):
    args = [str(a) for a in args]
    if as_user and os.geteuid() == 0 and as_user != "root":
        args = ["runuser", "-u", as_user, "--", *args]
    if not quiet:
        log("$ " + " ".join(redact_url(a) for a in args))
    e = os.environ.copy()
    e.update(env or {})
    try:
        p = subprocess.run(
            args, env=e, cwd=cwd, input=input_text, text=True, timeout=timeout,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.STDOUT if capture else None,
        )
    except FileNotFoundError:
        if check:
            die(f"required command not found: {args[0]}")
        return 127, ""
    out = p.stdout or ""
    if check and p.returncode:
        die(f"command failed ({p.returncode}): "
            f"{' '.join(redact_url(a) for a in args)}\n{out.strip()}")
    return p.returncode, out


def redact_url(value: str) -> str:
    """Strip any userinfo (user:token@) from URLs before logging or storing."""
    return re.sub(r"(://)[^/@\s]+@", r"\1<redacted>@", str(value))


def read_text(path, default="") -> str:
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return default


def user_exists(name: str) -> bool:
    try:
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


def in_group(user: str, group: str) -> bool:
    try:
        g = grp.getgrnam(group)
        if user in g.gr_mem:
            return True
        return pwd.getpwnam(user).pw_gid == g.gr_gid
    except KeyError:
        return False


def expand(path: str, home: str) -> Path:
    if path == "~":
        return Path(home)
    if path.startswith("~/"):
        return Path(home) / path[2:]
    return Path(path)


def load_denylist() -> list[str]:
    pats = list(BUILTIN_DENY)
    if DENYLIST.exists():
        pats += [
            line.strip() for line in DENYLIST.read_text(errors="replace").splitlines()
            if line.strip() and not line.strip().startswith("#")
        ]
    # Negations must come last so they can re-allow safe artifacts.
    return pats + DENY_ALLOWS


def _matches(s: str, base: str, pat: str) -> bool:
    return fnmatch.fnmatch(s, pat) or fnmatch.fnmatch(base, pat)


def is_denied(rel: str, pats: list[str]) -> bool:
    s = str(rel)
    base = Path(s).name
    denied = False
    for pat in pats:
        if pat.startswith("!"):
            if _matches(s, base, pat[1:]):
                denied = False
        elif _matches(s, base, pat):
            denied = True
    return denied


def is_root() -> bool:
    return os.geteuid() == 0


def need_root() -> None:
    if not is_root():
        die("apply/rollback/verify need root: run with sudo")


def lstat(p: Path) -> os.stat_result | None:
    try:
        return p.lstat()
    except FileNotFoundError:
        return None


def assert_no_symlink_components(path: Path, root: Path | None = None) -> None:
    """Refuse symlinks anywhere between root and path (root defaults to /)."""
    p = Path(path).absolute()
    base = Path(root).absolute() if root is not None else Path(p.anchor)
    try:
        rel = p.relative_to(base)
    except ValueError:
        die(f"path {p} is outside trusted root {base}")
    cur = base
    st = lstat(cur)
    if st and stat.S_ISLNK(st.st_mode):
        die(f"refusing symlink in path: {cur}")
    for part in rel.parts:
        cur = cur / part
        st = lstat(cur)
        if st and stat.S_ISLNK(st.st_mode):
            die(f"refusing symlink in path: {cur}")


def assert_regular_file(path: Path, *, root: Path | None = None,
                        must_exist: bool = True) -> None:
    assert_no_symlink_components(path, root=root)
    st = lstat(path)
    if st is None:
        if must_exist:
            die(f"expected regular file is missing: {path}")
        return
    if not stat.S_ISREG(st.st_mode):
        die(f"refusing non-regular file: {path}")


def write_bytes_no_symlink(path: Path, data: bytes, *, mode: int | None = None,
                           owner: str | None = None,
                           root: Path | None = None) -> None:
    """Write bytes with O_NOFOLLOW so a last-component symlink cannot be followed."""
    assert_regular_file(path, root=root, must_exist=False)
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, mode if mode is not None else 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
            if mode is not None:
                os.fchmod(f.fileno(), mode)
            if owner:
                os.fchown(f.fileno(), pwd.getpwnam(owner).pw_uid, -1)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def atomic_write_text(path: Path, text: str, *, mode: int = 0o644,
                      owner: str | None = None) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    try:
        tmp.unlink(missing_ok=True)
        write_bytes_no_symlink(tmp, text.encode(), mode=mode, owner=owner)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass


# -------------------------------------------------------------- TOML I/O
def load_manifest() -> dict:
    if not MANIFEST.exists():
        die("no manifest.toml found - run `vpsclone capture` first")
    with MANIFEST.open("rb") as f:
        return tomllib.load(f)


def _tk(k) -> str:
    s = str(k)
    return s if re.fullmatch(r"[A-Za-z0-9_-]+", s) else json.dumps(s, ensure_ascii=False)


def _tv(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return repr(v)
    if isinstance(v, str):
        # JSON's basic-string escaping is TOML-compatible; keep Unicode literal
        # so tomllib never sees surrogate-pair escapes (invalid in TOML).
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (list, tuple)):
        if not v:
            return "[]"
        if all(not isinstance(x, (dict, list)) for x in v):
            return "[\n" + "".join(f"  {_tv(x)},\n" for x in v) + "]"
        return "[" + ", ".join(_tv(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{_tk(k)} = {_tv(x)}" for k, x in v.items()) + " }"
    raise TypeError(f"cannot serialize {type(v).__name__}")


def toml_dump(data: dict) -> str:
    out: list[str] = []

    def emit(d: dict, prefix: str = "") -> None:
        scalars, tables, arrays = [], [], []
        for k, v in d.items():
            if isinstance(v, dict):
                tables.append((k, v))
            elif isinstance(v, list) and v and all(isinstance(x, dict) for x in v):
                arrays.append((k, v))
            else:
                scalars.append((k, v))
        for k, v in scalars:
            out.append(f"{_tk(k)} = {_tv(v)}")
        if scalars:
            out.append("")
        for k, v in tables:
            name = f"{prefix}.{_tk(k)}" if prefix else _tk(k)
            out.append(f"[{name}]")
            emit(v, name)
            out.append("")
        for k, v in arrays:
            name = f"{prefix}.{_tk(k)}" if prefix else _tk(k)
            for item in v:
                out.append(f"[[{name}]]")
                emit(item, name)
                out.append("")

    emit(data)
    return "\n".join(out).rstrip() + "\n"


