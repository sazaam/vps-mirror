# ------------------------------------------------------------------ helpers
def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path) -> str:
    return sha256_bytes(Path(path).read_bytes())


def log(msg: str, level: str = "INFO") -> None:
    print(f"[{level}] {msg}", flush=True)


def die(msg: str, code: int = 1) -> None:
    print(f"[ERROR] {msg}", file=sys.stderr)
    raise SystemExit(code)


def cmd(args, *, check=False, as_user=None, env=None, cwd=None,
        quiet=False, capture=True, input_text=None, timeout=None):
    args = [str(a) for a in args]
    if as_user and os.geteuid() == 0 and as_user != "root":
        args = ["runuser", "-u", as_user, "--", *args]
    if not quiet:
        log("$ " + " ".join(redact_url(a) for a in args))
    e = os.environ.copy()
    e.update(env or {})
    try:
        p = subprocess.run(
            args, env=e, cwd=cwd, input=input_text, text=True, timeout=timeout,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.STDOUT if capture else None,
        )
    except FileNotFoundError:
        if check:
            die(f"required command not found: {args[0]}")
        return 127, ""
    out = p.stdout or ""
    if check and p.returncode:
        die(f"command failed ({p.returncode}): "
            f"{' '.join(redact_url(a) for a in args)}\n{out.strip()}")
    return p.returncode, out


def redact_url(value: str) -> str:
    """Strip any userinfo (user:token@) from URLs before logging or storing."""
    return re.sub(r"(://)[^/@\s]+@", r"\1<redacted>@", str(value))


def read_text(path, default="") -> str:
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return default


def user_exists(name: str) -> bool:
    try:
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


def in_group(user: str, group: str) -> bool:
    try:
        g = grp.getgrnam(group)
        if user in g.gr_mem:
            return True
        return pwd.getpwnam(user).pw_gid == g.gr_gid
    except KeyError:
        return False


def expand(path: str, home: str) -> Path:
    if path == "~":
        return Path(home)
    if path.startswith("~/"):
        return Path(home) / path[2:]
    return Path(path)


def load_denylist() -> list[str]:
    pats = list(BUILTIN_DENY)
    if DENYLIST.exists():
        pats += [
            line.strip() for line in DENYLIST.read_text(errors="replace").splitlines()
            if line.strip() and not line.strip().startswith("#")
        ]
    # Negations must come last so they can re-allow safe artifacts.
    return pats + DENY_ALLOWS


def _matches(s: str, base: str, pat: str) -> bool:
    return fnmatch.fnmatch(s, pat) or fnmatch.fnmatch(base, pat)


def is_denied(rel: str, pats: list[str]) -> bool:
    s = str(rel)
    base = Path(s).name
    denied = False
    for pat in pats:
        if pat.startswith("!"):
            if _matches(s, base, pat[1:]):
                denied = False
        elif _matches(s, base, pat):
            denied = True
    return denied


def is_root() -> bool:
    return os.geteuid() == 0


def need_root() -> None:
    if not is_root():
        die("apply/rollback/verify need root: run with sudo")


def lstat(p: Path) -> os.stat_result | None:
    try:
        return p.lstat()
    except FileNotFoundError:
        return None


def assert_no_symlink_components(path: Path, root: Path | None = None) -> None:
    """Refuse symlinks anywhere between root and path (root defaults to /)."""
    p = Path(path).absolute()
    base = Path(root).absolute() if root is not None else Path(p.anchor)
    try:
        rel = p.relative_to(base)
    except ValueError:
        die(f"path {p} is outside trusted root {base}")
    cur = base
    st = lstat(cur)
    if st and stat.S_ISLNK(st.st_mode):
        die(f"refusing symlink in path: {cur}")
    for part in rel.parts:
        cur = cur / part
        st = lstat(cur)
        if st and stat.S_ISLNK(st.st_mode):
            die(f"refusing symlink in path: {cur}")


def assert_regular_file(path: Path, *, root: Path | None = None,
                        must_exist: bool = True) -> None:
    assert_no_symlink_components(path, root=root)
    st = lstat(path)
    if st is None:
        if must_exist:
            die(f"expected regular file is missing: {path}")
        return
    if not stat.S_ISREG(st.st_mode):
        die(f"refusing non-regular file: {path}")


def write_bytes_no_symlink(path: Path, data: bytes, *, mode: int | None = None,
                           owner: str | None = None,
                           root: Path | None = None) -> None:
    """Write bytes with O_NOFOLLOW so a last-component symlink cannot be followed."""
    assert_regular_file(path, root=root, must_exist=False)
    path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, mode if mode is not None else 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
            if mode is not None:
                os.fchmod(f.fileno(), mode)
            if owner:
                os.fchown(f.fileno(), pwd.getpwnam(owner).pw_uid, -1)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        raise


def atomic_write_text(path: Path, text: str, *, mode: int = 0o644) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    try:
        tmp.unlink(missing_ok=True)
        write_bytes_no_symlink(tmp, text.encode(), mode=mode)
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass


# -------------------------------------------------------------- TOML I/O
def load_manifest() -> dict:
    if not MANIFEST.exists():
        die("no manifest.toml found - run `vpsclone capture` first")
    with MANIFEST.open("rb") as f:
        return tomllib.load(f)


def _tk(k) -> str:
    s = str(k)
    return s if re.fullmatch(r"[A-Za-z0-9_-]+", s) else json.dumps(s, ensure_ascii=False)


def _tv(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return repr(v)
    if isinstance(v, str):
        # JSON's basic-string escaping is TOML-compatible; keep Unicode literal
        # so tomllib never sees surrogate-pair escapes (invalid in TOML).
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, (list, tuple)):
        if not v:
            return "[]"
        if all(not isinstance(x, (dict, list)) for x in v):
            return "[\n" + "".join(f"  {_tv(x)},\n" for x in v) + "]"
        return "[" + ", ".join(_tv(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{_tk(k)} = {_tv(x)}" for k, x in v.items()) + " }"
    raise TypeError(f"cannot serialize {type(v).__name__}")


def toml_dump(data: dict) -> str:
    out: list[str] = []

    def emit(d: dict, prefix: str = "") -> None:
        scalars, tables, arrays = [], [], []
        for k, v in d.items():
            if isinstance(v, dict):
                tables.append((k, v))
            elif isinstance(v, list) and v and all(isinstance(x, dict) for x in v):
                arrays.append((k, v))
            else:
                scalars.append((k, v))
        for k, v in scalars:
            out.append(f"{_tk(k)} = {_tv(v)}")
        if scalars:
            out.append("")
        for k, v in tables:
            name = f"{prefix}.{_tk(k)}" if prefix else _tk(k)
            out.append(f"[{name}]")
            emit(v, name)
            out.append("")
        for k, v in arrays:
            name = f"{prefix}.{_tk(k)}" if prefix else _tk(k)
            for item in v:
                out.append(f"[[{name}]]")
                emit(item, name)
                out.append("")

    emit(data)
    return "\n".join(out).rstrip() + "\n"


# ----------------------------------------------------------- detection
def os_pretty() -> str:
    for line in read_text("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            return line.split("=", 1)[1].strip().strip('"')
    return platform.platform()


def detect_timezone() -> str:
    rc, out = cmd(["timedatectl", "show", "-p", "Timezone", "--value"], quiet=True)
    if rc == 0 and out.strip():
        return out.strip()
    return read_text("/etc/timezone").strip() or "UTC"


def detect_ssh_port() -> str:
    port = None
    files = [Path("/etc/ssh/sshd_config")]
    d = Path("/etc/ssh/sshd_config.d")
    if d.exists():
        files += sorted(d.glob("*.conf"))
    for f in files:
        for line in read_text(f).splitlines():
            m = re.match(r"^\s*Port\s+(\d+)", line)
            if m:
                port = m.group(1)
    return port or "22"


def detect_ufw_allow(port: str) -> list[str]:
    attempts = [["ufw", "status", "verbose"]] if is_root() else [
        ["sudo", "-n", "ufw", "status", "verbose"],
    ]
    for argv in attempts:
        rc, out = cmd(argv, quiet=True)
        if rc != 0:
            continue
        rules = []
        for line in out.splitlines():
            if not re.search(r"\bALLOW\b", line):
                continue
            # ufw prints "[ 1] 2022/tcp ALLOW IN ..."; the bracketed number is
            # a rule id, not a port. Strip it and read the first To-column token.
            s = re.sub(r"^\s*\[\s*\d+\]\s*", "", line)
            parts = s.split()
            if not parts:
                continue
            to = parts[0]
            if re.fullmatch(r"[A-Za-z0-9_.-]+(?:/(?:tcp|udp))?", to):
                rules.append(to)
        sshrule = f"{port}/tcp"
        if sshrule not in rules:
            rules.insert(0, sshrule)
        return sorted(set(rules))
    log("ufw status unreadable; seeding ssh port only - rerun capture with sudo", "WARN")
    return [f"{port}/tcp"]


def enabled_services() -> list[str]:
    rc, out = cmd(["systemctl", "list-unit-files", "--state=enabled",
                   "--no-pager", "--plain"], quiet=True)
    found = set()
    if rc == 0:
        for line in out.splitlines():
            parts = line.split()
            if not parts:
                continue
            name = parts[0]
            if name in SAFE_SERVICES or name.replace(".service", "") in SAFE_SERVICES:
                found.add(name)
    return sorted(found) or ["ssh", "fail2ban", "cron"]


def mise_tools(home: str) -> list[str]:
    p = Path(home) / ".config/mise/config.toml"
    if not p.exists():
        return []
    try:
        with p.open("rb") as f:
            d = tomllib.load(f)
    except Exception:
        return []
    out = []
    for k, v in d.get("tools", {}).items():
        if isinstance(v, str):
            out.append(f"{k}@{v}")
        elif isinstance(v, dict):
            out.append(f"{k}@{v.get('version', 'latest')}")
        elif isinstance(v, list):
            out += [f"{k}@{x}" for x in v]
    return out


# ------------------------------------------------------------ package inventory
# Feature-inspired by ESR's `inventory` project: one structured record per
# installer/package. Independently implemented here; stdlib only, no code
# copied. Deliberately limited to installers vpsclone can actually replay.
INVENTORY_METHOD = "vpsclone-inventory/1"
CARGO_TOOLCHAIN_BINARIES = {
    "cargo", "rustc", "rustup", "rustfmt", "cargo-fmt", "clippy-driver",
    "cargo-clippy", "cargo-install-update", "cargo-install-update-setup",
}
_CARGO_LIST_RE = re.compile(r"^([A-Za-z0-9_][A-Za-z0-9_.-]*)\s+(\S+):\s*$")
_PIPX_VERSION_RE = re.compile(r"^[0-9A-Za-z_.!+*-]+$")


def _read_maybe_gzip(path: Path) -> str:
    try:
        if path.suffix == ".gz":
            with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                return f.read()
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def _parse_dpkg_status(text: str) -> set[str]:
    found: set[str] = set()
    pkg, installed = "", False
    for raw in text.splitlines() + [""]:
        line = raw.strip()
        if not line:
            if pkg and installed:
                found.add(pkg)
            pkg, installed = "", False
            continue
        if line.startswith("Package:"):
            pkg = line.split(":", 1)[1].strip()
        elif line.startswith("Status:"):
            installed = "install ok installed" in line
    return found


def _installer_base_packages(log_dir: Path) -> set[str] | None:
    paths = sorted(p for p in {*log_dir.glob("initial-status*"),
                               *log_dir.glob("status*")} if p.is_file())
    found: set[str] = set()
    for p in paths:
        found |= _parse_dpkg_status(_read_maybe_gzip(p))
    return found or None


def _dedupe_records(records: list[dict]) -> list[dict]:
    seen: set[tuple[str, str]] = set()
    out = []
    for r in records:
        key = (r["installer"], r["name"])
        if key in seen:
            continue
        seen.add(key)
        out.append(r)
    return out


def inv_apt(runner=cmd, log_dir: Path = Path("/var/log/installer")):
    rc, out = runner(["apt-mark", "showmanual"], quiet=True)
    raw = sorted(x.strip() for x in out.splitlines() if x.strip()) if rc == 0 else []
    manual = raw
    warnings: list[str] = []
    notes: list[str] = []
    if not raw:
        warnings.append("apt-mark showmanual returned no packages")
    base = _installer_base_packages(log_dir)
    if base is None:
        warnings.append("installer base logs unavailable; apt list kept unfiltered")
    else:
        kept = [p for p in raw if p not in base]
        notes.append(f"apt base filter: {len(raw)} manual -> {len(kept)} "
                     f"(removed {len(raw) - len(kept)} base packages)")
        manual = kept
    return ([{"installer": "apt", "name": p} for p in manual],
            warnings, notes, {"apt_manual_raw": len(raw)})


def inv_npm(home: str, runner=cmd):
    records: list[dict] = []
    warnings: list[str] = []
    notes: list[str] = []
    env = {"HOME": home}
    parsed = False

    rc, out = runner(["npm", "ls", "-g", "--json", "--depth=0"],
                     quiet=True, env=env)
    if rc == 0 and out.strip():
        try:
            deps = (json.loads(out) or {}).get("dependencies") or {}
            for name, info in deps.items():
                if not isinstance(name, str) or not name:
                    continue
                if isinstance(info, dict) and info.get("missing"):
                    continue
                version = info.get("version", "") if isinstance(info, dict) else ""
                records.append({"installer": "npm", "name": name,
                                "version": str(version) if version else ""})
            parsed = True
            notes.append("npm names from `npm ls -g --json`")
        except ValueError:
            pass

    if not parsed:
        rc, out = runner(["npm", "ls", "-g", "--depth=0", "--parseable"],
                         quiet=True, env=env)
        if rc == 0:
            for line in out.splitlines():
                parts = [p for p in line.strip().split("/") if p]
                if not parts:
                    continue
                tail = parts[-1]
                name = f"{parts[-2]}/{tail}" if len(parts) >= 2 and parts[-2].startswith("@") else tail
                if name in ("node_modules", ""):
                    continue
                records.append({"installer": "npm", "name": name})
            parsed = True
            notes.append("npm names from parseable fallback")

    if not parsed:
        warnings.append("npm not available on source; no global packages recorded")
    return _dedupe_records(records), warnings, notes, {}


def inv_pipx(home: str, runner=cmd):
    rc, out = runner(["pipx", "list", "--short"], quiet=True, env={"HOME": home})
    records: list[dict] = []
    warnings: list[str] = []
    if rc != 0:
        warnings.append("pipx not available on source; no tools recorded")
    else:
        for line in out.splitlines():
            s = line.strip()
            if not s or s.startswith("-"):
                continue
            parts = s.rsplit(" ", 1)
            name, version = s, ""
            if len(parts) == 2 and _PIPX_VERSION_RE.fullmatch(parts[1]):
                name, version = parts
            records.append({"installer": "pipx", "name": name, "version": version})
    return _dedupe_records(records), warnings, [], {}


def inv_cargo(home: str, runner=cmd):
    rc, out = runner(["cargo", "install", "--list"],
                     quiet=True, env={"HOME": home})
    records: list[dict] = []
    warnings: list[str] = []
    notes: list[str] = []
    if rc == 0:
        for line in out.splitlines():
            m = _CARGO_LIST_RE.match(line.strip())
            if m:
                records.append({"installer": "cargo", "name": m.group(1),
                                "version": re.sub(r"^v", "", m.group(2)),
                                "replayable": True})
        notes.append("cargo names from `cargo install --list`")
    else:
        bindir = Path(home) / ".cargo/bin"
        if bindir.is_dir():
            for p in sorted(bindir.iterdir()):
                if (p.name in CARGO_TOOLCHAIN_BINARIES or p.is_symlink()
                        or not p.is_file() or not os.access(p, os.X_OK)):
                    continue
                records.append({"installer": "cargo", "name": p.name,
                                "replayable": False})
            warnings.append("cargo absent; names inferred from ~/.cargo/bin "
                            "(binary names, install commands need review)")
        else:
            warnings.append("cargo not available on source; no cargo packages recorded")
    return _dedupe_records(records), warnings, notes, {}


def inv_mise(home: str):
    return ([{"installer": "mise", "name": t} for t in mise_tools(home)],
            [], [], {})


def inventory_packages(home: str, runner=cmd,
                       log_dir: Path = Path("/var/log/installer")) -> tuple[dict, dict]:
    """Return the manifest `packages` dict plus non-secret audit provenance."""
    collected = [
        inv_apt(runner=runner, log_dir=log_dir),
        inv_npm(home, runner=runner),
        inv_pipx(home, runner=runner),
        inv_cargo(home, runner=runner),
        inv_mise(home),
    ]
    records: list[dict] = []
    warnings: list[str] = []
    notes: list[str] = []
    counts: dict[str, int] = {}
    for recs, warns, notes_, stats in collected:
        records += recs
        warnings += warns
        notes += notes_
        counts.update(stats)

    records = _dedupe_records(records)
    for r in records:
        counts[r["installer"]] = counts.get(r["installer"], 0) + 1

    packages = {
        "apt": [r["name"] for r in records if r["installer"] == "apt"],
        "npm": [r["name"] for r in records if r["installer"] == "npm"],
        "pipx": [r["name"] for r in records if r["installer"] == "pipx"],
        "cargo": [r["name"] for r in records
                  if r["installer"] == "cargo" and r.get("replayable", True)],
        "mise": {"tools": [r["name"] for r in records
                           if r["installer"] == "mise"]},
        # Full records keep versions for convergence checks and pinned replay.
        "records": [dict(r) for r in records],
    }

    canonical = "\n".join(json.dumps(r, sort_keys=True, separators=(",", ":"))
                          for r in records)
    meta = {
        "method": INVENTORY_METHOD,
        "counts": counts,
        "notes": [f"method: {INVENTORY_METHOD}"] + notes,
        "warnings": warnings,
        "records_sha256": sha256_bytes(canonical.encode()),
    }
    return packages, meta


# ------------------------------------------------------- convergence checks
def _pkg_installed(pkg: str, runner=cmd) -> bool:
    rc, out = runner(["dpkg-query", "-W", "-f=${Status}", pkg], quiet=True)
    return rc == 0 and "install ok installed" in out


def expected_versions(m: dict, installer: str) -> dict[str, str]:
    """Name -> version from full records, with a legacy name-only fallback."""
    out: dict[str, str] = {}
    for r in m.get("packages", {}).get("records", []) or []:
        if r.get("installer") != installer:
            continue
        if installer == "cargo" and r.get("replayable", True) is False:
            continue
        name = str(r.get("name", ""))
        if name:
            out[name] = str(r.get("version", ""))
    if out:
        return out
    for name in m.get("packages", {}).get(installer, []) or []:
        n = str(name)
        if n:
            out[n] = ""
    return out


def npm_global_versions(home: str, runner=cmd) -> dict[str, str]:
    rc, out = runner(["npm", "ls", "-g", "--json", "--depth=0"],
                     quiet=True, env={"HOME": home})
    if rc:
        return {}
    try:
        deps = (json.loads(out) or {}).get("dependencies") or {}
    except ValueError:
        return {}
    return {
        str(name): str(info.get("version", "")) if isinstance(info, dict) else ""
        for name, info in deps.items() if str(name)
    }


def pipx_global_versions(home: str, runner=cmd) -> dict[str, str]:
    rc, out = runner(["pipx", "list", "--short"], quiet=True,
                     env={"HOME": home})
    if rc:
        return {}
    out_map = {}
    for line in out.splitlines():
        s = line.strip()
        if not s or s.startswith("-"):
            continue
        parts = s.rsplit(" ", 1)
        if len(parts) == 2 and _PIPX_VERSION_RE.fullmatch(parts[1]):
            out_map[parts[0]] = parts[1]
        else:
            out_map[s] = ""
    return out_map


def cargo_global_versions(home: str, runner=cmd) -> dict[str, str]:
    rc, out = runner(["cargo", "install", "--list"], quiet=True,
                     env={"HOME": home})
    if rc:
        return {}
    out_map = {}
    for line in out.splitlines():
        m2 = _CARGO_LIST_RE.match(line.strip())
        if m2:
            out_map[m2.group(1)] = re.sub(r"^v", "", m2.group(2))
    return out_map


def git_repo_state(path: Path, runner=cmd) -> dict:
    def out_of(*args: str) -> str:
        rc, out = runner(["git", "-C", str(path), *args], quiet=True)
        return out.strip() if rc == 0 else ""

    dirty = out_of("status", "--porcelain")
    return {
        "exists": path.exists(),
        "url": redact_url(out_of("remote", "get-url", "origin")),
        "branch": out_of("branch", "--show-current"),
        "commit": out_of("rev-parse", "HEAD"),
        "dirty": bool(dirty),
    }


def service_state(name: str, runner=cmd) -> dict:
    rc_a, active = runner(["systemctl", "is-active", name], quiet=True)
    rc_e, _ = runner(["systemctl", "is-enabled", name], quiet=True)
    return {"active": rc_a == 0 and active.strip() == "active",
            "enabled": rc_e == 0}


def check_convergence(m: dict, dry: bool = False, runner=cmd
                      ) -> list[tuple[str, bool, str, bool]]:
    """Compare target state with the effective manifest.

    Returns (name, ok, detail, warn). Manual gates are WARN, never PASS.
    """
    out: list[tuple[str, bool, str, bool]] = []

    def ck(name: str, ok: bool, detail="", warn=False) -> None:
        out.append((name, bool(ok), str(detail), bool(warn)))

    home = m["target"]["home"]
    diff = "would differ" if dry else "differs"

    missing_apt = [p for p in m.get("packages", {}).get("apt", [])
                   if not _pkg_installed(p, runner)]
    ck("apt:packages", not missing_apt,
       f"missing: {', '.join(missing_apt)}" if missing_apt else "all present")

    for installer, label, reader in (
        ("npm", "npm:versions", npm_global_versions),
        ("pipx", "pipx:versions", pipx_global_versions),
        ("cargo", "cargo:versions", cargo_global_versions),
    ):
        want = expected_versions(m, installer)
        if not want:
            continue
        got = reader(home, runner=runner)
        missing = [n for n in want if n not in got]
        mismatch = [f"{n}: want {v}, got {got[n]}" for n, v in want.items()
                    if n in got and v and got[n] and got[n] != v]
        unpinned = [n for n, v in want.items()
                    if n in got and not v]
        if missing or mismatch:
            ck(label, False,
               f"{diff}; missing={','.join(missing) or '-'}; "
               f"mismatch={'; '.join(mismatch) or '-'}")
        elif unpinned:
            ck(label, False, f"unpinned: {', '.join(unpinned)}", warn=True)
        else:
            ck(label, True, f"{len(want)} version(s) match")

    want_mise = m.get("packages", {}).get("mise", {}).get("tools", []) or []
    if want_mise:
        got_mise = mise_tools(home)
        ck("mise:tools", sorted(want_mise) == sorted(got_mise),
           f"want={','.join(want_mise)} got={','.join(got_mise)}")

    for u in effective_users(m):
        ck(f"user:{u['name']}", user_exists(u["name"]), u["name"])
        inline = str(u.get("authorized_keys_inline", "") or "").strip()
        ak = u.get("authorized_keys", "")
        dst = Path(u["home"]) / ".ssh/authorized_keys"
        if inline:
            want = (inline.rstrip("\n") + "\n").encode()
            ck(f"key:{u['name']}", dst.is_file() and dst.read_bytes() == want)
        elif ak:
            src = REPO / ak
            ck(f"key:{u['name']}",
               src.is_file() and dst.is_file() and src.read_bytes() == dst.read_bytes())

    for s in m.get("services", {}).get("enable", []):
        st = service_state(s, runner=runner)
        ck(f"service:{s}", st["active"] and st["enabled"],
           f"active={st['active']} enabled={st['enabled']}")

    for target, src in m.get("system_files", {}).items():
        s, d = REPO / src, Path(target)
        ck(f"system:{target}",
           s.is_file() and d.is_file() and s.read_bytes() == d.read_bytes())

    allow_links = str(m.get("policy", {}).get("allow_symlinks", False)).lower() \
        in {"1", "true", "yes", "y"}
    links = (m.get("baseline", {}).get("dotfile_symlinks", {}) or {})
    for target, src in m.get("dotfiles", {}).items():
        s, d = REPO / src, expand(target, home)
        link = links.get(target) if allow_links else None
        if link:
            want = safe_link_target(link, home)
            ck(f"dotfile:{target}", d.is_symlink() and os.readlink(d) == want,
               f"want link {want}")
        else:
            ck(f"dotfile:{target}",
               s.is_file() and d.is_file() and s.read_bytes() == d.read_bytes())

    for r in m.get("repos", []):
        p = expand(r["path"], home)
        st = git_repo_state(p, runner=runner)
        if not st["commit"]:
            ck(f"repo:{r['path']}", False, f"not a git checkout ({diff})")
        elif r.get("url") and st["url"] and st["url"] != r["url"]:
            ck(f"repo:{r['path']}", False,
               f"url want={r['url']} got={st['url']}")
        elif r.get("branch") and st["branch"] and st["branch"] != r["branch"]:
            ck(f"repo:{r['path']}", False,
               f"branch want={r['branch']} got={st['branch']}")
        elif r.get("commit") and st["commit"] != r["commit"]:
            ck(f"repo:{r['path']}", False,
               f"commit want={r['commit']} got={st['commit']}")
        elif st["dirty"]:
            ck(f"repo:{r['path']}", False, "working tree has local changes", warn=True)
        else:
            ck(f"repo:{r['path']}", True, st["commit"][:8])

    for b in m.get("binaries", []):
        name = b.get("name", "?")
        p = expand(b.get("path", ""), home)
        want = str(b.get("sha256", ""))
        if not want:
            ck(f"binary:{name}", False, "no source hash - cannot verify", warn=True)
        elif not p.is_file():
            ck(f"binary:{name}", False, f"missing {p}")
        else:
            try:
                got = sha256_file(p)
            except OSError as exc:
                ck(f"binary:{name}", False, str(exc))
            else:
                ck(f"binary:{name}", got == want,
                   "hash matches" if got == want else f"want {want[:12]} got {got[:12]}")

    rc, ss = runner(["ss", "-tulpn"], quiet=True)
    port = str(m["ssh"]["port"])
    ck("ssh:port", rc == 0 and (f":{port} " in ss or f":{port}\n" in ss),
       f"port {port}")
    ck("ssh:sshd_t", runner(["sshd", "-t"], quiet=True)[0] == 0)
    dropin = FINAL_DROPIN if FINAL_DROPIN.is_file() else CUTOVER_DROPIN
    body = dropin.read_text() if dropin.is_file() else ""
    ck("ssh:key_only", "PasswordAuthentication no" in body
       and "PubkeyAuthentication yes" in body)
    expected = [u["name"] for u in effective_users(m) if u["ssh_allow"]]
    allow_m = re.search(r"(?m)^AllowUsers\s+(.+)$", body)
    allow = set(allow_m.group(1).split()) if allow_m else set()
    missing = [u for u in expected if u not in allow]
    ck("ssh:allow_users", not missing,
       "missing: " + ",".join(missing) if missing else "all allowed")

    ck("manual:login", False, "test a fresh SSH session from your local shell", warn=True)
    ck("manual:github", False, "confirm the deploy key is accepted by GitHub", warn=True)
    ck("manual:vault", False, "vault restore is out-of-band - verify yourself", warn=True)
    ck("manual:data", False, "data sync is out-of-band - verify yourself", warn=True)

    return out


def find_git_repos(home: str, max_depth: int = 4) -> list[Path]:
    """Shallow scan for git checkouts, pruning caches and vendored plugin dirs."""
    skip = {".cache", ".cargo", ".bun", ".npm", ".rustup", "node_modules",
            "plugins", ".git"}
    root = Path(home)
    found: list[Path] = []

    def walk(p: Path, depth: int) -> None:
        if depth > max_depth or not p.is_dir():
            return
        if (p / ".git").exists():
            found.append(p)  # keep descending: p10k lives inside oh-my-zsh
        try:
            entries = list(p.iterdir())
        except OSError:
            return
        for e in entries:
            if e.name in skip or e.is_symlink() or not e.is_dir():
                continue
            walk(e, depth + 1)

    walk(root, 0)
    return found


def detect_repos(home: str) -> list[dict]:
    repos = []
    root = Path(home)
    for p in find_git_repos(home):
        rc, out = cmd(["git", "-C", str(p), "remote", "get-url", "origin"], quiet=True)
        if rc or not out.strip():
            continue
        rc2, br = cmd(["git", "-C", str(p), "branch", "--show-current"], quiet=True)
        rc3, sha = cmd(["git", "-C", str(p), "rev-parse", "HEAD"], quiet=True)
        repos.append({
            "path": "~/" + str(p.relative_to(root)),
            "url": redact_url(out.strip()),
            "branch": br.strip() if rc2 == 0 and br.strip() else "main",
            "commit": sha.strip() if rc3 == 0 else "",
        })
    return sorted(repos, key=lambda r: r["path"])


def detect_binaries(home: str) -> list[dict]:
    """Executables installed outside apt - record them; fill in `install` by hand."""
    res = []
    root = Path(home)
    for d in (root / ".local/bin", root / ".opencode/bin"):
        if not d.exists():
            continue
        for p in sorted(d.iterdir()):
            if p.is_symlink() or not p.is_file() or not os.access(p, os.X_OK):
                continue
            res.append({
                "name": p.name,
                "path": "~/" + str(p.relative_to(root)),
                "size_mb": round(p.stat().st_size / 1024 / 1024, 1),
                "sha256": sha256_file(p),
                "install": "",  # e.g. "curl -fsSL https://opencode.ai/install | bash"
            })
    return res


def sshd_dropin(port: str) -> str:
    """Base hardening template. AllowUsers is rendered from the manifest."""
    return "\n".join([
        "# Generated by vpsclone - see dotS skills/server-setup.s @sshHarden",
        "# WARNING: open the firewall port BEFORE reloading sshd.",
        f"Port {port}",
        "PubkeyAuthentication yes",
        "PasswordAuthentication no",
        "KbdInteractiveAuthentication no",
        "PermitRootLogin no",
        "MaxAuthTries 3",
        "ClientAliveInterval 300",
        "ClientAliveCountMax 2",
        "LogLevel VERBOSE",
        "",
    ])


def render_dropin(m: dict, source: str) -> str:
    """Force captured drop-ins to match the effective manifest port/users."""
    port = str(m["ssh"]["port"])
    configured = [str(u) for u in m.get("ssh", {}).get("allow_users", [])]
    derived = [u["name"] for u in effective_users(m) if u["ssh_allow"]]
    users = []
    for name in configured + derived:
        if name not in users:
            users.append(name)
    allow = " ".join(users) or "nobody"

    body, n = re.subn(r"(?m)^[ \t]*Port[ \t]+\S+[ \t]*$", f"Port {port}", source, count=1)
    if n == 0:
        body = f"Port {port}\n{body}"
    body, n = re.subn(r"(?m)^[ \t]*AllowUsers[ \t]+.*$", f"AllowUsers {allow}", body, count=1)
    if n == 0:
        body = body.rstrip() + f"\nAllowUsers {allow}\n"
    return body.rstrip() + "\n"


# -------------------------------------------------------------- capture
def symlink_link_target(src: Path, home: str) -> tuple[str | None, str | None]:
    """Return a portable '~/...' link target, or a refusal reason.

    Symlinks are only followed when their final target stays inside the source
    home. That keeps dotS-style link farms working without pulling files from
    /etc, /root or other users into the bundle.
    """
    try:
        resolved = src.resolve(strict=True)
    except (OSError, RuntimeError):
        return None, "broken or looping symlink"
    if not resolved.is_file():
        return None, "symlink target is not a regular file"
    root = Path(home).resolve()
    try:
        rel = resolved.relative_to(root)
    except ValueError:
        return None, "symlink target outside home"
    if rel == Path("."):
        return None, "symlink target is home directory"
    return "~/" + str(rel), None


def safe_link_target(link: str, home: str) -> str:
    """Validate a recorded '~/...' link target before creating it on target."""
    if not isinstance(link, str) or not link.startswith("~/") or "\n" in link:
        die(f"refusing unsafe dotfile link target: {link!r}")
    p = expand(link, home)
    root = Path(home).resolve(strict=False)
    resolved = p.resolve(strict=False)
    if resolved == root or root not in resolved.parents:
        die(f"refusing dotfile link outside target home: {link!r}")
    return str(p)


def clean_generated_dirs() -> None:
    """Remove stale generated artifacts so re-capture cannot bundle old secrets."""
    for base in (REPO / "dotfiles", REPO / "system", REPO / "ssh/users"):
        if base.exists():
            for p in sorted(base.rglob("*"), key=lambda x: len(x.parts), reverse=True):
                if p.is_symlink() or p.is_file():
                    p.unlink()
                elif p.is_dir():
                    try:
                        p.rmdir()
                    except OSError:
                        pass
        base.mkdir(parents=True, exist_ok=True)
    ak = REPO / "ssh/authorized_keys"
    if ak.is_symlink() or ak.exists():
        ak.unlink()


def safe_capture_source(src: Path, rel: str, pats: list[str]) -> str | None:
    """Return a skip reason, or None when src is safe to copy."""
    st = lstat(src)
    if st is None:
        return "missing"
    if stat.S_ISLNK(st.st_mode):
        return "symlink (refusing to follow)"
    if not stat.S_ISREG(st.st_mode):
        return "not a regular file"
    if is_denied(rel, pats) or is_denied(str(src.resolve()), pats):
        return "denylist"
    return None


def _capture_allow_entries() -> set[str]:
    if not CAPTURE_ALLOW.exists():
        return set()
    return {
        line.strip() for line in CAPTURE_ALLOW.read_text(errors="replace").splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    }


def capture_allowed(src: Path, rel: str) -> bool:
    entries = _capture_allow_entries()
    if rel in entries:
        return True
    try:
        digest = sha256_file(src)
    except OSError:
        return False
    return any(e in entries for e in
               (f"sha256:{digest}", f"sha256:{digest[:12]}"))


def content_secret_hits(src: Path, rel: str) -> list[str]:
    """Return matched secret-pattern labels for a candidate capture file."""
    if capture_allowed(src, rel):
        return []
    try:
        raw = src.read_bytes()
    except OSError:
        return []
    if b"\x00" in raw[:4096]:
        return []
    text = raw.decode(errors="replace")
    hits = []
    for pattern in SECRET_PATTERNS:
        if pattern.search(text) and pattern.pattern not in hits:
            hits.append(pattern.pattern)
    return hits


def capture_copy(src: Path, rel: str, dst: Path, pats: list[str],
                 copied: list, skipped: list, *, label: str = "") -> bool:
    """Path-check, content-scan and copy one source file into the bundle."""
    show = label or rel
    why = safe_capture_source(src, rel, pats)
    if why:
        if why != "missing":
            skipped.append((show, why))
        return False
    hits = content_secret_hits(src, rel)
    if hits:
        skipped.append((show, "content secret: " + ", ".join(hits[:3])))
        return False
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        shutil.copy2(src, dst)
    except PermissionError:
        skipped.append((show, "permission denied - rerun with sudo"))
        return False
    copied.append(show + (" (allowed by capture-allow.txt)"
                          if capture_allowed(src, rel) else ""))
    return True


USER_NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}\$?$")
NOLOGIN_SHELLS = {
    "/usr/sbin/nologin", "/sbin/nologin", "/bin/false", "/usr/bin/false", "false",
}


def parse_user_list(raw: str) -> list[str]:
    names = []
    for part in raw.split(","):
        name = part.strip()
        if not name:
            continue
        if not USER_NAME_RE.match(name):
            die(f"invalid user name in --users: {name}")
        if name not in names:
            names.append(name)
    if not names:
        die("--users needs at least one name")
    return names


def primary_group(pw: pwd.struct_passwd) -> str:
    try:
        return grp.getgrgid(pw.pw_gid).gr_name
    except KeyError:
        return ""


def supplementary_groups(name: str, primary: str) -> list[str]:
    try:
        pw = pwd.getpwnam(name)
        gids = os.getgrouplist(name, pw.pw_gid)
    except (KeyError, OSError):
        return []
    names = []
    for gid in gids:
        try:
            g = grp.getgrgid(gid).gr_name
        except KeyError:
            continue
        if g and g != primary:
            names.append(g)
    return sorted(set(names))


def capture_user_spec(name: str, pats: list[str], copied: list,
                      skipped: list) -> dict:
    if not user_exists(name):
        die(f"cannot capture unknown user: {name}")
    pw = pwd.getpwnam(name)
    pg = primary_group(pw)
    shell = pw.pw_shell or "/bin/bash"
    spec = {
        "name": name,
        "home": pw.pw_dir,
        "shell": shell,
        "group": pg,
        "groups": supplementary_groups(name, pg),
        "sudo_group": "sudo" if in_group(name, "sudo") else "",
        "ssh_allow": shell not in NOLOGIN_SHELLS,
        "create_home": True,
        "authorized_keys": "",
    }
    ak = Path(pw.pw_dir) / ".ssh/authorized_keys"
    rel = f"ssh/users/{name}/authorized_keys"
    if capture_copy(ak, rel, REPO / rel, pats, copied, skipped):
        spec["authorized_keys"] = rel
    return spec


def load_previous_users() -> list[dict]:
    if not MANIFEST.exists():
        return []
    try:
        with MANIFEST.open("rb") as f:
            old = tomllib.load(f)
    except Exception:
        return []
    return [
        dict(u) for u in old.get("users", [])
        if isinstance(u, dict) and isinstance(u.get("name"), str)
        and USER_NAME_RE.match(u["name"])
    ]


def validate_groups(groups, label: str) -> list[str]:
    if groups is None:
        return []
    if (not isinstance(groups, list) or
            not all(isinstance(g, str) and USER_NAME_RE.match(g) for g in groups)):
        die(f"invalid groups for {label}")
    return groups


def effective_users(m: dict) -> list[dict]:
    """Target user plus explicit [[users]] entries, normalized for apply/plan."""
    t = m["target"]
    out = [{
        "name": t["user"],
        "home": str(Path(t["home"]).expanduser()),
        "shell": t.get("shell", "/bin/bash"),
        "group": t.get("group", ""),
        "groups": validate_groups(t.get("groups", []), "target user"),
        "sudo_group": t.get("sudo_group", ""),
        "authorized_keys": m.get("ssh", {}).get("authorized_keys_file",
                                               "ssh/authorized_keys"),
        "authorized_keys_inline": "",
        "ssh_allow": True,
        "create_home": True,
    }]
    seen = {t["user"]}
    for u in m.get("users", []):
        if not isinstance(u, dict):
            die("invalid [[users]] entry in manifest.toml")
        name = u.get("name")
        if not isinstance(name, str) or not USER_NAME_RE.match(name):
            die(f"invalid user name in [[users]]: {name}")
        if name in seen:
            log(f"users: duplicate entry for {name} ignored", "WARN")
            continue
        seen.add(name)
        groups = validate_groups(u.get("groups", []), f"user {name}")
        home = str(Path(str(u.get("home", f"/home/{name}"))).expanduser())
        if not Path(home).is_absolute():
            die(f"home for user {name} must be absolute: {home}")
        ak = u.get("authorized_keys", "")
        if ak is not None and not isinstance(ak, str):
            die(f"authorized_keys for user {name} must be a path string")
        out.append({
            "name": name,
            "home": home,
            "shell": str(u.get("shell", "/bin/bash")),
            "group": str(u.get("group", "") or ""),
            "groups": groups,
            "sudo_group": str(u.get("sudo_group", "") or ""),
            "authorized_keys": ak or "",
            "authorized_keys_inline": str(u.get("authorized_keys_inline", "") or ""),
            "ssh_allow": u.get("ssh_allow", True) is not False,
            "create_home": u.get("create_home", True) is not False,
        })
    return out


def collect_baseline(args) -> tuple[dict, list[str], list[tuple[str, str]], dict]:
    """Read the source machine and stage its curated files into the repo.

    Shared by `capture` and `audit`. Never writes manifest/reports itself.
    The last element is non-secret package-inventory provenance.
    """
    pats = load_denylist()
    user = args.user or os.environ.get("SUDO_USER") or getpass.getuser()
    previous = load_previous_users()
    if getattr(args, "clear_users", False):
        extra_names = []
    elif getattr(args, "users", None) is not None:
        extra_names = parse_user_list(args.users)
    else:
        extra_names = [u["name"] for u in previous]

    clean_generated_dirs()
    copied, skipped, dfmap, sysmap = [], [], {}, {}
    prev_by_name = {u["name"]: u for u in previous}
    extra_users = []
    for name in extra_names:
        if name == user:
            log(f"capture: {name} is already the target user; skipping", "WARN")
            continue
        if user_exists(name):
            extra_users.append(capture_user_spec(name, pats, copied, skipped))
        elif name in prev_by_name:
            spec = dict(prev_by_name[name])
            spec["authorized_keys"] = ""
            extra_users.append(spec)
            skipped.append((name, "not present on this host; manifest entry kept"))
        else:
            die(f"cannot capture unknown user: {name}")

    try:
        home = str(Path("~" + user).expanduser())
    except Exception:
        home = str(Path.home())

    packages, inv_meta = inventory_packages(home)

    port = detect_ssh_port()
    try:
        primary = grp.getgrgid(pwd.getpwnam(user).pw_gid).gr_name
    except Exception:
        primary = user
    sudo_group = "sudo" if in_group(user, "sudo") else ""

    data = {
        "meta": {
            "schema": 1,
            "name": getattr(args, "name", None) or "vps-baseline",
            "captured_at": now(),
            "source_host": socket.gethostname(),
            "source_os": os_pretty(),
        },
        "target": {
            "user": user,
            "group": primary,
            "groups": supplementary_groups(user, primary),
            "sudo_group": sudo_group,
            "shell": pwd.getpwnam(user).pw_shell if user_exists(user) else "/bin/bash",
            "home": home,
            "hostname": socket.gethostname(),
        },
        "system": {
            "timezone": detect_timezone(),
            "locale": os.environ.get("LANG", "C.UTF-8"),
        },
        "ssh": {
            "port": port,
            "hardening_file": "ssh/sshd_hardening.conf",
            "authorized_keys_file": "ssh/authorized_keys",
            "allow_users": [user],
        },
        "firewall": {
            "enable": bool(shutil.which("ufw")),
            "default_incoming": "deny",
            "allow": detect_ufw_allow(port),
        },
        "fail2ban": {"enable": True},
        "packages": packages,
        "services": {"enable": enabled_services()},
        "repos": detect_repos(home),
        "binaries": detect_binaries(home),
        "data": {"paths": [], "exclude": []},
        "cloud": {"preserve_hostname": True, "manage_etc_hosts": False},
        "hooks": {
            "pre_apply": "hooks/pre-apply.sh",
            "post_apply": "hooks/post-apply.sh",
        },
        "dotfile_symlinks": {},
        "policy": {"allow_symlinks": False},
    }
    if extra_users:
        data["users"] = extra_users

    for rel in DOTFILE_ALLOW:
        src = Path(home) / rel
        dst = REPO / "dotfiles" / rel
        capture_src = src
        link_target = None
        st = lstat(src)
        if st is not None and stat.S_ISLNK(st.st_mode):
            link_target, why = symlink_link_target(src, home)
            if why:
                skipped.append((rel, "symlink " + why))
                continue
            capture_src = src.resolve(strict=True)
        label = f"{rel} -> {link_target}" if link_target else rel
        if capture_copy(capture_src, rel, dst, pats, copied, skipped, label=label):
            target = f"~/{rel}"
            dfmap[target] = str(dst.relative_to(REPO))
            if link_target:
                data["dotfile_symlinks"][target] = link_target

    for abspath in SYSTEM_ALLOW:
        src = Path(abspath)
        dst = REPO / "system" / str(src).lstrip("/")
        if capture_copy(src, abspath, dst, pats, copied, skipped):
            sysmap[abspath] = str(dst.relative_to(REPO))

    ak = Path(home) / ".ssh/authorized_keys"
    capture_copy(ak, ".ssh/authorized_keys", REPO / "ssh/authorized_keys",
                 pats, copied, skipped, label=".ssh/authorized_keys (public keys only)")

    dh = REPO / "ssh/sshd_hardening.conf"
    dh.parent.mkdir(parents=True, exist_ok=True)
    dh.write_text(sshd_dropin(port))
    copied.append("ssh/sshd_hardening.conf (generated)")

    data["dotfiles"] = dfmap
    data["system_files"] = sysmap
    return data, copied, skipped, inv_meta


def write_capture_report(data: dict, copied: list[str],
                         skipped: list[tuple[str, str]]) -> None:
    REPORTS.mkdir(exist_ok=True)
    users = data.get("users", [])
    lines = [
        f"captured: {now()}",
        f"source:   {data['meta']['source_os']} / {data['meta']['source_host']}",
        f"user:     {data['target']['user']}  home={data['target']['home']}  "
        f"shell={data['target']['shell']}",
        f"extra users: {len(users)}",
        *[f"  @ {u['name']}  shell={u.get('shell', '')}  "
          f"ssh={'yes' if u.get('ssh_allow', True) else 'no'}"
          for u in users],
        f"ssh port: {data['ssh']['port']}",
        f"apt manual packages: {len(data['packages']['apt'])}",
        f"dotfiles: {len(data['dotfiles'])}   "
        f"symlinks: {len(data.get('dotfile_symlinks', {}))}   "
        f"system files: {len(data['system_files'])}",
        f"git repos: {len(data['repos'])}   external binaries: {len(data['binaries'])}",
        "",
        "Ship list (captured into bundle):",
        *[f"  + {c}" for c in copied],
        "",
        "Quarantined by content scan:",
        *([f"  ! {p}  [{why}]" for p, why in skipped
           if why.startswith("content secret")] or ["  (none)"]),
        "",
        "Skipped (denylist / noise / unreadable):",
        *[f"  - {p}  [{why}]" for p, why in skipped
          if not why.startswith("content secret")],
        "",
        "Git repos to re-clone on target:",
        *[f"  * {r['path']}  <- {r['url']}" for r in data["repos"]],
        "",
        "External binaries (NOT copied - fill in [[binaries]].install):",
        *[f"  * {b['path']}  (~{b['size_mb']} MiB)" for b in data["binaries"]],
        "",
        "Content scan refuses token/password/private-key markers even in",
        "allowlisted paths. To override a false positive, add the relative path",
        "or sha256:<hash> to capture-allow.txt; add path patterns to denylist.txt.",
    ]
    atomic_write_text(REPORTS / "capture-report.txt", "\n".join(lines) + "\n")


def op_capture(args) -> None:
    data, copied, skipped, inv_meta = collect_baseline(args)
    atomic_write_text(MANIFEST, toml_dump(data))
    write_capture_report(data, copied, skipped)
    for w in inv_meta.get("warnings", []):
        log(f"inventory: {w}", "WARN")
    log(f"wrote {MANIFEST}")
    log(f"wrote {REPORTS / 'capture-report.txt'}")
    log(f"{len(copied)} files captured, {len(skipped)} skipped")
    log("next: review manifest.toml, then `vpsclone plan`")


