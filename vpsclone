class Backups:
    def __init__(self, stamp: str):
        self.root = BACKUP_ROOT / stamp
        self.index: list[dict] = []

    def take(self, path) -> None:
        p = Path(path).absolute()
        st = lstat(p)
        if st is None:
            return
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing to back up non-regular file: {p}")
        assert_no_symlink_components(p)
        dest = self.root / str(p).lstrip("/")
        assert_no_symlink_components(dest, root=BACKUP_ROOT)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, dest)
        self.index.append({"backup": str(dest), "original": str(p)})
        # Persist immediately: a later step failure must not lose rollback data.
        self.save()

    def save(self) -> None:
        if not self.index:
            return
        self.root.mkdir(parents=True, exist_ok=True)
        atomic_write_text(self.root / "index.json", json.dumps(self.index, indent=2) + "\n")
        log(f"backup index: {self.root / 'index.json'}")


def write_managed(src, dst, *, mode=None, owner=None, backups: Backups | None = None) -> bool:
    s, d = Path(src), Path(dst)
    assert_regular_file(s, root=REPO)
    data = s.read_bytes()
    assert_regular_file(d, must_exist=False)
    if d.exists() and d.read_bytes() == data:
        return False
    if backups is not None:
        backups.take(d)
    write_bytes_no_symlink(d, data, mode=mode, owner=owner)
    log(f"wrote {d}")
    return True


def write_managed_symlink(link: str, dst: Path, *, home: str, owner: str,
                          backups: Backups | None = None) -> bool:
    """Recreate a captured dotfile symlink, safely and idempotently."""
    d = Path(dst)
    target = safe_link_target(link, home)
    assert_no_symlink_components(d.parent)
    st = lstat(d)
    if st is not None and stat.S_ISLNK(st.st_mode):
        if os.readlink(d) == target:
            return False
        d.unlink()
    elif st is not None:
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing to replace non-regular file with symlink: {d}")
        if backups is not None:
            backups.take(d)
        d.unlink()
    d.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(target, d)
    if owner:
        os.chown(d, pwd.getpwnam(owner).pw_uid, -1, follow_symlinks=False)
    log(f"linked {d} -> {target}")
    return True


def write_text_managed(text: str, dst, *, mode=None, owner=None,
                       backups: Backups | None = None) -> bool:
    data = (text.rstrip("\n") + "\n").encode()
    d = Path(dst)
    assert_regular_file(d, must_exist=False)
    if d.exists() and d.read_bytes() == data:
        return False
    if backups is not None:
        backups.take(d)
    write_bytes_no_symlink(d, data, mode=mode, owner=owner)
    log(f"wrote {d}")
    return True


def step_packages(m, dry, backups) -> None:
    pkgs = m.get("packages", {})
    user = m["target"]["user"]
    home = m["target"]["home"]
    env = {"HOME": home}

    missing = [p for p in pkgs.get("apt", []) if not pkg_installed(p)]
    if not missing:
        log("apt: all manifest packages present")
    elif dry:
        log(f"apt: would install {len(missing)} packages")
    else:
        apt_env = {"DEBIAN_FRONTEND": "noninteractive"}
        cmd(["apt-get", "update", "-qq"], check=True, env=apt_env)
        cmd(["apt-get", "install", "-y", "-qq", "--", *missing], check=True, env=apt_env)
        log(f"apt: installed {len(missing)} packages")

    npm_want = expected_versions(m, "npm")
    npm_specs = []
    for name, ver in npm_want.items():
        if name.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_@./+-]+", name):
            log(f"npm: unsafe package name skipped: {name!r}", "WARN")
            continue
        npm_specs.append(f"{name}@{ver}" if ver
                         and re.fullmatch(r"[0-9A-Za-z_.+-]+", ver) else name)
    if npm_specs:
        if dry:
            log(f"npm: would install {len(npm_specs)} pinned global package(s)")
        elif not shutil.which("npm"):
            log("npm not installed, skipping global packages", "WARN")
        else:
            rc, out = cmd(["npm", "install", "-g", "--", *npm_specs],
                          as_user=user, env=env, check=False)
            log(f"npm global packages: {'ok' if rc == 0 else 'FAILED'} {out.strip()[:120]}",
                "INFO" if rc == 0 else "WARN")

    pipx_want = expected_versions(m, "pipx")
    if pipx_want:
        if dry:
            log(f"pipx: would install {len(pipx_want)} pinned tool(s)")
        elif not shutil.which("pipx"):
            log("pipx not installed, skipping tools", "WARN")
        else:
            failed = []
            for name, ver in pipx_want.items():
                spec = f"{name}=={ver}" if ver else name
                if spec.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.+=-]+", spec):
                    log(f"pipx: unsafe spec skipped: {spec!r}", "WARN")
                    continue
                rc, out = cmd(["pipx", "install", spec], as_user=user, env=env, check=False)
                if rc:
                    failed.append(f"{spec}: {out.strip().splitlines()[-1] if out.strip() else 'failed'}")
            log(f"pipx tools: {'ok' if not failed else 'FAILED'} {'; '.join(failed)[:160]}",
                "INFO" if not failed else "WARN")

    cargo_want = expected_versions(m, "cargo")
    safe_cargo = []
    for name, ver in cargo_want.items():
        if re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", name):
            safe_cargo.append((name, ver))
        else:
            log(f"cargo: unsafe crate name skipped: {name!r}", "WARN")
    if safe_cargo:
        if dry:
            log(f"cargo: would install {len(safe_cargo)} pinned crate(s)")
        elif not shutil.which("cargo"):
            log("cargo not installed, skipping crate installs", "WARN")
        else:
            failed = []
            for name, ver in safe_cargo:
                argv = ["cargo", "install", name]
                if ver and re.fullmatch(r"[0-9A-Za-z_.+-]+", ver):
                    argv += ["--version", ver]
                rc, out = cmd(argv, as_user=user, env=env, check=False)
                if rc:
                    failed.append(f"{name}@{ver or 'latest'}: "
                                  f"{out.strip().splitlines()[-1] if out.strip() else 'failed'}")
            log(f"cargo crates: {'ok' if not failed else 'FAILED'} {'; '.join(failed)[:160]}",
                "INFO" if not failed else "WARN")


def ensure_group(name: str, dry: bool) -> None:
    if not name:
        return
    try:
        grp.getgrnam(name)
        return
    except KeyError:
        pass
    if dry:
        log(f"users: would create group {name}")
        return
    cmd(["groupadd", name], check=False)
    try:
        grp.getgrnam(name)
    except KeyError:
        log(f"users: could not create group {name}", "WARN")


def repo_asset(rel: str) -> Path:
    p = Path(rel)
    if p.is_absolute() or ".." in p.parts:
        die(f"unsafe repo asset path: {rel}")
    fp = REPO / p
    assert_no_symlink_components(fp, root=REPO)
    return fp


def step_users(m, dry, backups) -> None:
    for u in effective_users(m):
        name = u["name"]
        home = Path(u["home"])
        shell = u["shell"]
        create_home = u["create_home"]

        ensure_group(u["group"], dry)
        for g in u["groups"]:
            ensure_group(g, dry)

        if not user_exists(name):
            argv = ["useradd", "-M" if not create_home else "-m",
                    "-d", str(home), "-s", shell]
            if u["group"]:
                argv += ["-g", u["group"]]
            argv.append(name)
            if dry:
                log(f"users: would create {name} (shell {shell})")
            else:
                cmd(argv, check=True)
                log(f"created user {name}")
        else:
            current_shell = pwd.getpwnam(name).pw_shell
            if current_shell != shell:
                if dry:
                    log(f"users: would chsh {name}: {current_shell} -> {shell}")
                else:
                    rc, _ = cmd(["chsh", "-s", shell, name], check=False)
                    log(f"shell for {name}: "
                        f"{'ok' if rc == 0 else 'SKIPPED (is shell installed?)'}",
                        "INFO" if rc == 0 else "WARN")
            if u["group"]:
                pw = pwd.getpwnam(name)
                try:
                    current_group = grp.getgrgid(pw.pw_gid).gr_name
                except KeyError:
                    current_group = ""
                if current_group != u["group"]:
                    if dry:
                        log(f"users: would set primary group {name} -> {u['group']}")
                    else:
                        cmd(["usermod", "-g", u["group"], name], check=False)

        if create_home and not dry:
            assert_no_symlink_components(home)
            home.mkdir(parents=True, exist_ok=True)
            pw = pwd.getpwnam(name)
            shutil.chown(home, user=name, group=pw.pw_gid)
            os.chmod(home, 0o755)

        ak_rel = u.get("authorized_keys", "")
        inline_keys = str(u.get("authorized_keys_inline", "") or "").strip()
        src = repo_asset(ak_rel) if ak_rel else None
        need_ssh = bool(src) or bool(inline_keys) or u["ssh_allow"]
        if need_ssh and not create_home and not home.is_dir():
            log(f"users: home {home} missing for {name}; skipping ssh setup", "WARN")
            need_ssh = False
        if need_ssh:
            sshdir = home / ".ssh"
            if not dry:
                assert_no_symlink_components(sshdir, root=home)
                if sshdir.exists() and not sshdir.is_dir():
                    die(f"refusing non-directory ssh dir: {sshdir}")
                sshdir.mkdir(parents=True, exist_ok=True, mode=0o700)
                os.chmod(sshdir, 0o700)
                shutil.chown(sshdir, user=name)
            target_ak = sshdir / "authorized_keys"
            if inline_keys:
                want = (inline_keys.rstrip("\n") + "\n").encode()
                if dry:
                    if not target_ak.exists() or target_ak.read_bytes() != want:
                        log(f"users: would write inline keys to {target_ak}")
                else:
                    write_text_managed(inline_keys, target_ak, mode=0o600,
                                       owner=name, backups=backups)
            elif src and src.is_file():
                if dry:
                    if (not target_ak.exists() or
                            target_ak.read_bytes() != src.read_bytes()):
                        log(f"users: would write {target_ak}")
                else:
                    write_managed(src, target_ak, mode=0o600, owner=name,
                                  backups=backups)
            elif src:
                log(f"users: authorized_keys source missing for {name}: {ak_rel}", "WARN")

        for g in u["groups"]:
            if not in_group(name, g):
                if dry:
                    log(f"users: would add {name} to {g}")
                else:
                    cmd(["usermod", "-aG", g, name], check=True)
        sudo_group = u.get("sudo_group", "")
        if sudo_group and user_exists(name) and not in_group(name, sudo_group):
            if dry:
                log(f"users: would add {name} to {sudo_group}")
            else:
                cmd(["usermod", "-aG", sudo_group, name], check=True)

    if not dry:
        tz = m.get("system", {}).get("timezone")
        if tz:
            cmd(["timedatectl", "set-timezone", tz], check=False)
        host = m["target"].get("hostname")
        if host and socket.gethostname() != host:
            cmd(["hostnamectl", "set-hostname", host], check=False)


def step_dotfiles(m, dry, backups) -> None:
    home = m["target"]["home"]
    owner = m["target"]["user"]
    allow_links = str(m.get("policy", {}).get("allow_symlinks", False)).lower() \
        in {"1", "true", "yes", "y"}
    links = (m.get("baseline", {}).get("dotfile_symlinks", {}) or {})
    n = 0
    for target, src in m.get("dotfiles", {}).items():
        d = expand(target, home)
        s = REPO / src
        mode = 0o600 if str(d).endswith("/.ssh/config") else None
        link = links.get(target) if allow_links else None
        if dry:
            if not s.is_file():
                log(f"dotfiles: missing source {s}", "WARN")
            elif link:
                want = safe_link_target(link, home)
                if not d.is_symlink() or os.readlink(d) != want:
                    log(f"dotfiles: would link {d} -> {want}")
                    n += 1
            elif not d.is_file() or d.read_bytes() != s.read_bytes():
                log(f"dotfiles: would write {d}")
                n += 1
        elif link:
            if write_managed_symlink(link, d, home=home, owner=owner,
                                     backups=backups):
                n += 1
        elif write_managed(s, d, mode=mode, owner=owner, backups=backups):
            n += 1
    log(f"dotfiles: {n} written/needed")


def step_system_files(m, dry, backups) -> None:
    for target, src in m.get("system_files", {}).items():
        d, s = Path(target), REPO / src
        if dry:
            if not s.is_file():
                log(f"system: missing source {s}", "WARN")
            elif not d.is_file() or d.read_bytes() != s.read_bytes():
                log(f"system: would write {d}")
        else:
            write_managed(s, d, mode=0o644, backups=backups)
    cloud = m.get("cloud", {})
    cloud_dropin = Path("/etc/cloud/cloud.cfg.d/99-vpsclone.cfg")
    body = ""
    if cloud.get("preserve_hostname"):
        body += "preserve_hostname: true\n"
    if not cloud.get("manage_etc_hosts", True):
        body += "manage_etc_hosts: false\n"
    if body:
        if dry:
            log(f"system: would write {cloud_dropin}")
        else:
            assert_regular_file(cloud_dropin, must_exist=False)
            if not cloud_dropin.is_file() or cloud_dropin.read_text() != body:
                backups.take(cloud_dropin)
                write_bytes_no_symlink(cloud_dropin, body.encode(), mode=0o644)
                log(f"wrote {cloud_dropin}")


def step_firewall(m, dry, backups) -> None:
    fw = m.get("firewall", {})
    if not fw.get("enable", True):
        log("firewall: disabled in manifest")
        return
    if not shutil.which("ufw"):
        log("ufw not installed, skipping firewall", "WARN")
        return
    rules = []
    for raw in fw.get("allow", []):
        rule = str(raw)
        if rule.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.:/-]+", rule):
            die(f"unsafe firewall rule in manifest: {rule!r}")
        rules.append(rule)
    sshrule = f"{m['ssh']['port']}/tcp"
    if sshrule not in rules:
        rules.insert(0, sshrule)
    if dry:
        log(f"firewall: would default-deny incoming and allow {rules}")
        return
    cmd(["ufw", "default", "deny", "incoming"], check=True)
    cmd(["ufw", "default", "allow", "outgoing"], check=True)
    for r in rules:
        cmd(["ufw", "allow", r], check=True)
    cmd(["ufw", "--force", "enable"], check=True)
    log("firewall: rules applied (ssh port opened BEFORE sshd reload)")


def ssh_unit() -> str:
    rc, out = cmd(["systemctl", "list-unit-files", "sshd.service", "--no-pager",
                   "--plain"], quiet=True)
    return "sshd" if rc == 0 and "sshd.service" in out else "ssh"


CUTOVER_STATE = REPO / "ssh-cutover.json"
FINAL_DROPIN = Path("/etc/ssh/sshd_config.d/99-vpsclone.conf")
CUTOVER_DROPIN = Path("/etc/ssh/sshd_config.d/99-vpsclone-cutover.conf")


def _valid_port(value: str) -> bool:
    return value.isdigit() and 1 <= int(value) <= 65535


def _active_ssh_ports() -> list[str]:
    rc, out = cmd(["sshd", "-T"], quiet=True)
    if rc:
        return []
    return sorted({p for p in re.findall(r"(?m)^port\s+(\d+)\s*$", out)
                   if _valid_port(p)})


def _port_listening(port: str) -> bool:
    rc, out = cmd(["ss", "-tulpn"], quiet=True)
    return rc == 0 and (f":{port} " in out or f":{port}\n" in out)


def _write_dropin(path: Path, body: str) -> None:
    assert_regular_file(path, must_exist=False)
    write_bytes_no_symlink(path, body.encode(), mode=0o644)


def _restore_ssh_files(final_bytes: bytes | None,
                       cutover_bytes: bytes | None) -> None:
    for path, data in ((FINAL_DROPIN, final_bytes),
                       (CUTOVER_DROPIN, cutover_bytes)):
        if data is None:
            path.unlink(missing_ok=True)
        else:
            _write_dropin(path, data.decode())


def _load_cutover() -> dict | None:
    if not CUTOVER_STATE.is_file():
        return None
    try:
        state = json.loads(CUTOVER_STATE.read_text())
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) and {"old_port", "new_port"} <= state.keys() else None


def _save_cutover(state: dict) -> None:
    atomic_write_text(CUTOVER_STATE, json.dumps(state, sort_keys=True) + "\n",
                      mode=0o600)


def _spawn_cutover_watchdog(seconds: int, token: str) -> None:
    """Detached timer: roll back if the cutover is not committed in time."""
    if seconds <= 0:
        return
    exe = [sys.executable, str(Path(__file__).resolve())]
    subprocess.Popen(
        [*exe, "ssh-cutover-watchdog", "--seconds", str(seconds), "--id", token],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True, cwd=str(REPO),
    )


def ssh_cutover_prepare(m: dict, backups, rollback_seconds: int = 600) -> None:
    """Open both ports, reload, verify, then wait for explicit commit."""
    src = REPO / m["ssh"]["hardening_file"]
    if not src.is_file():
        log("ssh: hardening file missing", "WARN")
        return
    new_port = str(m["ssh"]["port"])
    old_port = str(m["ssh"].get("old_port", "") or "")
    if not old_port or old_port == new_port:
        old_port = next((p for p in _active_ssh_ports() if p != new_port), "")
    if not _valid_port(new_port):
        die(f"invalid ssh port in manifest: {new_port!r}")

    final_body = render_dropin(m, src.read_text())
    prev_final = FINAL_DROPIN.read_bytes() if FINAL_DROPIN.is_file() else None
    prev_cutover = CUTOVER_DROPIN.read_bytes() if CUTOVER_DROPIN.is_file() else None

    if not old_port or old_port == new_port:
        backups.take(FINAL_DROPIN)
        _write_dropin(FINAL_DROPIN, final_body)
        CUTOVER_DROPIN.unlink(missing_ok=True)
        CUTOVER_STATE.unlink(missing_ok=True)
        rc, out = cmd(["sshd", "-t"])
        if rc:
            _restore_ssh_files(prev_final, prev_cutover)
            die(f"sshd -t failed; reverted drop-in:\n{out.strip()}")
        cmd(["systemctl", "reload", ssh_unit()], check=False)
        log(f"ssh: no port change ({new_port}); final drop-in applied")
        return

    dual, n = re.subn(r"(?m)^Port\s+\d+\s*$",
                      f"Port {old_port}\nPort {new_port}", final_body, count=1)
    if n == 0:
        dual = f"Port {old_port}\nPort {new_port}\n{final_body}"

    backups.take(FINAL_DROPIN)
    _write_dropin(CUTOVER_DROPIN, dual)
    FINAL_DROPIN.unlink(missing_ok=True)
    rc, out = cmd(["sshd", "-t"])
    if rc:
        _restore_ssh_files(prev_final, prev_cutover)
        die(f"sshd -t failed; reverted drop-in:\n{out.strip()}")
    rc, out = cmd(["systemctl", "reload", ssh_unit()], check=False)
    if rc:
        _restore_ssh_files(prev_final, prev_cutover)
        cmd(["systemctl", "reload", ssh_unit()], check=False)
        die(f"sshd reload failed; reverted drop-in:\n{out.strip()}")
    if not (_port_listening(new_port) and _port_listening(old_port)):
        _restore_ssh_files(prev_final, prev_cutover)
        cmd(["systemctl", "reload", ssh_unit()], check=False)
        die(f"sshd did not listen on both ports ({old_port}, {new_port}); reverted")

    token = secrets.token_hex(8)
    _save_cutover({
        "old_port": old_port,
        "new_port": new_port,
        "prepared_at": now(),
        "watchdog_id": token,
        "rollback_seconds": rollback_seconds,
        "previous_final": prev_final.decode() if prev_final is not None else None,
        "previous_cutover": (prev_cutover.decode()
                             if prev_cutover is not None else None),
    })
    _spawn_cutover_watchdog(rollback_seconds, token)
    log(f"ssh: prepared dual-port cutover {old_port} -> {new_port} (both live)")
    log(f"ssh: auto-rollback in {rollback_seconds}s if not committed")
    log("ssh: verify a FRESH login on the new port, then run "
        "ssh-cutover-commit --confirm-login (or ssh-cutover-rollback)")


def ssh_cutover_commit(m: dict, backups) -> None:
    state = _load_cutover()
    if not state:
        die("no prepared ssh cutover found (run ssh-cutover-prepare first)")
    new_port = str(m["ssh"]["port"])
    if str(state["new_port"]) != new_port:
        die(f"manifest port {new_port} no longer matches prepared cutover "
            f"{state['new_port']}; run ssh-cutover-rollback first")
    src = REPO / m["ssh"]["hardening_file"]
    if not src.is_file():
        die("hardening file missing; cannot commit ssh cutover")

    prev_final = (state.get("previous_final") or "").encode() \
        if state.get("previous_final") is not None else None
    prev_cutover = CUTOVER_DROPIN.read_bytes() if CUTOVER_DROPIN.is_file() else None
    backups.take(FINAL_DROPIN)
    _write_dropin(FINAL_DROPIN, render_dropin(m, src.read_text()))
    CUTOVER_DROPIN.unlink(missing_ok=True)
    rc, out = cmd(["sshd", "-t"])
    if rc:
        _restore_ssh_files(prev_final, prev_cutover)
        die(f"sshd -t failed during commit; reverted:\n{out.strip()}")
    rc, out = cmd(["systemctl", "reload", ssh_unit()], check=False)
    if rc or not _port_listening(new_port):
        _restore_ssh_files(prev_final, prev_cutover)
        cmd(["systemctl", "reload", ssh_unit()], check=False)
        die(f"ssh commit failed on port {new_port}; reverted:\n{out.strip()}")
    CUTOVER_STATE.unlink(missing_ok=True)
    log(f"ssh: cutover committed on port {new_port}; old firewall rule left "
        "for manual cleanup")


def ssh_cutover_rollback() -> None:
    state = _load_cutover()
    if not state:
        die("no prepared ssh cutover found")
    prev_final = (state.get("previous_final") or "").encode() \
        if state.get("previous_final") is not None else None
    prev_cutover = (state.get("previous_cutover") or "").encode() \
        if state.get("previous_cutover") is not None else None
    _restore_ssh_files(prev_final, prev_cutover)
    rc, out = cmd(["sshd", "-t"])
    if rc:
        die(f"sshd -t failed after rollback:\n{out.strip()}")
    cmd(["systemctl", "reload", ssh_unit()], check=False)
    CUTOVER_STATE.unlink(missing_ok=True)
    log(f"ssh: rolled back to port {state['old_port']}")


def op_ssh_cutover_prepare(args) -> None:
    if not is_root():
        die("ssh cutover needs root")
    seconds = int(getattr(args, "rollback_seconds", 600) or 0)
    if seconds < 0:
        die("rollback seconds must be >= 0")
    ssh_cutover_prepare(load_manifest(),
                        Backups(dt.datetime.now().strftime("%Y%m%d-%H%M%S")),
                        rollback_seconds=seconds)


def op_ssh_cutover_commit(args) -> None:
    if not getattr(args, "confirm_login", False):
        die("refusing ssh commit without --confirm-login; "
            "test a fresh SSH session first")
    if not is_root():
        die("ssh cutover needs root")
    ssh_cutover_commit(load_manifest(),
                       Backups(dt.datetime.now().strftime("%Y%m%d-%H%M%S")))


def op_ssh_cutover_rollback(args) -> None:
    if not is_root():
        die("ssh cutover needs root")
    ssh_cutover_rollback()


def op_ssh_cutover_watchdog(args) -> None:
    seconds = int(args.seconds)
    if seconds < 0:
        die("invalid watchdog interval")
    time.sleep(seconds)
    state = _load_cutover()
    if state and str(state.get("watchdog_id", "")) == str(args.id):
        ssh_cutover_rollback()


def step_ssh(m, dry, backups) -> None:
    if dry:
        log(f"ssh: would prepare two-phase cutover to port {m['ssh']['port']}")
        return
    ssh_cutover_prepare(m, backups)


def step_services(m, dry, backups) -> None:
    for s in m.get("services", {}).get("enable", []):
        if dry:
            if cmd(["systemctl", "is-enabled", s], quiet=True)[0] != 0:
                log(f"services: would enable --now {s}")
            continue
        rc, _ = cmd(["systemctl", "enable", "--now", s], check=False)
        log(f"service {s}: {'ok' if rc == 0 else 'SKIPPED (check manually)'}",
            "INFO" if rc == 0 else "WARN")


def step_mise(m, dry, backups) -> None:
    tools = m.get("packages", {}).get("mise", {}).get("tools", [])
    if not tools:
        return
    user = m["target"]["user"]
    home = m["target"]["home"]
    if dry:
        log(f"mise: would install {tools} as {user}")
        return
    if not shutil.which("mise"):
        log("mise not installed, skipping tools", "WARN")
        return
    failed = []
    for tool in tools:
        spec = str(tool)
        if spec.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.@+-]+", spec):
            log(f"mise: unsafe tool spec skipped: {spec!r}", "WARN")
            continue
        rc, out = cmd(["mise", "install", spec], as_user=user,
                      env={"HOME": home}, cwd=home, check=False)
        if rc:
            failed.append(f"{spec}: {out.strip().splitlines()[-1] if out.strip() else 'failed'}")
    log(f"mise install ({', '.join(tools)}): {'ok' if not failed else 'FAILED'}",
        "INFO" if not failed else "WARN")
    if failed:
        log("; ".join(failed)[:200], "WARN")


def step_binaries(m, dry, backups) -> None:
    user, home = m["target"]["user"], m["target"]["home"]
    for b in m.get("binaries", []):
        install = b.get("install", "").strip()
        target = expand(b["path"], home)
        if target.exists():
            continue
        if not install:
            log(f"binary {b['name']}: no install command configured "
                f"(set [[binaries]].install in manifest.toml)", "WARN")
            continue
        if dry:
            log(f"binaries: would run install command for {b['name']}")
            continue
        rc, out = cmd(["sh", "-c", install], as_user=user,
                      env={"HOME": home}, check=False)
        log(f"binary {b['name']}: {'ok' if rc == 0 else 'FAILED'} {out.strip()[:120]}",
            "INFO" if rc == 0 else "WARN")


def step_repos(m, dry, backups) -> None:
    home = m["target"]["home"]
    user = m["target"]["user"]
    for r in m.get("repos", []):
        p = expand(r["path"], home)
        want_commit = str(r.get("commit", ""))
        if p.exists():
            st = git_repo_state(p)
            if want_commit and st["commit"] and st["commit"] != want_commit:
                log(f"repo {r['path']}: at {st['commit'][:8]}, "
                    f"source {want_commit[:8]} (left as-is)", "WARN")
            continue
        if dry:
            log(f"repos: would clone {r['url']} -> {p}"
                + (f" at {want_commit[:8]}" if want_commit else ""))
            continue
        branch = str(r.get("branch", "main"))
        url = str(r["url"])
        if branch.startswith("-") or url.startswith("-"):
            die(f"unsafe repo definition: branch={branch!r} url={url!r}")
        if want_commit and not re.fullmatch(r"[0-9a-fA-F]{7,40}", want_commit):
            die(f"unsafe repo commit: {want_commit!r}")
        rc, out = cmd(["git", "clone", "-b", branch, "--", url, str(p)],
                      as_user=user, env={"HOME": home}, check=False)
        if rc:
            log(f"repo {r['path']} not cloned (deploy key may not be on GitHub yet): "
                f"{out.strip().splitlines()[-1] if out.strip() else ''}", "WARN")
            continue
        log(f"cloned {r['path']}")
        if want_commit:
            rc2, out2 = cmd(["git", "-C", str(p), "checkout", "-B", branch,
                             want_commit], as_user=user, env={"HOME": home},
                            check=False)
            log(f"repo {r['path']} commit {want_commit[:8]}: "
                f"{'ok' if rc2 == 0 else out2.strip()[:80]}",
                "INFO" if rc2 == 0 else "WARN")


def run_hook(path: str, dry: bool) -> None:
    p = REPO / path
    if not p.is_file():
        return
    if dry:
        log(f"hook: would run {path}")
        return
    log(f"hook {path}: running as root from {REPO}")
    os.chmod(p, 0o755)
    rc, out = cmd([str(p)], cwd=REPO, check=False)
    log(f"hook {path}: rc={rc}\n{out.strip()}", "INFO" if rc == 0 else "ERROR")
    if rc:
        die(f"hook {path} failed with exit code {rc}")


def step_hooks(m, dry, backups) -> None:
    run_hook(m.get("hooks", {}).get("pre_apply", "hooks/pre-apply.sh"), dry)


STEP_ORDER = ["hooks", "packages", "users", "binaries", "dotfiles", "system",
              "firewall", "ssh", "services", "mise", "repos"]


def op_apply(args) -> int:
    if not args.dry_run:
        need_root()
    if getattr(args, "ssh_port", None) is not None and not 1 <= args.ssh_port <= 65535:
        die(f"invalid ssh port: {args.ssh_port}")
    m = getattr(args, "manifest_obj", None) or load_manifest()
    user = m["target"]["user"]
    if args.hostname:
        m["target"]["hostname"] = args.hostname
    if args.ssh_port is not None:
        m["ssh"]["port"] = str(args.ssh_port)
    selected = [s.strip() for s in args.only.split(",")] if args.only else STEP_ORDER
    unknown = [s for s in selected if s not in STEP_ORDER]
    if unknown:
        die(f"unknown --only step(s): {', '.join(unknown)}. Choose from {', '.join(STEP_ORDER)}")

    log(f"apply target: {user}@{m['target']['hostname']}  dry={args.dry_run}")
    if not args.dry_run and "users" not in selected:
        missing_users = [u["name"] for u in effective_users(m)
                         if not user_exists(u["name"])]
        if missing_users:
            die(f"users {', '.join(missing_users)} do not exist; "
                "include 'users' in --only or create them first")

    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backups = Backups(stamp)

    steps = {
        "hooks": step_hooks, "packages": step_packages, "users": step_users,
        "binaries": step_binaries, "dotfiles": step_dotfiles,
        "system": step_system_files, "firewall": step_firewall, "ssh": step_ssh,
        "services": step_services, "mise": step_mise, "repos": step_repos,
    }
    try:
        for name in STEP_ORDER:
            if name in selected:
                log(f"--- step: {name} ---")
                steps[name](m, args.dry_run, backups)
    except BaseException as exc:
        backups.save()
        log("apply aborted; any backups taken are indexed for rollback", "ERROR")
        if isinstance(exc, SystemExit):
            raise
        raise

    if not args.dry_run:
        backups.save()
        if "hooks" in selected:
            run_hook(m.get("hooks", {}).get("post_apply", "hooks/post-apply.sh"), False)
        verify_rc = 0
        if not args.no_verify:
            verify_rc = op_verify(argparse.Namespace(manifest_obj=m))
            if verify_rc:
                log("apply completed but verify reported failures", "WARN")
        log(f"apply complete. rollback with: sudo vpsclone rollback --stamp {stamp}")
        return verify_rc
    log("dry run complete - no changes made")
    return 0


# -------------------------------------------------------------- verify
def op_verify(args) -> int:
    m = getattr(args, "manifest_obj", None) or load_manifest()
    home = m["target"]["home"]
    checks = []

    def ck(name, ok, detail="", warn=False):
        checks.append((name, bool(ok), detail, warn))

    ck("root privileges", is_root())
    rc, out = cmd(["python3", "--version"], quiet=True)
    ck("python3 >= 3.11", rc == 0 and tuple(map(int, (out.split()[1].split(".")[:2]))) >= (3, 11))
    ck("target user exists", user_exists(m["target"]["user"]), m["target"]["user"])
    rc, ufwout = cmd(["ufw", "status"], quiet=True)
    ck("ufw active", rc == 0 and "Status: active" in ufwout)
    dots = Path(home) / ".config/dots/dots"
    ck("dotS installed", dots.exists(), str(dots), warn=True)

    for label, ok, detail, warn in check_convergence(m):
        ck(label, ok, detail, warn)

    print("\nVERIFY\n")
    fails = 0
    for name, ok, detail, warn in checks:
        mark = "PASS" if ok else ("WARN" if warn else "FAIL")
        if not ok and not warn:
            fails += 1
        print(f"  [{mark}] {name:<26} {detail}")
    print()
    if fails:
        log(f"verify: {fails} check(s) failed", "ERROR")
        return 1
    log("verify: all critical checks passed")
    return 0


# -------------------------------------------------------------- keygen
def validate_key_name(name: str) -> str:
    if (not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or name in (".", "..")
            or name.startswith("-")):
        die(f"invalid key name {name!r}: use letters, digits, '.', '_' or '-'")
    return name


def validate_ssh_target(target: str) -> str:
    if target.startswith("-") or any(c.isspace() for c in target):
        die(f"invalid ssh target {target!r}")
    return target


def op_keygen(args) -> None:
    name = validate_key_name(args.name or "deploy-github")
    comment = args.comment or f"{getpass.getuser()}@{socket.gethostname()}"
    sshdir = Path.home() / ".ssh"
    assert_no_symlink_components(sshdir, root=Path.home())
    sshdir.mkdir(mode=0o700, exist_ok=True)
    os.chmod(sshdir, 0o700)
    key = sshdir / name
    pub = Path(str(key) + ".pub")
    if key.exists() and not args.force:
        die(f"{key} exists (use --force to replace)")
    log("ssh-keygen will ask for a passphrase twice - input is hidden.")
    rc, _ = cmd(["ssh-keygen", "-t", "ed25519", "-a", "100", "-C", comment,
                 "-f", str(key)], capture=False)
    if rc or not key.exists() or not pub.exists():
        die("key generation failed")
    os.chmod(key, 0o600)
    os.chmod(pub, 0o644)
    log(f"generated {key}")

    if args.save_pub:
        dst = REPO / "ssh" / f"{name}.pub"
        dst.parent.mkdir(parents=True, exist_ok=True)
        assert_no_symlink_components(dst, root=REPO)
        shutil.copy2(pub, dst)
        log(f"saved public half to {dst} (safe to commit)")

    print("\n=== COPY THIS INTO GITHUB -> Settings -> SSH and GPG keys -> New SSH key ===")
    print(pub.read_text().strip())
    print("=============================================================================\n")

    if args.target:
        target = validate_ssh_target(args.target)
        log(f"copying key to {target}")
        cmd(["ssh", target, "mkdir", "-p", "~/.ssh"], check=True)
        cmd(["ssh", target, "chmod", "700", "~/.ssh"], check=True)
        cmd(["scp", "-p", str(key), f"{target}:.ssh/{name}"], check=True)
        cmd(["scp", "-p", str(pub), f"{target}:.ssh/{name}.pub"], check=True)
        entry = (
            "\n# managed by vpsclone keygen\n"
            "Host github.com\n"
            "    HostName github.com\n"
            "    User git\n"
            f"    IdentityFile ~/.ssh/{name}\n"
            "    IdentitiesOnly yes\n"
            "    AddKeysToAgent yes\n"
        )
        rc, _ = cmd(["ssh", target, "grep -q '^Host github.com$' ~/.ssh/config"], quiet=True)
        if rc:
            cmd(["ssh", target, "cat >> ~/.ssh/config && chmod 600 ~/.ssh/config"],
                input_text=entry, check=True)
        else:
            log("keygen: github.com host block already present on target")
        cmd(["ssh", target, "chmod", "600", f"~/.ssh/{name}"], check=True)
        log(f"key installed on {target}. Add the pubkey above, then test:")
        log(f"  ssh -T git@github.com   (from {target})")


# -------------------------------------------------------------- bundle
BUNDLE_README = """\
VPS MIRROR BUNDLE
=================

On the FRESH Ubuntu box (as root):

  1. apt-get update && apt-get install -y python3 git rsync openssh-server
  2. tar xzf vps-mirror-*.tar.gz -C /opt/
  3. cd /opt/vps-mirror && chmod +x vpsclone bootstrap.sh
  4. ./bootstrap.sh                 # or: sudo python3 vpsclone apply

Then, from your LOCAL machine, generate + ship the deploy key:

  python3 vpsclone keygen --target user@new-vps

Add the printed public key to GitHub, then on the VPS:

  ssh -T git@github.com
  python3 vpsclone apply --only=repos

Secrets are NOT in this bundle. Private keys are generated locally and
scp'd separately. See README.md for the full playbook.
"""


def op_bundle(args) -> None:
    pats = load_denylist()
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = Path(args.output) if args.output else REPO.parent / f"vps-mirror-{stamp}.tar.gz"
    assert_no_symlink_components(out)
    if out.is_symlink() or (out.exists() and not out.is_file()):
        die(f"refusing unsafe bundle output path: {out}")
    skip = {".git", "backups", "__pycache__", "reports", "vault", "secrets",
            ".vault", "ssh-cutover.json"}

    # Validate every member before creating the archive. tarfile.add() on a
    # directory recurses, which would otherwise include denied files before the
    # loop ever reaches them.
    entries = []
    for p in sorted(REPO.rglob("*")):
        rel = p.relative_to(REPO)
        if any(part in skip for part in rel.parts) or p.is_symlink():
            continue
        if not p.is_file():
            continue
        if is_denied(str(rel), pats) or is_denied(str(p.resolve()), pats):
            die(f"refusing to bundle denied file: {rel}")
        entries.append((p, rel))

    try:
        with tarfile.open(out, "w:gz") as tf:
            for p, rel in entries:
                tf.add(p, arcname=f"vps-mirror/{rel}", recursive=False)
            data = BUNDLE_README.encode()
            info = tarfile.TarInfo("vps-mirror/BUNDLE_README.txt")
            info.size = len(data)
            info.mode = 0o644
            tf.addfile(info, io.BytesIO(data))
    except BaseException:
        out.unlink(missing_ok=True)
        raise

    size = out.stat().st_size / 1024
    log(f"bundle: {out} ({size:.0f} KiB)")
    log(f"ship it: scp {out} root@new-vps:/opt/")


# ------------------------------------------------------------ remote driver
def remote_ssh_argv(target: str, port: str | int, command: str,
                    tty: bool = False) -> list[str]:
    argv = ["ssh", "-p", str(port), "-o", "StrictHostKeyChecking=ask"]
    if tty:
        argv.append("-tt")
    return [*argv, target, command]


def remote_scp_argv(target: str, port: str | int,
                    src: Path, remote_path: str) -> list[str]:
    return ["scp", "-P", str(port), str(src), f"{target}:{remote_path}"]


def op_remote_drive(args) -> int:
    """Bundle locally, ship over ssh, then run target-side drive in a TTY."""
    target = validate_ssh_target(args.target)
    port = str(args.port or 22)
    if not _valid_port(port):
        die(f"invalid ssh port: {port!r}")

    def run_with_bundle(bundle: Path) -> int:
        assert_regular_file(bundle)
        rc, out = cmd(remote_ssh_argv(
            target, port, "mktemp -d /tmp/vps-mirror-remote.XXXXXX"),
            quiet=True, check=True)
        remote_dir = out.strip()
        if not re.fullmatch(r"/tmp/vps-mirror-remote\.[A-Za-z0-9]{6}", remote_dir):
            die(f"unexpected remote temp dir: {remote_dir!r}")
        cmd(remote_scp_argv(target, port, bundle,
                            f"{remote_dir}/bundle.tar.gz"), check=True)
        script = (
            f"tar xzf {shlex.quote(remote_dir)}/bundle.tar.gz "
            f"-C {shlex.quote(remote_dir)} && "
            f"cd {shlex.quote(remote_dir)}/vps-mirror && "
            "python3 vpsclone drive --plan mirror.toml --tui"
        )
        rc, _ = cmd(remote_ssh_argv(target, port, script, tty=True),
                    capture=False, check=False)
        if not args.no_cleanup:
            cmd(remote_ssh_argv(
                target, port,
                f"rm -rf -- {shlex.quote(remote_dir)}"), quiet=True)
        return rc

    if args.bundle:
        return run_with_bundle(Path(args.bundle).expanduser().absolute())
    with tempfile.TemporaryDirectory(prefix="vps-mirror-remote-") as td:
        bundle = Path(td) / "vps-mirror.tar.gz"
        op_bundle(argparse.Namespace(output=str(bundle)))
        return run_with_bundle(bundle)


# -------------------------------------------------------------- rollback
def op_rollback(args) -> None:
    need_root()
    if not BACKUP_ROOT.exists() or BACKUP_ROOT.is_symlink():
        die("no backups found")
    dirs = sorted(p for p in BACKUP_ROOT.iterdir()
                  if p.is_dir() and not p.is_symlink())
    if not dirs:
        die("no backups found")
    names = [p.name for p in dirs]
    stamp = args.stamp or names[-1]
    if stamp not in names:
        die(f"unknown backup stamp: {stamp}")
    root = BACKUP_ROOT / stamp
    idx = root / "index.json"
    assert_regular_file(idx, root=BACKUP_ROOT)
    items = json.loads(idx.read_text())
    if not isinstance(items, list):
        die(f"invalid backup index in {idx}")

    validated = []
    for item in items:
        if not isinstance(item, dict) or "backup" not in item or "original" not in item:
            die(f"invalid backup entry in {idx}")
        src, dst = Path(item["backup"]), Path(item["original"])
        if not src.is_absolute() or not dst.is_absolute():
            die(f"backup index paths must be absolute: {item}")
        try:
            src.relative_to(BACKUP_ROOT)
        except ValueError:
            die(f"backup path outside {BACKUP_ROOT}: {src}")
        assert_regular_file(src, root=BACKUP_ROOT)
        assert_no_symlink_components(dst)
        validated.append((src, dst))

    ssh_touched = False
    for src, dst in reversed(validated):
        write_bytes_no_symlink(dst, src.read_bytes(),
                               mode=stat.S_IMODE(src.stat().st_mode))
        os.chmod(dst, stat.S_IMODE(src.stat().st_mode))
        log(f"restored {dst}")
        ssh_touched = ssh_touched or str(dst).startswith("/etc/ssh/")
    log(f"rollback from {stamp} complete")
    if ssh_touched:
        cmd(["sshd", "-t"], check=False)
        cmd(["systemctl", "reload", ssh_unit()], check=False)


# -------------------------------------------------------------- sync-data
def op_sync_data(args) -> None:
    m = load_manifest()
    d = m.get("data", {})
    paths = list(args.paths) if getattr(args, "paths", None) else list(d.get("paths", []))
    if not paths:
        log("no data paths configured in manifest.toml [data] paths = [...]")
        return
    if args.destination is None:
        die("sync-data needs --destination user@host:/path")
    for p in paths:
        src = expand(p, m["target"]["home"])
        if not src.exists():
            log(f"skip missing {src}", "WARN")
            continue
        argv = ["rsync", "-a", "--info=progress2"]
        if args.dry_run:
            argv.append("-n")
        for ex in d.get("exclude", []):
            argv += ["--exclude", ex]
        for ex in args.exclude:
            argv += ["--exclude", ex]
        operand = str(src) + ("/" if src.is_dir() else "")
        argv += ["--", operand, args.destination]
        cmd(argv, check=False)


# -------------------------------------------------------------- vault
# Secrets live here, never in the repo. The repo only knows the command names.
DEFAULT_VAULT_DIR = Path.home() / ".local/share/vps-mirror-vault"
VAULT_CONFIG_NAME = "vault.toml"
VAULT_ALIAS_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")

VAULT_CONFIG_TEMPLATE = """\
version = 1
backend = "__BACKEND__"
recipient_file = "keys/recipient.txt"
identity_file = "keys/age.txt"
passphrase_file = "keys/passphrase.txt"
archives_dir = "archives"
backups_dir = "backups"
inventory = "inventory.toml"
"""

VAULT_INVENTORY_TEMPLATE = """\
# This inventory lives OUTSIDE the git repo. Never copy it into the mirror.
# Aliases are safe labels; the paths and values below are real and stay here.
version = 1
profile = "main"

[targets."github-deploy"]
path = "~/.ssh/deploy-github"
mode = "0600"

[identities."vps-login"]
path = "~/.config/vps-mirror-vault/identity/vps-login"
value = "example-user"
mode = "0600"
"""

VAULT_README = """\
# vps-mirror vault

This directory is intentionally **outside** the git repo and outside
`vpsclone bundle`. Nothing in here should ever be committed or transferred via
the mirror.

- `inventory.toml` contains real paths and identity values. Keep it here only.
- `keys/` contains key material (age identity or GPG passphrase). Keep it here
  only, mode 0600.
- `archives/` contains encrypted tarballs only. Safest to copy these to offline
  media or a separate private store.
- `bin/pack.sh` and `bin/unpack.sh` are thin wrappers with no embedded secrets.

Typical flow:

    # 1. edit inventory.toml to point at your real files / identity values
    # 2. pack (prints aliases only, never contents)
    ./bin/pack.sh --dry-run
    ./bin/pack.sh

    # 3. restore on the target (copies real paths from THIS inventory)
    ./bin/unpack.sh --dry-run
    ./bin/unpack.sh --yes

Other commands:

    vpsclone vault-list   --vault-dir __VAULT__
    vpsclone vault-verify --vault-dir __VAULT__

Restore never follows symlinks, validates archive members, backs up anything it
would overwrite into `backups/`, and asks for confirmation unless `--yes` is
given. Encryption uses `age` when available, otherwise GPG symmetric.
"""


def vault_dir_arg(args) -> Path:
    raw = getattr(args, "vault_dir", None) or DEFAULT_VAULT_DIR
    return Path(raw).expanduser().absolute()


def vault_path(vdir: Path, value: str) -> Path:
    p = Path(value).expanduser()
    return p if p.is_absolute() else vdir / p


def vault_expand(value: str) -> Path:
    p = expand(value, str(Path.home()))
    if not p.is_absolute():
        die(f"vault inventory paths must be absolute or start with ~/: {value}")
    return p


def vault_load_config(vdir: Path) -> dict:
    p = vdir / VAULT_CONFIG_NAME
    if not p.is_file():
        die(f"no vault at {vdir} - run `vpsclone vault-scaffold --dir ...`")
    assert_no_symlink_components(vdir)
    assert_regular_file(p, root=vdir)
    with p.open("rb") as f:
        cfg = tomllib.load(f)
    if cfg.get("version") != 1:
        die("unsupported vault config version")
    if cfg.get("backend") not in ("age", "gpg"):
        die("vault config backend must be 'age' or 'gpg'")
    return cfg


def vault_backend(cfg: dict, vdir: Path):
    """Return (backend, extension, encrypt-template, decrypt-template)."""
    backend = cfg["backend"]
    if backend == "age":
        if not shutil.which("age") or not shutil.which("age-keygen"):
            die("age backend needs both `age` and `age-keygen` installed")
        recipient = vault_path(vdir, cfg.get("recipient_file", "keys/recipient.txt"))
        identity = vault_path(vdir, cfg.get("identity_file", "keys/age.txt"))
        assert_regular_file(recipient, root=vdir)
        assert_regular_file(identity, root=vdir)
        enc = ["age", "-R", str(recipient), "-o", "__OUT__", "__IN__"]
        dec = ["age", "-d", "-i", str(identity), "-o", "__OUT__", "__IN__"]
        return backend, "age", enc, dec

    if not shutil.which("gpg"):
        die("gpg backend needs `gpg` installed")
    passfile = vault_path(vdir, cfg.get("passphrase_file", "keys/passphrase.txt"))
    assert_regular_file(passfile, root=vdir)
    base = ["gpg", "--batch", "--yes", "--pinentry-mode", "loopback",
            "--passphrase-file", str(passfile)]
    enc = base + ["-o", "__OUT__", "-c", "__IN__"]
    dec = base + ["-o", "__OUT__", "-d", "__IN__"]
    return backend, "gpg", enc, dec


def vault_run(template: list[str], src: Path, dst: Path) -> None:
    argv = [str(dst) if a == "__OUT__" else str(src) if a == "__IN__" else a
            for a in template]
    cmd(argv, check=True, quiet=True)


def vault_inventory(vdir: Path, cfg: dict, profile: str | None = None):
    p = vault_path(vdir, cfg.get("inventory", "inventory.toml"))
    assert_no_symlink_components(vdir)
    assert_regular_file(p, root=vdir)
    with p.open("rb") as f:
        inv = tomllib.load(f)
    if inv.get("version") != 1:
        die("unsupported vault inventory version")
    prof = profile or inv.get("profile")
    if not isinstance(prof, str) or not prof.strip():
        die("vault inventory needs a profile")
    items = []
    seen = set()
    for kind, table in (("target", inv.get("targets", {})),
                        ("identity", inv.get("identities", {}))):
        if not isinstance(table, dict):
            die(f"vault inventory [{kind}s] must be a table")
        for alias, spec in table.items():
            if not isinstance(alias, str) or not VAULT_ALIAS_RE.match(alias):
                die(f"invalid vault alias: {alias}")
            key = (kind, alias)
            if key in seen:
                die(f"duplicate vault alias: {kind}/{alias}")
            seen.add(key)
            if not isinstance(spec, dict):
                die(f"vault item {alias} must be a table")
            raw_path = spec.get("path")
            if not isinstance(raw_path, str) or not raw_path.strip():
                die(f"vault item {alias} needs a path")
            mode_raw = str(spec.get("mode", "0600"))
            try:
                mode = int(mode_raw, 8)
            except ValueError:
                die(f"vault item {alias} has invalid mode: {mode_raw}")
            if not 0 <= mode <= 0o777:
                die(f"vault item {alias} mode out of range: {mode_raw}")
            value = spec.get("value")
            if value is not None and not isinstance(value, str):
                die(f"vault identity {alias} value must be a string")
            if kind == "identity" and value is None:
                die(f"vault identity {alias} needs a value")
            items.append({"kind": kind, "alias": alias, "path": vault_expand(raw_path),
                          "mode": mode, "value": value})
    if not items:
        die("vault inventory has no items")
    return prof, items


def vault_member(kind: str, alias: str) -> str:
    return f"{'targets' if kind == 'target' else 'identities'}/{alias}"


def vault_add(tf: tarfile.TarFile, name: str, data: bytes, mode: int) -> None:
    ti = tarfile.TarInfo(name)
    ti.size = len(data)
    ti.mode = mode
    ti.mtime = int(dt.datetime.now().timestamp())
    ti.uid = ti.gid = 0
    tf.addfile(ti, io.BytesIO(data))


def vault_archive(vdir: Path, cfg: dict, explicit: str | None = None) -> Path:
    if explicit:
        p = Path(explicit).expanduser().absolute()
        assert_regular_file(p)
        return p
    d = vault_path(vdir, cfg.get("archives_dir", "archives"))
    assert_no_symlink_components(d, root=vdir)
    candidates = []
    for pat in ("secrets-*.age", "secrets-*.gpg"):
        candidates += [p for p in d.glob(pat) if p.is_file() and not p.is_symlink()]
    if not candidates:
        die(f"no vault archives in {d}")
    return max(candidates, key=lambda p: p.stat().st_mtime)


def vault_read_archive(vdir: Path, cfg: dict, archive: Path):
    """Decrypt and validate; returns (meta, {member-name: bytes}). Never extracts."""
    _, _, _, dec = vault_backend(cfg, vdir)
    assert_regular_file(archive)
    with tempfile.TemporaryDirectory(prefix="vault-read-", dir=vdir) as td:
        tar_path = Path(td) / "secrets.tar.gz"
        vault_run(dec, archive, tar_path)
        meta = None
        blobs = {}
        total = 0
        with tarfile.open(tar_path, "r:gz") as tf:
            members = tf.getmembers()
            expected = set()
            for m in members:
                if not m.isfile() or m.name.startswith("/") or ".." in Path(m.name).parts:
                    die("vault archive contains an unsafe member")
                if m.name == "meta.json":
                    continue
                kind, sep, alias = m.name.partition("/")
                if sep != "/" or kind not in ("targets", "identities"):
                    die(f"vault archive has unknown member: {m.name}")
                if not VAULT_ALIAS_RE.match(alias) or "/" in alias:
                    die(f"vault archive has invalid alias: {alias}")
                if m.size > 100 * 1024 * 1024:
                    die("vault archive member is too large")
                total += m.size
                if total > 500 * 1024 * 1024:
                    die("vault archive is too large")
                expected.add(m.name)
            mf = tf.extractfile("meta.json")
            if mf is None:
                die("vault archive is missing meta.json")
            meta = json.loads(mf.read().decode())
            if meta.get("version") != 1 or not isinstance(meta.get("items"), list):
                die("vault archive metadata is invalid")
            listed = set()
            for ent in meta["items"]:
                kind = ent.get("kind")
                alias = ent.get("alias")
                if kind not in ("target", "identity") or not isinstance(alias, str):
                    die("vault archive metadata has an invalid item")
                if not VAULT_ALIAS_RE.match(alias):
                    die("vault archive metadata has an invalid alias")
                listed.add(vault_member(kind, alias))
            if listed != expected:
                die("vault archive metadata does not match its members")
            for m in members:
                if m.name == "meta.json":
                    continue
                f = tf.extractfile(m)
                blobs[m.name] = f.read() if f else b""
        return meta, blobs


def add_git_excludes() -> None:
    """Local-only guard: keep vault artifacts out of git even if moved inside."""
    gitdir = REPO / ".git"
    if not gitdir.exists():
        return
    info = gitdir / "info"
    info.mkdir(parents=True, exist_ok=True)
    p = info / "exclude"
    lines = p.read_text(errors="replace").splitlines() if p.exists() else []
    additions = [x for x in ("/vault/", "/secrets/", "/.vault/",
                             "*.age", "*.gpg") if x not in lines]
    if additions:
        with p.open("a") as f:
            f.write("\n# vps-mirror vault (local guard)\n")
            f.write("\n".join(additions) + "\n")


def op_vault_scaffold(args) -> None:
    vdir = Path(args.dir).expanduser().absolute()
    cfgp = vdir / VAULT_CONFIG_NAME
    if cfgp.exists() and not args.force:
        die(f"vault already exists at {vdir} (use --force to refresh generated files)")
    try:
        vdir.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as e:
        die(f"cannot create vault dir {vdir}: {e}")
    os.chmod(vdir, 0o700)
    assert_no_symlink_components(vdir)
    for name in ("keys", "archives", "backups", "bin"):
        p = vdir / name
        p.mkdir(exist_ok=True, mode=0o700)
        os.chmod(p, 0o700)
        assert_no_symlink_components(p, root=vdir)

    backend = args.backend
    if backend == "auto":
        backend = ("age" if shutil.which("age") and shutil.which("age-keygen")
                   else "gpg")

    if backend == "age":
        if not shutil.which("age") or not shutil.which("age-keygen"):
            die("age backend needs both `age` and `age-keygen` installed")
        ident = vdir / "keys/age.txt"
        recip = vdir / "keys/recipient.txt"
        if ident.exists():
            if not args.force:
                die(f"age identity already exists: {ident}")
            assert_regular_file(ident, root=vdir)
            ident.unlink()
        rc, out = cmd(["age-keygen", "-o", str(ident)], check=True, quiet=True)
        m = re.search(r"age1[0-9a-z]+", out)
        if not m:
            die("could not parse age public key from age-keygen output")
        atomic_write_text(recip, m.group(0) + "\n", mode=0o644)
        os.chmod(ident, 0o600)
    else:
        if not shutil.which("gpg"):
            die("gpg backend needs `gpg` installed")
        passfile = vdir / "keys/passphrase.txt"
        if passfile.exists():
            if not args.force:
                die(f"gpg passphrase file already exists: {passfile}")
            assert_regular_file(passfile, root=vdir)
            passfile.unlink()
        atomic_write_text(passfile, secrets.token_urlsafe(32) + "\n", mode=0o600)

    atomic_write_text(cfgp, VAULT_CONFIG_TEMPLATE.replace("__BACKEND__", backend),
                      mode=0o600)
    invp = vdir / "inventory.toml"
    if not invp.exists() or args.force:
        atomic_write_text(invp, VAULT_INVENTORY_TEMPLATE, mode=0o600)

    vpsclone = shlex.quote(str(Path(__file__).resolve()))
    for filename, subcommand in (("pack.sh", "vault-pack"),
                                 ("unpack.sh", "vault-unpack")):
        body = (
            "#!/bin/sh\n"
            "set -eu\n"
            'VAULT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)\n'
            f'exec {vpsclone} {subcommand} --vault-dir "$VAULT_DIR" "$@"\n'
        )
        atomic_write_text(vdir / "bin" / filename, body, mode=0o755)

    atomic_write_text(vdir / "README.md",
                      VAULT_README.replace("__VAULT__", str(vdir)), mode=0o644)
    add_git_excludes()
    log(f"vault: scaffolded {vdir} (backend: {backend})")
    log("vault: edit inventory.toml, then run bin/pack.sh")


def op_vault_pack(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    _, ext, enc, _ = vault_backend(cfg, vdir)
    prof, items = vault_inventory(vdir, cfg, args.profile)

    if args.dry_run:
        for i in items:
            log(f"vault: would pack {i['kind']}:{i['alias']}")
        log(f"vault: dry-run complete ({len(items)} items)")
        return

    payload = []
    for i in items:
        if i["kind"] == "target":
            src = i["path"]
            assert_regular_file(src)
            data = src.read_bytes()
        else:
            data = i["value"].encode()
        payload.append((i, data))

    archives = vault_path(vdir, cfg.get("archives_dir", "archives"))
    archives.mkdir(parents=True, exist_ok=True, mode=0o700)
    assert_no_symlink_components(archives, root=vdir)
    stamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    out = (Path(args.output).expanduser().absolute() if args.output
           else archives / f"secrets-{prof}-{stamp}.{ext}")
    if out.exists():
        die(f"refusing to overwrite existing archive: {out}")
    if args.output:
        assert_no_symlink_components(out)
    else:
        assert_no_symlink_components(out, root=vdir)

    with tempfile.TemporaryDirectory(prefix="vault-pack-", dir=archives) as td:
        tar_path = Path(td) / "secrets.tar.gz"
        meta = {
            "version": 1,
            "profile": prof,
            "created": now(),
            "items": [{"kind": i["kind"], "alias": i["alias"],
                       "mode": oct(i["mode"])} for i, _ in payload],
        }
        with tarfile.open(tar_path, "w:gz") as tf:
            vault_add(tf, "meta.json", json.dumps(meta).encode(), 0o600)
            for i, data in payload:
                vault_add(tf, vault_member(i["kind"], i["alias"]), data, i["mode"])
        vault_run(enc, tar_path, out)
    os.chmod(out, 0o600)
    log(f"vault: wrote {out} ({len(payload)} items)")


def op_vault_unpack(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    archive = vault_archive(vdir, cfg, args.archive)
    prof, items = vault_inventory(vdir, cfg, args.profile)
    meta, blobs = vault_read_archive(vdir, cfg, archive)
    if meta.get("profile") != prof:
        die(f"archive profile {meta.get('profile')!r} != inventory profile {prof!r}")

    item_map = {(i["kind"], i["alias"]): i for i in items}
    restore = []
    for ent in meta["items"]:
        kind, alias = ent.get("kind"), ent.get("alias")
        if kind not in ("target", "identity") or not isinstance(alias, str):
            die("vault archive metadata has an invalid item")
        key = (kind, alias)
        if key not in item_map:
            die(f"archive item {alias} is missing from this vault inventory")
        member = vault_member(kind, alias)
        if member not in blobs:
            die(f"archive member missing: {member}")
        restore.append((item_map[key], blobs[member]))
    if not restore:
        die("vault archive has no items")

    if args.dry_run:
        for i, _ in restore:
            log(f"vault: would restore {i['kind']}:{i['alias']}")
        log(f"vault: dry-run complete ({len(restore)} items)")
        return

    if not args.yes:
        try:
            answer = input(f"Restore {len(restore)} vault item(s) from "
                           f"{archive.name}? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            die("aborted")

    backups = vault_path(vdir, cfg.get("backups_dir", "backups"))
    stamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    for i, data in restore:
        dst = i["path"]
        if dst.exists() or dst.is_symlink():
            bdir = backups / stamp
            bdir.mkdir(parents=True, exist_ok=True, mode=0o700)
            bp = bdir / f"{i['kind']}-{i['alias']}"
            assert_no_symlink_components(bp, root=vdir)
            st = dst.lstat()
            if st and stat.S_ISREG(st.st_mode):
                write_bytes_no_symlink(bp, dst.read_bytes(),
                                       mode=stat.S_IMODE(st.st_mode))
        write_bytes_no_symlink(dst, data, mode=i["mode"])
        os.chmod(dst, i["mode"])
        log(f"vault: restored {i['kind']}:{i['alias']}")
    log(f"vault: restore complete ({len(restore)} items)")


def op_vault_list(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    prof, items = vault_inventory(vdir, cfg, args.profile)
    print(f"VAULT {vdir}")
    print(f"  profile: {prof}")
    for i in items:
        present = (i["kind"] == "identity" or
                   (i["path"].is_file() and not i["path"].is_symlink()))
        print(f"  [{'ok' if present else 'MISSING':<7}] "
              f"{i['kind']:<8} {i['alias']:<24} {oct(i['mode'])}")


def op_vault_verify(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    archive = vault_archive(vdir, cfg, args.archive)
    meta, blobs = vault_read_archive(vdir, cfg, archive)
    print(f"VAULT ARCHIVE {archive.name}")
    print(f"  profile: {meta.get('profile')}")
    print(f"  items:   {len(meta['items'])}")
    print(f"  payload: {len(blobs) - 1 if 'meta.json' in blobs else len(blobs)} file(s)")
    log("vault: archive verified")


# -------------------------------------------------------------- doctor
def op_doctor(args) -> int:
    rows = [
        ("root", is_root(), "needed for apply"),
        ("python3 >= 3.11", sys.version_info >= (3, 11), sys.version.split()[0]),
        ("apt / dpkg", shutil.which("apt-get") is not None, ""),
        ("git", shutil.which("git") is not None, ""),
        ("rsync", shutil.which("rsync") is not None, ""),
        ("openssh-server", Path("/etc/ssh/sshd_config").exists(), ""),
        ("manifest present", MANIFEST.exists(), str(MANIFEST)),
    ]
    print("\nDOCTOR\n")
    bad = 0
    for name, ok, detail in rows:
        if not ok:
            bad += 1
        print(f"  [{'PASS' if ok else 'FAIL'}] {name:<20} {detail}")
    _, disk = cmd(["df", "-h", "/"], quiet=True)
    print("\n" + disk.strip() + "\n")
    if bad:
        log(f"doctor: {bad} problem(s)", "ERROR")
        return 1
    log("doctor: ready")
    return 0


# -------------------------------------------------------------- CLI
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="vpsclone", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    c = sub.add_parser("capture", help="read current machine into the manifest")
    c.add_argument("--user", help="target login user (default: SUDO_USER or current)")
    c.add_argument("--name", help="baseline name")
    c.add_argument("--users",
                   help="comma-separated additional users to capture (explicit allowlist)")
    c.add_argument("--clear-users", action="store_true",
                   help="drop existing [[users]] entries from the manifest")
    c.set_defaults(func=op_capture)

    c = sub.add_parser("audit", help="local audit -> mirror.toml + generated manifest")
    c.add_argument("--user", help="target login user (default: SUDO_USER or current)")
    c.add_argument("--name", help="baseline name")
    c.add_argument("--users", help="comma-separated additional users to capture")
    c.add_argument("--clear-users", action="store_true",
                   help="drop existing [[users]] entries from the manifest")
    c.add_argument("--out", default="mirror.toml", help="descriptor output path")
    c.set_defaults(func=op_audit)

    c = sub.add_parser("drive", help="resolve mirror.toml prompts, apply on target")
    c.add_argument("--plan", default="mirror.toml", help="mirror descriptor")
    c.add_argument("--apply", action="store_true",
                   help="run apply after materialising manifest")
    c.add_argument("--dry-run", action="store_true", help="pass --dry-run to apply")
    c.add_argument("--only", help="comma-separated steps when --apply is used")
    c.add_argument("--no-verify", action="store_true", help="skip post-apply verify")
    c.add_argument("--tui", action="store_true",
                   help="launch the curses task driver after resolving prompts")
    c.set_defaults(func=op_drive)

    c = sub.add_parser("plan", help="show desired vs current")
    c.set_defaults(func=op_plan)

    c = sub.add_parser("apply", help="replay manifest on a fresh box")
    c.add_argument("--dry-run", action="store_true")
    c.add_argument("--only", help="comma-separated steps: " + ",".join(STEP_ORDER))
    c.add_argument("--hostname", help="override target hostname")
    c.add_argument("--ssh-port", type=int, help="override ssh port")
    c.add_argument("--no-verify", action="store_true")
    c.set_defaults(func=op_apply)

    c = sub.add_parser("verify", help="post-apply health checks")
    c.set_defaults(func=op_verify)

    c = sub.add_parser("ssh-cutover-prepare",
                       help="stage dual-port sshd config; keep old port live")
    c.add_argument("--rollback-seconds", type=int, default=600)
    c.set_defaults(func=op_ssh_cutover_prepare)

    c = sub.add_parser("ssh-cutover-commit",
                       help="finalise ssh port after a fresh-login check")
    c.add_argument("--confirm-login", action="store_true")
    c.set_defaults(func=op_ssh_cutover_commit)

    c = sub.add_parser("ssh-cutover-rollback",
                       help="restore pre-cutover sshd config")
    c.set_defaults(func=op_ssh_cutover_rollback)

    c = sub.add_parser("ssh-cutover-watchdog",
                       help=argparse.SUPPRESS)
    c.add_argument("--seconds", type=int, required=True)
    c.add_argument("--id", required=True)
    c.set_defaults(func=op_ssh_cutover_watchdog)

    c = sub.add_parser("keygen", help="generate passphrase-protected ssh key")
    c.add_argument("--name", help="key filename (default: deploy-github)")
    c.add_argument("--comment", help="key comment")
    c.add_argument("--target", help="user@host to scp the key to")
    c.add_argument("--force", action="store_true")
    c.add_argument("--no-save-pub", dest="save_pub", action="store_false")
    c.set_defaults(save_pub=True, func=op_keygen)

    c = sub.add_parser("bundle", help="make a self-contained tar.gz")
    c.add_argument("--output", help="output path")
    c.set_defaults(func=op_bundle)

    c = sub.add_parser("remote-drive",
                       help="bundle, scp and run drive on a fresh VPS")
    c.add_argument("--target", required=True, help="user@host")
    c.add_argument("--port", type=int, default=22, help="transport ssh port")
    c.add_argument("--bundle", help="reuse an existing bundle tar.gz")
    c.add_argument("--no-cleanup", action="store_true")
    c.set_defaults(func=op_remote_drive)

    c = sub.add_parser("sync-data", help="rsync explicit data allowlist")
    c.add_argument("--destination", help="user@host:/path")
    c.add_argument("--path", dest="paths", action="append", default=[],
                   help="absolute source path (repeatable; overrides manifest)")
    c.add_argument("--exclude", action="append", default=[])
    c.add_argument("--dry-run", action="store_true")
    c.set_defaults(func=op_sync_data)

    c = sub.add_parser("rollback", help="restore files from a prior apply")
    c.add_argument("--stamp", help="backup stamp (default: latest)")
    c.set_defaults(func=op_rollback)

    c = sub.add_parser("vault-scaffold", help="create an out-of-git secrets vault")
    c.add_argument("--dir", default=str(DEFAULT_VAULT_DIR), help="vault directory")
    c.add_argument("--backend", choices=("auto", "age", "gpg"), default="auto")
    c.add_argument("--force", action="store_true",
                   help="refresh generated files (never deletes archives/keys)")
    c.set_defaults(func=op_vault_scaffold)

    c = sub.add_parser("vault-pack", help="encrypt secrets into an archive")
    c.add_argument("--vault-dir", default=str(DEFAULT_VAULT_DIR))
    c.add_argument("--profile", help="inventory profile (default: inventory's)")
    c.add_argument("--output", help="archive path (default: vault archives/)")
    c.add_argument("--dry-run", action="store_true")
    c.set_defaults(func=op_vault_pack)

    c = sub.add_parser("vault-unpack", help="restore secrets from an archive")
    c.add_argument("--vault-dir", default=str(DEFAULT_VAULT_DIR))
    c.add_argument("--archive", help="archive path (default: latest in vault)")
    c.add_argument("--profile", help="inventory profile (default: inventory's)")
    c.add_argument("--dry-run", action="store_true")
    c.add_argument("--yes", action="store_true", help="skip confirmation prompt")
    c.set_defaults(func=op_vault_unpack)

    c = sub.add_parser("vault-list", help="list vault aliases (no values/paths)")
    c.add_argument("--vault-dir", default=str(DEFAULT_VAULT_DIR))
    c.add_argument("--profile", help="inventory profile")
    c.set_defaults(func=op_vault_list)

    c = sub.add_parser("vault-verify", help="verify an encrypted vault archive")
    c.add_argument("--vault-dir", default=str(DEFAULT_VAULT_DIR))
    c.add_argument("--archive", help="archive path (default: latest in vault)")
    c.set_defaults(func=op_vault_verify)

    c = sub.add_parser("doctor", help="preflight a fresh target")
    c.set_defaults(func=op_doctor)
    return p


def main() -> None:
    args = build_parser().parse_args()
    rc = args.func(args)
    if isinstance(rc, int):
        raise SystemExit(rc)


if __name__ == "__main__":
    main()
