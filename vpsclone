def _find_secret_paths(value, path: str = "manifest") -> list[str]:
    hits: list[str] = []
    if isinstance(value, dict):
        for k, v in value.items():
            hits += _find_secret_paths(v, f"{path}.{k}")
    elif isinstance(value, (list, tuple)):
        for i, v in enumerate(value):
            hits += _find_secret_paths(v, f"{path}[{i}]")
    elif isinstance(value, str):
        if _secret_hits(value):
            hits.append(path)
    return hits


def _persist_session(m: dict) -> tuple[bool, str]:
    """Opt-in save of effective values to the generated manifest only."""
    hits = _find_secret_paths(m)
    if hits:
        return False, ("refused: secret-like values at "
                       + ", ".join(hits[:5])
                       + "; keep this session in memory only")
    atomic_write_text(MANIFEST, toml_dump(m), mode=0o600)
    return True, "wrote manifest.toml (mode 0600); do not re-bundle from target"


def op_audit(args) -> None:
    """Local pass: author mirror.toml and a ready-to-ship generated manifest."""
    data, copied, skipped, inv_meta = collect_baseline(args)
    baseline_text = toml_dump(data)
    source_port = str(data["ssh"]["port"])

    dot_hashes = {}
    for target, rel in data.get("dotfiles", {}).items():
        p = VPS_DATA / rel
        if p.is_file() and not p.is_symlink():
            dot_hashes[target] = sha256_file(p)

    hardening = VPS_DATA / data["ssh"]["hardening_file"]
    gaps = [f"inventory: {w}" for w in inv_meta.get("warnings", [])]
    # A permission skip produces a baseline that silently omits a file; make
    # that as loud as the other deferred/manual work.
    gaps += [f"capture: {path}: {why}" for path, why in skipped
             if why.startswith("permission denied")]
    for b in data.get("binaries", []):
        if not str(b.get("install", "")).strip():
            gaps.append(f"binary {b['name']}: no install command "
                        "(drive will prompt on target or skip)")
    for r in data.get("repos", []):
        url = str(r.get("url", ""))
        if "OWNER" in url or "REPO" in url:
            gaps.append(f"repo {r['path']}: placeholder URL {url} "
                        "(drive will prompt on target)")
    if not data.get("data", {}).get("paths"):
        gaps.append("no [data].paths configured - sync-data would do nothing")
    if not data.get("system_files"):
        gaps.append("no system files captured (fail2ban jail.local missing?)")
    if source_port == "22":
        gaps.append("source SSH uses default port 22 - drive will prompt for "
                    "the target port instead of hardcoding one")

    decisions = [
        "target hostname (source hostname is rarely wanted on a new box)",
        "target SSH port when source uses the default 22",
        "firewall ports (editable list), SSH port is always added",
        "extra users list (editable)",
        "missing [[binaries]].install commands",
        "placeholder repository URLs",
    ]

    mirror = {
        "schema": 1,
        "name": getattr(args, "name", None) or "vps-baseline",
        "generated_at": now(),
        "source": {
            "host": data["meta"]["source_host"],
            "os": data["meta"]["source_os"],
            "user": data["target"]["user"],
            "ssh_port": int(source_port) if source_port.isdigit() else source_port,
            "ufw_allow": list(data["firewall"].get("allow", [])),
            "extra_users": [u["name"] for u in data.get("users", [])],
            "apt_manual_count": len(data["packages"].get("apt", [])),
            "apt_manual_raw_count": inv_meta.get("counts", {}).get("apt_manual_raw", 0),
        },
        "integrity": {
            "baseline_sha256": sha256_bytes(baseline_text.encode()),
            "dotfiles_sha256": dot_hashes,
            "hardening_sha256": sha256_file(hardening) if hardening.is_file() else "",
        },
        "desired": {
            "target": {
                "user": {"from": "source.user"},
                "hostname": {
                    "from": "source.host", "prompt": True,
                    "message": "Hostname for the new box",
                },
                "ssh_port": {
                    "from": "source.ssh_port", "prompt_if_default": True,
                    "default": source_port,
                    "message": "SSH port for the new box",
                },
            },
            "firewall": {
                "ports": {
                    "from": "source.ufw_allow", "prompt": True,
                    "allow_edit": True, "default_incoming": "deny",
                    "message": "Firewall ports (comma-separated)",
                },
            },
            "users": {
                "extra": {
                    "from": "source.extra_users", "prompt": True,
                    "allow_edit": True, "message": "Extra users (comma-separated)",
                },
            },
            "binaries": {"prompt_if_install_empty": True},
            "repos": {"prompt_if_placeholder": True},
        },
        "order": {"tasks": list(TASK_LADDER)},
        "tasks": default_task_defs(),
        "actions": default_action_defs() + binary_install_actions(data),
        "audit": {
            "captured_files": len(copied),
            "skipped_files": len(skipped),
            "gaps": gaps,
            "deferred_decisions": decisions,
            "inventory": inv_meta,
        },
        "baseline": data,
    }

    out = Path(args.out).expanduser().absolute()
    local_owner = _local_owner(data)
    atomic_write_text(out, toml_dump(mirror), owner=local_owner)
    atomic_write_text(MANIFEST, baseline_text, owner=local_owner)

    REPORTS.mkdir(exist_ok=True)
    lines = [
        "AUDIT / mirror.toml",
        f"generated: {now()}",
        f"source:    {data['meta']['source_os']} / {data['meta']['source_host']}",
        f"user:      {data['target']['user']}  ssh port: {source_port}",
        f"captured:  {len(copied)} file(s), {len(skipped)} skipped",
        f"descriptor: {out}",
        f"manifest:   {MANIFEST} (generated from baseline)",
        f"inventory:  {inv_meta.get('method', 'unknown')}",
        *[f"  i {n}" for n in inv_meta.get("notes", [])],
        "",
        "Deferred decisions (declared as prompts, answered on target):",
        *[f"  ? {d}" for d in decisions],
        "",
        "Gaps / manual work:",
        *([] if gaps else ["  (none)"]),
        *[f"  ! {g}" for g in gaps],
        "",
        "Skipped files (denylist / noise / unreadable):",
        *([f"  - {path}  [{why}]" for path, why in skipped] or ["  (none)"]),
        "",
        "Next: review mirror.toml outside Git, git diff for code, then bundle;",
        f"on the target run: sudo vpsclone drive --plan {out}",
    ]
    atomic_write_text(REPORTS / "audit-report.txt", "\n".join(lines) + "\n",
                      owner=local_owner)
    _normalize_data_owner(data["target"]["user"])
    log(f"wrote {out}")
    log(f"wrote {MANIFEST} (generated)")
    log(f"wrote {REPORTS / 'audit-report.txt'}")
    log(f"audit: {len(gaps)} gap(s), {len(decisions)} deferred decision(s)")
    log(f"next: review {out}, then `vpsclone bundle`")


def _ask(value: str, message: str | None, label: str) -> str:
    prompt = message or label
    if value:
        prompt += f" [{value}]"
    prompt += ": "
    try:
        raw = input(prompt).strip()
    except EOFError:
        raw = ""
    return raw or value


def op_drive(args) -> int | None:
    """Target pass: resolve declared prompts, materialise manifest, optionally apply."""
    plan_path = Path(args.plan).expanduser().absolute()
    assert_regular_file(plan_path)
    with plan_path.open("rb") as f:
        plan = tomllib.load(f)
    if plan.get("schema") != 1:
        die(f"unsupported mirror schema: {plan.get('schema')!r}")
    baseline = plan.get("baseline")
    if not isinstance(baseline, dict):
        die(f"{plan_path} has no [baseline] table - regenerate with `audit`")

    integ = plan.get("integrity", {})
    expected = integ.get("baseline_sha256")
    if expected and sha256_bytes(toml_dump(baseline).encode()) != expected:
        die("baseline hash mismatch - mirror.toml was edited or is stale; "
            "regenerate with `audit`")
    for target, rel in baseline.get("dotfiles", {}).items():
        want = integ.get("dotfiles_sha256", {}).get(target)
        p = VPS_DATA / rel
        if want and (not p.is_file() or p.is_symlink() or sha256_file(p) != want):
            die(f"captured file changed since audit: {rel} ({target})")

    m = copy.deepcopy(baseline)
    src = plan.get("source", {})
    desired = plan.get("desired", {})
    target_spec = desired.get("target", {})

    hs = target_spec.get("hostname", {})
    if hs.get("prompt"):
        m["target"]["hostname"] = _ask(str(src.get("host", "")),
                                       hs.get("message"), "hostname")

    ps = target_spec.get("ssh_port", {})
    src_port = str(src.get("ssh_port", m["ssh"].get("port", "22")))
    m["ssh"]["old_port"] = src_port
    if ps.get("prompt") or (ps.get("prompt_if_default") and src_port == "22"):
        while True:
            answer = _ask(str(ps.get("default", src_port)),
                          ps.get("message"), "ssh port")
            if answer.isdigit() and 1 <= int(answer) <= 65535:
                break
            print("  enter a port between 1 and 65535")
        m["ssh"]["port"] = answer
        log(f"drive: source port 22 is default; using target port {m['ssh']['port']}")
    else:
        m["ssh"]["port"] = src_port

    fs = desired.get("firewall", {}).get("ports", {})
    if fs.get("prompt"):
        current = list(src.get("ufw_allow", m.get("firewall", {}).get("allow", [])))
        raw = _ask(", ".join(current), fs.get("message"), "firewall ports")
        m.setdefault("firewall", {})["allow"] = [
            x.strip() for x in raw.split(",") if x.strip()
        ]
    ssh_rule = f"{m['ssh']['port']}/tcp"
    allow = m.setdefault("firewall", {}).setdefault("allow", [])
    if ssh_rule not in allow:
        allow.insert(0, ssh_rule)

    us = desired.get("users", {}).get("extra", {})
    if us.get("prompt"):
        current = [u["name"] for u in m.get("users", [])]
        raw = _ask(", ".join(current), us.get("message"), "extra users")
        names = [x.strip() for x in raw.split(",") if x.strip()]
        existing = {u["name"]: u for u in m.get("users", [])}
        rebuilt = []
        for name in names:
            if name in existing:
                rebuilt.append(existing[name])
            else:
                rebuilt.append({
                    "name": name, "home": f"/home/{name}", "shell": "/bin/bash",
                    "group": name, "groups": [], "sudo_group": "",
                    "ssh_allow": True, "create_home": True,
                    "authorized_keys": "", "authorized_keys_inline": "",
                })
        m["users"] = rebuilt

    # With --tui these become first-class actions in the Actions pane.
    if (desired.get("binaries", {}).get("prompt_if_install_empty")
            and not getattr(args, "tui", False)):
        for b in m.get("binaries", []):
            if not str(b.get("install", "")).strip():
                install = _ask("", f"Install command for {b['name']} "
                                   "(blank = skip, keep warning)", "install")
                if install:
                    b["install"] = install

    if desired.get("repos", {}).get("prompt_if_placeholder"):
        for r in m.get("repos", []):
            url = str(r.get("url", ""))
            if "OWNER" in url or "REPO" in url:
                new = _ask(url, f"Real clone URL for {r['path']}", "repo URL")
                if new and new != url:
                    r["url"] = new

    atomic_write_text(MANIFEST, toml_dump(m))
    log(f"drive: wrote effective {MANIFEST}")
    log(f"drive: target={m['target']['user']}@{m['target']['hostname']} "
        f"ssh={m['ssh']['port']} firewall={','.join(allow)}")
    log("drive: next on target -> `vpsclone plan` then "
        "`sudo vpsclone apply --dry-run`")

    if args.apply:
        ns = argparse.Namespace(
            dry_run=args.dry_run, only=args.only, hostname=None, ssh_port=None,
            no_verify=args.no_verify, func=op_apply,
        )
        return op_apply(ns)
    if args.tui:
        # Target-added users are only known after the prompt above; expose their
        # key entry as actions without ever writing back to mirror.toml.
        plan.setdefault("actions", []).extend(user_key_actions(m))
        return run_tui(plan, m)
    return 0


# ---------------------------------------------------------------- tui driver
_TUI_CURSES = None


def _tui_put(stdscr, y, x, text, attr=0) -> None:
    h, w = stdscr.getmaxyx()
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    s = str(text)[:w - x]
    if not s:
        return
    try:
        stdscr.addnstr(y, x, s, len(s), attr)
    except Exception:
        pass


def _tui_modal(stdscr, title: str, lines: list[str], *,
               footer: str | None = None, allow_no: bool = False) -> None:
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    width = min(w - 4, 76)
    height = min(h - 4, len(lines) + 5)
    x0, y0 = max(0, (w - width) // 2), max(0, (h - height) // 2)
    try:
        stdscr.attron(_TUI_CURSES.A_BOLD)
        _tui_put(stdscr, y0, x0 + 2, title[:width - 4])
        stdscr.attroff(_TUI_CURSES.A_BOLD)
    except Exception:
        pass
    for i in range(height):
        _tui_put(stdscr, y0 + 1 + i, x0, " " * width)
    for i, line in enumerate(lines[:height - 4]):
        _tui_put(stdscr, y0 + 2 + i, x0 + 2, line)
    _tui_put(stdscr, y0 + height - 2, x0 + 2,
             footer or "Enter=continue   r=retry   s=skip   q=quit")
    stdscr.refresh()
    while True:
        ch = stdscr.getch()
        if ch in (10, 13, getattr(_TUI_CURSES, "KEY_ENTER", -1)):
            return "enter"
        if allow_no and ch in (ord("n"), ord("N")):
            return "no"
        if ch in (ord("r"), ord("R")):
            return "retry"
        if ch in (ord("s"), ord("S")):
            return "skip"
        if ch in (ord("q"), ord("Q"), 27):
            return "quit"


CONVERGENCE_FOR_TASK = {
    "accounts": ("user:", "key:"),
    "packages": ("apt:", "npm:", "pipx:", "cargo:", "mise:"),
    "system": ("system:",),
    "services": ("service:",),
    "dotfiles": ("dotfile:",),
    "repos": ("repo:",),
    "apps": ("binary:",),
    "deploy_key": ("manual:github",),
    "vault": ("manual:vault",),
    "data": ("manual:data",),
    "ssh": ("ssh:", "manual:login"),
}


def _tui_check_task(name: str, m: dict, dry: bool) -> list[tuple[str, str, str]]:
    if dry:
        return [("state checks", "SKIP", "dry-run - no state was changed")]

    out: list[tuple[str, str, str]] = []

    def ck(label, ok, detail="", warn=False):
        out.append((label, "PASS" if ok else ("WARN" if warn else "FAIL"),
                    str(detail)))

    prefixes = CONVERGENCE_FOR_TASK.get(name)
    if prefixes:
        for label, ok, detail, warn in check_convergence(m):
            if any(label.startswith(p) for p in prefixes):
                ck(label, ok, detail, warn)

    # Only checks that convergence cannot answer live here.
    if name == "accounts":
        for u in effective_users(m):
            if u.get("sudo_group"):
                ck(f"sudo:{u['name']}", in_group(u["name"], u["sudo_group"]))

    elif name == "toolchain":
        home = str(m.get("target", {}).get("home") or invoking_home())
        for tool_name in required_managers(m):
            ck(f"tool:{tool_name}", manager_available(tool_name, m, home))

    elif name == "packages":
        for pkg in ("ufw", "fail2ban", "openssh-server", "zsh"):
            ck(f"dpkg:{pkg}", _pkg_installed(pkg))

    elif name == "firewall":
        rc, out_s = cmd(["ufw", "status", "verbose"], quiet=True)
        if rc:
            ck("ufw status", False, "cannot read ufw status (needs root?)", warn=True)
        else:
            ck("ufw active", "Status: active" in out_s)
            for rule in m.get("firewall", {}).get("allow", []):
                ck(f"rule {rule}", rule in out_s)

    elif name == "system":
        ck("hostname", socket.gethostname() == m["target"]["hostname"])
        rc, tz = cmd(["timedatectl", "show", "-p", "Timezone", "--value"], quiet=True)
        ck("timezone", rc == 0 and tz.strip() == m.get("system", {}).get("timezone"))

    elif name == "deploy_key":
        rc, out_s = cmd(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                         "-T", "git@github.com"], quiet=True)
        detail = out_s.strip()[:120] or f"rc={rc}"
        ok = rc in (0, 1) and ("successfully authenticated" in out_s.lower()
                               or out_s.lower().startswith("hi "))
        ck("github ssh", ok, detail)

    elif name not in CONVERGENCE_FOR_TASK and name not in ("preflight", "verify"):
        ck(name, False, f"no check registered for task '{name}'", warn=True)

    return out


def _tui_dispatch(run: str, m: dict, dry: bool) -> tuple[int, bool]:
    for part in [p.strip() for p in run.split(";") if p.strip()]:
        if part == "toolchain":
            log("MANUAL: run the 'toolchain' guided action to install managers")
            return 0, True
        if part == "doctor":
            rc = op_doctor(argparse.Namespace())
        elif part == "verify":
            rc = op_verify(argparse.Namespace(manifest_obj=m))
        elif part.startswith("apply "):
            only_m = re.search(r"--only=([^\s]+)", part)
            ns = argparse.Namespace(
                dry_run=dry, only=only_m.group(1) if only_m else None,
                hostname=None, ssh_port=None, no_verify=True, func=op_apply,
                manifest_obj=m,
            )
            rc = op_apply(ns)
        else:
            log(f"MANUAL: no executor for '{part}'")
            return 0, True
        if rc:
            return rc, False
    return 0, False


def _action_argv(action: dict, m: dict | None = None) -> list[str] | None:
    exe = [sys.executable, str(Path(__file__).resolve())]
    cid = action.get("command_id")
    if cid == "keygen":
        return [*exe, "keygen", "--name", str(action.get("name", "deploy-github"))]
    if cid == "vault_unpack":
        return [*exe, "vault-unpack", "--vault-dir",
                str(action.get("vault_dir", DEFAULT_VAULT_DIR))]
    if cid == "github_ssh":
        return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-T", "git@github.com"]
    if cid == "ssh_cutover_prepare":
        argv = [*exe, "ssh-cutover-prepare"]
        if action.get("rollback_seconds"):
            argv += ["--rollback-seconds", str(action["rollback_seconds"])]
        return argv
    if cid == "ssh_cutover_commit":
        return [*exe, "ssh-cutover-commit", "--confirm-login"]
    if cid == "ssh_cutover_rollback":
        return [*exe, "ssh-cutover-rollback"]
    if cid == "sync_data":
        dest = str((m or {}).get("data", {}).get("destination", "")).strip()
        if (not dest or dest.startswith("-")
                or not re.fullmatch(r"[^\s:]+:[^\s]+", dest)):
            return None
        argv = [*exe, "sync-data"]
        if action.get("dry_run"):
            argv.append("--dry-run")
        data = (m or {}).get("data", {})
        for p in data.get("paths", []) or []:
            p = str(p)
            if not (p.startswith("/") or p.startswith("~/")) or "\n" in p:
                return None
            argv += ["--path", p]
        for ex in data.get("exclude", []) or []:
            ex = str(ex)
            if ex.startswith("-") or "\n" in ex:
                return None
            argv += ["--exclude", ex]
        return [*argv, "--destination", dest]
    return None


def _tui_prompt(stdscr, title: str, message: str, default: str = "") -> str:
    stdscr.erase()
    h, _w = stdscr.getmaxyx()
    _tui_put(stdscr, 1, 2, title, _TUI_CURSES.A_BOLD)
    _tui_put(stdscr, 3, 2, message)
    if default:
        _tui_put(stdscr, 4, 2, f"Enter accepts default: {default}")
    y = min(6, max(0, h - 2))
    stdscr.refresh()
    _TUI_CURSES.echo()
    _TUI_CURSES.curs_set(1)
    try:
        raw = stdscr.getstr(y, 2, 200).decode(errors="replace").strip()
    except Exception:
        raw = ""
    finally:
        _TUI_CURSES.noecho()
        _TUI_CURSES.curs_set(0)
    return raw or str(default)


def _set_manifest_value(m: dict, target: str, value: str) -> bool:
    parts = [p for p in str(target).split(".") if p]
    if len(parts) < 2:
        return False
    cur = m
    for p in parts[:-1]:
        if isinstance(cur, list):
            if not p.isdigit() or int(p) >= len(cur):
                return False
            cur = cur[int(p)]
        elif isinstance(cur, dict):
            if p not in cur or not isinstance(cur[p], (dict, list)):
                return False
            cur = cur[p]
        else:
            return False
    last = parts[-1]
    if not isinstance(cur, dict):
        return False
    if last == "paths":
        cur[last] = [x.strip() for x in str(value).split(",") if x.strip()]
    else:
        cur[last] = value
    return True


def _tui_run_child(argv: list[str], *, cwd: Path | str | None = None,
                   env: dict | None = None, as_user: str | None = None) -> int:
    _TUI_CURSES.endwin()
    argv = [str(a) for a in argv]
    if as_user and os.geteuid() == 0 and as_user != "root":
        argv = ["runuser", "-u", as_user, "--", *argv]
    print("\n$ " + shlex.join(argv), flush=True)
    child_env = dict(os.environ)
    if env:
        child_env.update({str(k): str(v) for k, v in env.items()})
    try:
        rc = subprocess.run(argv, cwd=str(cwd or REPO), env=child_env).returncode
    except Exception as exc:
        print(f"[ERROR] {type(exc).__name__}: {exc}", flush=True)
        rc = 1
    try:
        input("\nPress Enter to return to vps-mirror...")
    except EOFError:
        pass
    return rc


def _tui_toolchain(stdscr, m: dict, dry: bool) -> tuple[int, bool, list]:
    home = str(m.get("target", {}).get("home") or invoking_home())
    checks: list[tuple[str, str, str]] = []
    manual = False
    rc = 0
    for name in required_managers(m):
        if manager_available(name, m, home):
            checks.append((f"tool:{name}", "PASS", "available"))
            continue
        steps = manager_install_steps(name, m, home)
        lines = [f"{name} is required by the manifest.", ""]
        lines += [shlex.join(str(a) for a in s["argv"]) for s in steps]
        lines += ["", "Enter=install   n=skip   s=skip all   q=quit"]
        ans = _tui_modal(stdscr, f"TOOLCHAIN - {name}", lines, allow_no=True)
        if ans in ("skip", "quit", "no"):
            checks.append((f"tool:{name}", "WARN", "skipped by user"))
            rc = 1
            if ans == "quit":
                manual = True
                break
            continue
        if dry:
            checks.append((f"tool:{name}", "SKIP", "dry-run"))
            continue
        failed = False
        for step in steps:
            step_rc = _tui_run_child(step["argv"], env=step.get("env"),
                                     as_user=step.get("as_user"))
            if step_rc:
                failed = True
                break
        ok = (not failed) and manager_available(name, m, home)
        checks.append((f"tool:{name}", "PASS" if ok else "FAIL",
                       "ready" if ok else "install failed"))
        if not ok:
            rc = 1
    return rc, manual, checks


def _tui_project_deps(stdscr, action: dict, m: dict, dry: bool
                      ) -> tuple[list, int, bool]:
    home = str(m.get("target", {}).get("home") or invoking_home())
    user = str(m.get("target", {}).get("user", ""))
    env = {"HOME": home}
    groups = set(action.get("groups", []) or [])
    deps = [d for d in refresh_project_deps(m)
            if str(d.get("kind", "")) in groups]
    checks: list[tuple[str, str, str]] = []
    rc = 0
    if not deps:
        return [("project_deps", "WARN",
                 f"no {','.join(sorted(groups))} projects detected")], 0, False
    for dep in deps:
        repo = str(dep.get("repo", ""))
        path = project_path(dep, home)
        argv = project_install_argv(dep, home)
        if not path or not path.is_dir() or not argv:
            checks.append((f"project:{repo}", "WARN",
                           "not present on this box"))
            continue
        manager = str(dep.get("manager", ""))
        if manager and not manager_available(manager, m, home):
            steps = manager_install_steps(manager, m, home)
            lines = [f"{manager} is required for {repo}.", ""]
            lines += [shlex.join(str(a) for a in s["argv"]) for s in steps]
            lines += ["", "Enter=install   n=skip project   s=skip all   q=quit"]
            ans = _tui_modal(stdscr, f"TOOLCHAIN - {manager}", lines,
                             allow_no=True)
            if ans in ("quit", "skip", "no"):
                checks.append((f"tool:{manager}", "WARN", "skipped by user"))
                rc = 1
                if ans == "quit":
                    return checks, rc, True
                continue
            for step in steps:
                if _tui_run_child(step["argv"], env=step.get("env"),
                                  as_user=step.get("as_user")):
                    checks.append((f"tool:{manager}", "FAIL", "install failed"))
                    rc = 1
                    break
        if dry:
            checks.append((f"project:{repo}", "SKIP", "dry-run"))
            continue
        ans = _tui_modal(stdscr, f"PROJECT DEPS - {repo}", [
            str(action.get("why", "")), "",
            "This will run:", "  " + shlex.join(str(a) for a in argv), "",
            "Enter=install   n=skip   s=skip all   q=quit",
        ], allow_no=True)
        if ans in ("quit", "skip", "no"):
            checks.append((f"project:{repo}", "WARN", "skipped by user"))
            if ans == "quit":
                return checks, rc, True
            continue
        step_rc = _tui_run_child(argv, cwd=path, env=env, as_user=user)
        ok = step_rc == 0
        checks.append((f"project:{repo}", "PASS" if ok else "FAIL",
                       "ok" if ok else f"exit={step_rc}"))
        if not ok:
            rc = 1
    return checks, rc, False


def _tui_run_action(stdscr, action: dict, m: dict, dry: bool
                    ) -> tuple[str, list, int]:
    kind = str(action.get("kind", ""))
    title = str(action.get("title", action.get("id", "action")))
    rc = 0

    if kind == "acknowledge":
        ans = _tui_modal(stdscr, title, [str(action.get("message", ""))])
        if ans in ("skip", "quit"):
            return ans, [], rc

    elif kind == "prompt_value":
        value = _tui_prompt(stdscr, title, str(action.get("message", "Value")),
                            str(action.get("default", "")))
        if value:
            if not _set_manifest_value(m, str(action.get("target", "")), value):
                _tui_modal(stdscr, "INVALID TARGET",
                           [f"cannot store value at {action.get('target')!r}"])
                return "skip", [], rc
        else:
            _tui_modal(stdscr, title, ["No value entered; left unchanged."])

    elif kind == "prompt_bool":
        ans = _tui_modal(
            stdscr, title,
            [str(action.get("why", "")), "", str(action.get("message", "Allow?")),
             "", "No keeps plain files; yes recreates recorded symlinks."],
            footer="Enter=yes   n=no   s=skip   q=quit", allow_no=True)
        if ans in ("skip", "quit"):
            return ans, [], rc
        value = ans == "enter"
        if not _set_manifest_value(m, str(action.get("target", "")), value):
            _tui_modal(stdscr, "INVALID TARGET",
                       [f"cannot store value at {action.get('target')!r}"])
            return "skip", [], rc

    elif kind == "toolchain":
        rc, _, checks = _tui_toolchain(stdscr, m, dry)
        return "done", checks, rc

    elif kind == "project_deps":
        checks, rc, quit_flag = _tui_project_deps(stdscr, action, m, dry)
        if quit_flag:
            return "quit", checks, rc
        return "done", checks, rc

    elif kind == "guided_subprocess":
        argv = _action_argv(action, m)
        if not argv:
            ans = _tui_modal(stdscr, "UNSUPPORTED ACTION",
                             [f"command_id={action.get('command_id')!r}"])
            return ans, [], rc
        ans = _tui_modal(stdscr, f"GUIDED - {title}", [
            str(action.get("why", "")), "",
            "This will run:", "  " + shlex.join(argv), "",
            "Enter=run   s=skip   q=quit",
        ])
        if ans in ("skip", "quit"):
            return ans, [], rc
        rc = _tui_run_child(argv)
        confirm = str(action.get("confirm", ""))
        if confirm:
            ans = _tui_modal(stdscr, "AFTER ACTION", [
                f"exit={rc}", "", confirm, "",
                "Enter=continue   r=retry   s=skip   q=quit",
            ])
            if ans == "retry":
                rc = _tui_run_child(argv)
            elif ans in ("skip", "quit"):
                return ans, [], rc

    elif kind == "save_session":
        ans = _tui_modal(stdscr, f"CONFIRM - {title}", [
            str(action.get("why", "")), "",
            "Only the generated manifest.toml is written.",
            "mirror.toml and logs are never modified.",
            "Do not re-bundle from this target afterwards.", "",
            "Enter=save   s=skip   q=quit",
        ])
        if ans in ("skip", "quit"):
            return ans, [], rc
        ok, note = _persist_session(m)
        status = "PASS" if ok else "WARN"
        return ("done" if ok else "skip",
                [("manifest_saved", status, note)], rc)

    else:
        ans = _tui_modal(stdscr, "UNSUPPORTED ACTION", [f"kind={kind!r}"])
        return ans, [], rc

    task = str(action.get("check_task", ""))
    results = _tui_check_task(task, m, dry) if task else []
    return "done", results, rc


def run_tui(plan: dict, m: dict) -> int:
    """Curses task driver: run declared tasks, verify them, offer the next one."""
    global _TUI_CURSES
    try:
        import curses as _curses
        _TUI_CURSES = _curses
    except ImportError:
        log("curses unavailable; use `drive` without --tui", "WARN")
        return 0

    names = [n for n in plan.get("order", {}).get("tasks", TASK_LADDER)
             if n in plan.get("tasks", {})]
    specs = plan["tasks"]
    state = {n: "PENDING" for n in names}
    logs: dict[str, list[str]] = {n: [] for n in names}
    results: dict[str, list[tuple[str, str, str]]] = {}
    selected = 0
    dry = True
    actions = [a for a in plan.get("actions", [])
               if isinstance(a, dict) and a.get("id")]
    astate = {str(a["id"]): str(a.get("initial_state", "TODO"))
              for a in actions}
    aselected = 0
    view = "tasks"

    def _render_actions(stdscr) -> None:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        bold = _TUI_CURSES.A_BOLD
        done = sum(1 for a in actions if astate[str(a["id"])] == "DONE")
        _tui_put(stdscr, 0, 1, f"vps-mirror drive  GUIDED ACTIONS  "
                              f"mode={'DRY-RUN' if dry else 'LIVE'}", bold)
        _tui_put(stdscr, 1, 1, f"progress: {done}/{len(actions)} done   "
                              f"↑↓ select  Enter run  s skip  a/Tab tasks  q quit")
        _tui_put(stdscr, 2, 0, "-" * max(0, w - 1))
        if not actions:
            _tui_put(stdscr, 4, 2, "No actions declared in mirror.toml.")
            stdscr.refresh()
            return
        for i, a in enumerate(actions):
            row = 3 + i
            if row >= h - 8:
                break
            aid = str(a["id"])
            marker = ">" if i == aselected else " "
            label = (f"{marker} [{astate[aid]:<7}] {i + 1:>2}. "
                     f"{aid:<20} {a.get('kind', '')}")
            _tui_put(stdscr, row, 1, label, bold if i == aselected else 0)
        cur = actions[aselected]
        base = 3 + min(len(actions), max(1, h - 12)) + 1
        _tui_put(stdscr, base, 1, str(cur.get("title", cur["id"])), bold)
        _tui_put(stdscr, base + 1, 1,
                 str(cur.get("why") or cur.get("message") or "")[:w - 3])
        _tui_put(stdscr, base + 2, 1,
                 f"check={cur.get('check_task', '-')}")
        stdscr.refresh()

    def _render(stdscr) -> None:
        if view == "actions":
            _render_actions(stdscr)
            return
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        done = sum(1 for n in names if state[n] == "DONE")
        bold = _TUI_CURSES.A_BOLD
        _tui_put(stdscr, 0, 1, f"vps-mirror drive  target={m['target']['user']}"
                              f"@{m['target']['hostname']}  "
                              f"mode={'DRY-RUN' if dry else 'LIVE'}", bold)
        _tui_put(stdscr, 1, 1, f"progress: {done}/{len(names)} done   "
                              f"↑↓ select  Enter run  n next  a actions  "
                              f"s skip  d dry  q quit")
        _tui_put(stdscr, 2, 0, "-" * max(0, w - 1))

        top = max(0, min(selected - (h // 3), len(names) - max(1, h // 2)))
        for i, name in enumerate(names[top:], start=top):
            row = 3 + (i - top)
            if row >= h - 9:
                break
            marker = ">" if i == selected else " "
            crit = str(specs[name].get("criticality", "?")).upper()
            label = f"{marker} [{state[name]:<7}] {i + 1:>2}. {name:<12} {crit}"
            attr = bold if i == selected else 0
            _tui_put(stdscr, row, 1, label, attr)

        base = 3 + min(len(names) - top, max(1, h - 12)) + 1
        cur = names[selected]
        spec = specs[cur]
        _tui_put(stdscr, base, 1, f"TASK {cur}: {spec.get('run', '')}", bold)
        _tui_put(stdscr, base + 1, 1,
                 f"criticality={spec.get('criticality', '?')}")
        line = base + 4
        for entry in logs[cur][-max(0, h - base - 6):]:
            if line >= h - 1:
                break
            _tui_put(stdscr, line, 2, entry[:w - 3])
            line += 1
        if results.get(cur):
            for label, status, detail in results[cur][-4:]:
                if line >= h - 1:
                    break
                _tui_put(stdscr, line, 2, f"[{status}] {label} {detail}"[:w - 3])
                line += 1
        stdscr.refresh()

    def _run_selected(stdscr) -> None:
        nonlocal selected
        name = names[selected]
        if name == "preflight" and not is_root():
            _tui_modal(stdscr, "PREFLIGHT",
                       ["Run the TUI as root (sudo vpsclone drive --tui)",
                        "for real target checks and apply steps."])
            return
        while True:
            state[name] = "RUNNING"
            _render(stdscr)
            buf = io.StringIO()
            rc = 0
            manual = False
            try:
                with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
                    if name == "toolchain":
                        rc, manual, checks = _tui_toolchain(stdscr, m, dry)
                        results[name] = checks
                    else:
                        rc, manual = _tui_dispatch(
                            str(specs[name].get("run", "")), m, dry)
                        if not manual:
                            results[name] = _tui_check_task(name, m, dry)
            except BaseException as exc:
                buf.write(f"[ERROR] {type(exc).__name__}: {exc}\n")
                rc = 1
            logs[name] = buf.getvalue().splitlines()[-200:]
            fails = [r for r in results.get(name, []) if r[1] == "FAIL"]
            if manual:
                state[name] = "SKIPPED"
            elif rc or fails:
                state[name] = "FAILED"
            else:
                state[name] = "DONE"

            lines = [f"task: {name}  exit={rc}  state={state[name]}", ""]
            lines += [x for x in logs[name][-8:]]
            lines += [f"[{s}] {lbl} {det}" for lbl, s, det in results.get(name, [])]
            action = _tui_modal(stdscr, f"RESULT - {name.upper()}", lines)
            if action == "quit":
                raise KeyboardInterrupt
            if action == "retry":
                continue
            if action == "skip":
                state[name] = "SKIPPED"
            return

    def _run_selected_action(stdscr) -> None:
        nonlocal aselected
        if not actions:
            return
        while True:
            action = actions[aselected]
            aid = str(action["id"])
            if astate[aid] == "DONE":
                return
            astate[aid] = "RUNNING"
            _render(stdscr)
            status, checks, rc = _tui_run_action(stdscr, action, m, dry)
            if status == "quit":
                raise KeyboardInterrupt
            if status == "skip":
                astate[aid] = "SKIPPED"
            else:
                fails = [c for c in checks if c[1] == "FAIL"]
                astate[aid] = "DONE" if rc == 0 and not fails else "FAILED"
            lines = [f"action: {aid}  exit={rc}  state={astate[aid]}"]
            lines += [f"[{s}] {l} {d}" for l, s, d in checks]
            ans = _tui_modal(stdscr, f"ACTION - {aid.upper()}", lines)
            if ans == "quit":
                raise KeyboardInterrupt
            if ans == "retry":
                continue
            return

    def _main(stdscr) -> None:
        nonlocal selected, dry, aselected, view
        _TUI_CURSES.curs_set(0)
        while True:
            _render(stdscr)
            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q"), 27):
                break
            if ch == ord("a") or ch == 9:  # 'a' or Tab toggles views
                view = "actions" if view == "tasks" else "tasks"
                continue
            if view == "actions":
                if ch in (_TUI_CURSES.KEY_UP, ord("k")):
                    aselected = max(0, aselected - 1)
                elif ch in (_TUI_CURSES.KEY_DOWN, ord("j")):
                    aselected = min(len(actions) - 1, aselected + 1)
                elif ch in (10, 13, getattr(_TUI_CURSES, "KEY_ENTER", -1), ord("r")):
                    _run_selected_action(stdscr)
                elif ch == ord("s") and actions:
                    astate[str(actions[aselected]["id"])] = "SKIPPED"
                elif ch == ord("d"):
                    dry = not dry
                continue
            if ch in (_TUI_CURSES.KEY_UP, ord("k")):
                selected = max(0, selected - 1)
            elif ch in (_TUI_CURSES.KEY_DOWN, ord("j")):
                selected = min(len(names) - 1, selected + 1)
            elif ch in (10, 13, getattr(_TUI_CURSES, "KEY_ENTER", -1), ord("r")):
                _run_selected(stdscr)
            elif ch == ord("n"):
                candidates = [i for i, n in enumerate(names) if state[n] == "PENDING"]
                if candidates:
                    selected = candidates[0]
            elif ch == ord("s"):
                state[names[selected]] = "SKIPPED"
            elif ch == ord("d"):
                dry = not dry

    try:
        _TUI_CURSES.wrapper(_main)
    except KeyboardInterrupt:
        pass
    except Exception as exc:
        log(f"tui aborted: {exc}", "WARN")
    summary = ", ".join(f"{n}={state[n]}" for n in names)
    log(f"tui session end: {summary}")
    if actions:
        asummary = ", ".join(f"{a['id']}={astate[str(a['id'])]}" for a in actions)
        log(f"tui actions end: {asummary}")
    return 0


# ---------------------------------------------------------------- plan
def op_plan(args) -> None:
    m = load_manifest()
    conv = check_convergence(m)

    def pending(prefix: str, status: str, limit: int = 8) -> tuple[str, str]:
        bad = [name.split(":", 1)[1] for name, ok, _detail, _warn in conv
               if name.startswith(prefix) and not ok]
        if not bad:
            return "ok", ""
        detail = ", ".join(bad[:limit]) + (" ..." if len(bad) > limit else "")
        return f"{len(bad)} {status}", detail

    def pinned_count(installer: str) -> int:
        return sum(1 for v in expected_versions(m, installer).values() if v)

    apt_detail = next(detail for name, _ok, detail, _warn in conv
                      if name == "apt:packages")
    missing = apt_detail.split("missing: ", 1)[1] if "missing: " in apt_detail else ""
    rows = [
        ("apt packages",
         f"{len(missing.split(', '))} to install" if missing else "ok", missing),
        ("npm/pipx", "ok",
         f"{len(expected_versions(m, 'npm'))}/{len(expected_versions(m, 'pipx'))} "
         f"configured ({pinned_count('npm')}/{pinned_count('pipx')} pinned)"),
        ("cargo", "ok",
         f"{len(expected_versions(m, 'cargo'))} recorded "
         f"({pinned_count('cargo')} pinned) - replayed via cargo install"),
        ("users", *pending("user:", "to create")),
        ("dotfiles", *pending("dotfile:", "to write")),
        ("system files", *pending("system:", "to write", limit=5)),
    ]

    port = str(m["ssh"]["port"])
    allow = m.get("firewall", {}).get("allow", [])
    rows.append(("firewall", "open " + ",".join(allow) if allow else "no rules",
                 f"ssh={port}/tcp"))

    rows.append(("services", *pending("service:", "to enable")))

    repos = m.get("repos", [])
    pinnedrepos = sum(1 for r in repos if str(r.get("commit", "")).strip())
    repo_status, repo_detail = pending("repo:", "to clone", limit=6)
    rows.append(("repos", repo_status, f"{pinnedrepos} commit-pinned; " + repo_detail))

    noinstall = [b["name"] for b in m.get("binaries", [])
                 if not b.get("install", "").strip()]
    binary_status, _binary_detail = pending("binary:", "missing")
    rows.append(("binaries", binary_status,
                 f"no installer configured: {', '.join(noinstall[:4])}"))

    print(f"\nPLAN  target={m['target']['user']}@{m['target']['hostname']}  "
          f"manifest schema={m['meta']['schema']}\n")
    print(f"  {'AREA':<16} {'STATUS':<22} DETAIL")
    print("  " + "-" * 76)
    for area, status, detail in rows:
        print(f"  {area:<16} {status:<22} {detail[:52]}")
    print()
    if all(s == "ok" for _, s, _ in rows):
        log("already converged - nothing to do")
    else:
        log("dry plan only; run `sudo vpsclone apply --dry-run` for the real preflight")


# -------------------------------------------------------------- apply
class Backups:
    def __init__(self, stamp: str):
        self.root = BACKUP_ROOT / stamp
        self.index: list[dict] = []

    def take(self, path) -> None:
        p = Path(path).absolute()
        st = lstat(p)
        if st is None:
            return
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing to back up non-regular file: {p}")
        assert_no_symlink_components(p)
        dest = self.root / str(p).lstrip("/")
        assert_no_symlink_components(dest, root=BACKUP_ROOT)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(p, dest)
        self.index.append({"backup": str(dest), "original": str(p)})
        # Persist immediately: a later step failure must not lose rollback data.
        self.save()

    def save(self) -> None:
        if not self.index:
            return
        self.root.mkdir(parents=True, exist_ok=True)
        atomic_write_text(self.root / "index.json", json.dumps(self.index, indent=2) + "\n")
        log(f"backup index: {self.root / 'index.json'}")


def _resolve_capture_owner(spec: dict) -> tuple[int, int] | None:
    """Resolve a captured owner on the target; names win, ids are fallback."""
    if not isinstance(spec, dict):
        return None
    uid = gid = None
    name = str(spec.get("user") or "")
    if name:
        try:
            uid = pwd.getpwnam(name).pw_uid
        except KeyError:
            pass
    if uid is None and isinstance(spec.get("uid"), int):
        uid = spec["uid"]
    group = str(spec.get("group") or "")
    if group:
        try:
            gid = grp.getgrnam(group).gr_gid
        except KeyError:
            pass
    if gid is None and isinstance(spec.get("gid"), int):
        gid = spec["gid"]
    if uid is None or gid is None:
        return None
    return int(uid), int(gid)


def _restore_capture_owner(path: Path, m: dict, src: str, *,
                           symlink: bool = False) -> None:
    """Apply the captured user:group after a managed file or link is written."""
    spec = (m.get("capture_owners") or {}).get(str(src))
    if not spec:
        return
    ids = _resolve_capture_owner(spec)
    if ids is None:
        log(f"owner: cannot resolve {spec.get('user', '')}:"
            f"{spec.get('group', '')} for {src}; keeping manifest default", "WARN")
        return
    try:
        os.chown(path, *ids, follow_symlinks=not symlink)
    except OSError as exc:
        log(f"owner: could not set {src}: {exc}", "WARN")


def write_managed(src, dst, *, mode=None, owner=None, backups: Backups | None = None) -> bool:
    s, d = Path(src), Path(dst)
    assert_regular_file(s, root=VPS_DATA)
    data = s.read_bytes()
    assert_regular_file(d, must_exist=False)
    if d.exists() and d.read_bytes() == data:
        return False
    if backups is not None:
        backups.take(d)
    write_bytes_no_symlink(d, data, mode=mode, owner=owner)
    log(f"wrote {d}")
    return True


def write_managed_symlink(link: str, dst: Path, *, home: str, owner: str,
                          backups: Backups | None = None) -> bool:
    """Recreate a captured dotfile symlink, safely and idempotently."""
    d = Path(dst)
    target = safe_link_target(link, home)
    assert_no_symlink_components(d.parent)
    st = lstat(d)
    if st is not None and stat.S_ISLNK(st.st_mode):
        if os.readlink(d) == target:
            return False
        d.unlink()
    elif st is not None:
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing to replace non-regular file with symlink: {d}")
        if backups is not None:
            backups.take(d)
        d.unlink()
    d.parent.mkdir(parents=True, exist_ok=True)
    os.symlink(target, d)
    if owner:
        os.chown(d, pwd.getpwnam(owner).pw_uid, -1, follow_symlinks=False)
    log(f"linked {d} -> {target}")
    return True


def write_text_managed(text: str, dst, *, mode=None, owner=None,
                       backups: Backups | None = None) -> bool:
    data = (text.rstrip("\n") + "\n").encode()
    d = Path(dst)
    assert_regular_file(d, must_exist=False)
    if d.exists() and d.read_bytes() == data:
        return False
    if backups is not None:
        backups.take(d)
    write_bytes_no_symlink(d, data, mode=mode, owner=owner)
    log(f"wrote {d}")
    return True


def step_packages(m, dry) -> None:
    pkgs = m.get("packages", {})
    user = m["target"]["user"]
    home = m["target"]["home"]
    env = {"HOME": home}

    missing = [p for p in pkgs.get("apt", []) if not _pkg_installed(p)]
    if not missing:
        log("apt: all manifest packages present")
    elif dry:
        log(f"apt: would install {len(missing)} packages")
    else:
        apt_env = {"DEBIAN_FRONTEND": "noninteractive"}
        cmd(["apt-get", "update", "-qq"], check=True, env=apt_env)
        cmd(["apt-get", "install", "-y", "-qq", "--", *missing], check=True, env=apt_env)
        log(f"apt: installed {len(missing)} packages")

    npm_want = expected_versions(m, "npm")
    npm_specs = []
    for name, ver in npm_want.items():
        if name.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_@./+-]+", name):
            log(f"npm: unsafe package name skipped: {name!r}", "WARN")
            continue
        npm_specs.append(f"{name}@{ver}" if ver
                         and re.fullmatch(r"[0-9A-Za-z_.+-]+", ver) else name)
    if npm_specs:
        if dry:
            log(f"npm: would install {len(npm_specs)} pinned global package(s)")
        elif not tool_available("npm", home, prefer_mise=True):
            log("npm not installed, skipping global packages", "WARN")
        else:
            rc, out = cmd(tool_argv("npm", ["install", "-g", "--", *npm_specs],
                                    home, prefer_mise=True),
                          as_user=user, env=env, check=False)
            log(f"npm global packages: {'ok' if rc == 0 else 'FAILED'} {out.strip()[:120]}",
                "INFO" if rc == 0 else "WARN")

    pipx_want = expected_versions(m, "pipx")
    if pipx_want:
        if dry:
            log(f"pipx: would install {len(pipx_want)} pinned tool(s)")
        elif not tool_available("pipx", home, prefer_mise=True):
            log("pipx not installed, skipping tools", "WARN")
        else:
            failed = []
            for name, ver in pipx_want.items():
                spec = f"{name}=={ver}" if ver else name
                if spec.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.+=-]+", spec):
                    log(f"pipx: unsafe spec skipped: {spec!r}", "WARN")
                    continue
                rc, out = cmd(tool_argv("pipx", ["install", spec], home,
                                        prefer_mise=True),
                              as_user=user, env=env, check=False)
                if rc:
                    failed.append(f"{spec}: {out.strip().splitlines()[-1] if out.strip() else 'failed'}")
            log(f"pipx tools: {'ok' if not failed else 'FAILED'} {'; '.join(failed)[:160]}",
                "INFO" if not failed else "WARN")

    cargo_want = expected_versions(m, "cargo")
    safe_cargo = []
    for name, ver in cargo_want.items():
        if re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", name):
            safe_cargo.append((name, ver))
        else:
            log(f"cargo: unsafe crate name skipped: {name!r}", "WARN")
    if safe_cargo:
        if dry:
            log(f"cargo: would install {len(safe_cargo)} pinned crate(s)")
        elif not tool_available("cargo", home, prefer_mise=True):
            log("cargo not installed, skipping crate installs", "WARN")
        else:
            failed = []
            for name, ver in safe_cargo:
                subargs = ["install", name]
                if ver and re.fullmatch(r"[0-9A-Za-z_.+-]+", ver):
                    subargs += ["--version", ver]
                rc, out = cmd(tool_argv("cargo", subargs, home, prefer_mise=True),
                              as_user=user, env=env, check=False)
                if rc:
                    failed.append(f"{name}@{ver or 'latest'}: "
                                  f"{out.strip().splitlines()[-1] if out.strip() else 'failed'}")
            log(f"cargo crates: {'ok' if not failed else 'FAILED'} {'; '.join(failed)[:160]}",
                "INFO" if not failed else "WARN")


def ensure_group(name: str, dry: bool) -> None:
    if not name:
        return
    try:
        grp.getgrnam(name)
        return
    except KeyError:
        pass
    if dry:
        log(f"users: would create group {name}")
        return
    cmd(["groupadd", name], check=False)
    try:
        grp.getgrnam(name)
    except KeyError:
        log(f"users: could not create group {name}", "WARN")


def data_asset(rel: str) -> Path:
    p = Path(rel)
    if p.is_absolute() or ".." in p.parts:
        die(f"unsafe data asset path: {rel}")
    fp = VPS_DATA / p
    assert_no_symlink_components(fp, root=VPS_DATA)
    return fp


def step_users(m, dry, backups) -> None:
    for u in effective_users(m):
        name = u["name"]
        home = Path(u["home"])
        shell = u["shell"]
        create_home = u["create_home"]

        ensure_group(u["group"], dry)
        for g in u["groups"]:
            ensure_group(g, dry)

        if not user_exists(name):
            argv = ["useradd", "-M" if not create_home else "-m",
                    "-d", str(home), "-s", shell]
            if u["group"]:
                argv += ["-g", u["group"]]
            argv.append(name)
            if dry:
                log(f"users: would create {name} (shell {shell})")
            else:
                cmd(argv, check=True)
                log(f"created user {name}")
        else:
            current_shell = pwd.getpwnam(name).pw_shell
            if current_shell != shell:
                if dry:
                    log(f"users: would chsh {name}: {current_shell} -> {shell}")
                else:
                    rc, _ = cmd(["chsh", "-s", shell, name], check=False)
                    log(f"shell for {name}: "
                        f"{'ok' if rc == 0 else 'SKIPPED (is shell installed?)'}",
                        "INFO" if rc == 0 else "WARN")
            if u["group"]:
                pw = pwd.getpwnam(name)
                try:
                    current_group = grp.getgrgid(pw.pw_gid).gr_name
                except KeyError:
                    current_group = ""
                if current_group != u["group"]:
                    if dry:
                        log(f"users: would set primary group {name} -> {u['group']}")
                    else:
                        cmd(["usermod", "-g", u["group"], name], check=False)

        if create_home and not dry:
            assert_no_symlink_components(home)
            home.mkdir(parents=True, exist_ok=True)
            pw = pwd.getpwnam(name)
            shutil.chown(home, user=name, group=pw.pw_gid)
            os.chmod(home, 0o755)

        ak_rel = u.get("authorized_keys", "")
        inline_keys = str(u.get("authorized_keys_inline", "") or "").strip()
        src = data_asset(ak_rel) if ak_rel else None
        need_ssh = bool(src) or bool(inline_keys) or u["ssh_allow"]
        if need_ssh and not create_home and not home.is_dir():
            log(f"users: home {home} missing for {name}; skipping ssh setup", "WARN")
            need_ssh = False
        if need_ssh:
            sshdir = home / ".ssh"
            if not dry:
                assert_no_symlink_components(sshdir, root=home)
                if sshdir.exists() and not sshdir.is_dir():
                    die(f"refusing non-directory ssh dir: {sshdir}")
                sshdir.mkdir(parents=True, exist_ok=True, mode=0o700)
                os.chmod(sshdir, 0o700)
                shutil.chown(sshdir, user=name)
            target_ak = sshdir / "authorized_keys"
            if inline_keys:
                want = (inline_keys.rstrip("\n") + "\n").encode()
                if dry:
                    if not target_ak.exists() or target_ak.read_bytes() != want:
                        log(f"users: would write inline keys to {target_ak}")
                else:
                    write_text_managed(inline_keys, target_ak, mode=0o600,
                                       owner=name, backups=backups)
            elif src and src.is_file():
                if dry:
                    if (not target_ak.exists() or
                            target_ak.read_bytes() != src.read_bytes()):
                        log(f"users: would write {target_ak}")
                else:
                    write_managed(src, target_ak, mode=0o600, owner=name,
                                  backups=backups)
                    _restore_capture_owner(target_ak, m, ak_rel)
            elif src:
                log(f"users: authorized_keys source missing for {name}: {ak_rel}", "WARN")

        for g in u["groups"]:
            if not in_group(name, g):
                if dry:
                    log(f"users: would add {name} to {g}")
                else:
                    cmd(["usermod", "-aG", g, name], check=True)
        sudo_group = u.get("sudo_group", "")
        if sudo_group and user_exists(name) and not in_group(name, sudo_group):
            if dry:
                log(f"users: would add {name} to {sudo_group}")
            else:
                cmd(["usermod", "-aG", sudo_group, name], check=True)

    if not dry:
        tz = m.get("system", {}).get("timezone")
        if tz:
            cmd(["timedatectl", "set-timezone", tz], check=False)
        host = m["target"].get("hostname")
        if host and socket.gethostname() != host:
            cmd(["hostnamectl", "set-hostname", host], check=False)


def step_dotfiles(m, dry, backups) -> None:
    home = m["target"]["home"]
    owner = m["target"]["user"]
    allow_links = str(m.get("policy", {}).get("allow_symlinks", False)).lower() \
        in {"1", "true", "yes", "y"}
    links = (m.get("dotfile_symlinks", {}) or {})
    n = 0
    for target, src in m.get("dotfiles", {}).items():
        d = expand(target, home)
        s = VPS_DATA / src
        mode = 0o600 if str(d).endswith("/.ssh/config") else None
        link = links.get(target) if allow_links else None
        if dry:
            if not s.is_file():
                log(f"dotfiles: missing source {s}", "WARN")
            elif link:
                want = safe_link_target(link, home)
                if not d.is_symlink() or os.readlink(d) != want:
                    log(f"dotfiles: would link {d} -> {want}")
                    n += 1
            elif not d.is_file() or d.read_bytes() != s.read_bytes():
                log(f"dotfiles: would write {d}")
                n += 1
        elif link:
            changed = write_managed_symlink(link, d, home=home, owner=owner,
                                            backups=backups)
            _restore_capture_owner(d, m, src, symlink=True)
            if changed:
                n += 1
        else:
            changed = write_managed(s, d, mode=mode, owner=owner,
                                    backups=backups)
            _restore_capture_owner(d, m, src)
            if changed:
                n += 1
    log(f"dotfiles: {n} written/needed")


def step_system_files(m, dry, backups) -> None:
    for target, src in m.get("system_files", {}).items():
        d, s = Path(target), VPS_DATA / src
        if dry:
            if not s.is_file():
                log(f"system: missing source {s}", "WARN")
            elif not d.is_file() or d.read_bytes() != s.read_bytes():
                log(f"system: would write {d}")
        else:
            write_managed(s, d, mode=0o644, backups=backups)
            _restore_capture_owner(d, m, src)
    cloud = m.get("cloud", {})
    cloud_dropin = Path("/etc/cloud/cloud.cfg.d/99-vpsclone.cfg")
    body = ""
    if cloud.get("preserve_hostname"):
        body += "preserve_hostname: true\n"
    if not cloud.get("manage_etc_hosts", True):
        body += "manage_etc_hosts: false\n"
    if body:
        if dry:
            log(f"system: would write {cloud_dropin}")
        else:
            assert_regular_file(cloud_dropin, must_exist=False)
            if not cloud_dropin.is_file() or cloud_dropin.read_text() != body:
                backups.take(cloud_dropin)
                write_bytes_no_symlink(cloud_dropin, body.encode(), mode=0o644)
                log(f"wrote {cloud_dropin}")


def step_firewall(m, dry) -> None:
    fw = m.get("firewall", {})
    if not fw.get("enable", True):
        log("firewall: disabled in manifest")
        return
    if not shutil.which("ufw"):
        log("ufw not installed, skipping firewall", "WARN")
        return
    rules = []
    for raw in fw.get("allow", []):
        rule = str(raw)
        if rule.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.:/-]+", rule):
            die(f"unsafe firewall rule in manifest: {rule!r}")
        rules.append(rule)
    sshrule = f"{m['ssh']['port']}/tcp"
    if sshrule not in rules:
        rules.insert(0, sshrule)
    if dry:
        log(f"firewall: would default-deny incoming and allow {rules}")
        return
    cmd(["ufw", "default", "deny", "incoming"], check=True)
    cmd(["ufw", "default", "allow", "outgoing"], check=True)
    for r in rules:
        cmd(["ufw", "allow", r], check=True)
    cmd(["ufw", "--force", "enable"], check=True)
    log("firewall: rules applied (ssh port opened BEFORE sshd reload)")


def ssh_unit() -> str:
    rc, out = cmd(["systemctl", "list-unit-files", "sshd.service", "--no-pager",
                   "--plain"], quiet=True)
    return "sshd" if rc == 0 and "sshd.service" in out else "ssh"


CUTOVER_STATE = VPS_DATA / "ssh-cutover.json"
FINAL_DROPIN = Path("/etc/ssh/sshd_config.d/99-vpsclone.conf")
CUTOVER_DROPIN = Path("/etc/ssh/sshd_config.d/99-vpsclone-cutover.conf")


def _valid_port(value: str) -> bool:
    return value.isdigit() and 1 <= int(value) <= 65535


def _active_ssh_ports() -> list[str]:
    rc, out = cmd(["sshd", "-T"], quiet=True)
    if rc:
        return []
    return sorted({p for p in re.findall(r"(?m)^port\s+(\d+)\s*$", out)
                   if _valid_port(p)})


def _port_listening(port: str) -> bool:
    rc, out = cmd(["ss", "-tulpn"], quiet=True)
    return rc == 0 and (f":{port} " in out or f":{port}\n" in out)


def _write_dropin(path: Path, body: str) -> None:
    assert_regular_file(path, must_exist=False)
    write_bytes_no_symlink(path, body.encode(), mode=0o644)


def _restore_ssh_files(final_bytes: bytes | None,
                       cutover_bytes: bytes | None) -> None:
    for path, data in ((FINAL_DROPIN, final_bytes),
                       (CUTOVER_DROPIN, cutover_bytes)):
        if data is None:
            path.unlink(missing_ok=True)
        else:
            _write_dropin(path, data.decode())


def _revert_ssh(final_bytes: bytes | None, cutover_bytes: bytes | None,
                message: str | None = None) -> tuple[int, str]:
    """Restore drop-ins AND reload sshd; abort if `message` is given and invalid."""
    _restore_ssh_files(final_bytes, cutover_bytes)
    rc, out = cmd(["sshd", "-t"], check=False)
    cmd(["systemctl", "reload", ssh_unit()], check=False)
    if rc and message:
        die(f"{message}\n{out.strip()}".rstrip())
    return rc, out


def _load_cutover() -> dict | None:
    if not CUTOVER_STATE.is_file():
        return None
    try:
        state = json.loads(CUTOVER_STATE.read_text())
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) and {"old_port", "new_port"} <= state.keys() else None


def _save_cutover(state: dict) -> None:
    atomic_write_text(CUTOVER_STATE, json.dumps(state, sort_keys=True) + "\n",
                      mode=0o600)


def _spawn_cutover_watchdog(seconds: int, token: str) -> None:
    """Detached timer: roll back if the cutover is not committed in time."""
    if seconds <= 0:
        return
    exe = [sys.executable, str(Path(__file__).resolve())]
    subprocess.Popen(
        [*exe, "ssh-cutover-watchdog", "--seconds", str(seconds), "--id", token],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True, cwd=str(REPO),
    )


def ssh_cutover_prepare(m: dict, backups, rollback_seconds: int = 600) -> None:
    """Open both ports, reload, verify, then wait for explicit commit."""
    src = VPS_DATA / m["ssh"]["hardening_file"]
    if not src.is_file():
        log("ssh: hardening file missing", "WARN")
        return
    new_port = str(m["ssh"]["port"])
    old_port = str(m["ssh"].get("old_port", "") or "")
    if not old_port or old_port == new_port:
        old_port = next((p for p in _active_ssh_ports() if p != new_port), "")
    if not _valid_port(new_port):
        die(f"invalid ssh port in manifest: {new_port!r}")

    final_body = render_dropin(m, src.read_text())
    prev_final = FINAL_DROPIN.read_bytes() if FINAL_DROPIN.is_file() else None
    prev_cutover = CUTOVER_DROPIN.read_bytes() if CUTOVER_DROPIN.is_file() else None

    if not old_port or old_port == new_port:
        backups.take(FINAL_DROPIN)
        _write_dropin(FINAL_DROPIN, final_body)
        CUTOVER_DROPIN.unlink(missing_ok=True)
        CUTOVER_STATE.unlink(missing_ok=True)
        rc, out = cmd(["sshd", "-t"])
        if rc:
            _revert_ssh(prev_final, prev_cutover,
                        f"sshd -t failed; reverted drop-in:\n{out.strip()}")
        cmd(["systemctl", "reload", ssh_unit()], check=False)
        log(f"ssh: no port change ({new_port}); final drop-in applied")
        return

    dual, n = re.subn(r"(?m)^Port\s+\d+\s*$",
                      f"Port {old_port}\nPort {new_port}", final_body, count=1)
    if n == 0:
        dual = f"Port {old_port}\nPort {new_port}\n{final_body}"

    backups.take(FINAL_DROPIN)
    _write_dropin(CUTOVER_DROPIN, dual)
    FINAL_DROPIN.unlink(missing_ok=True)
    rc, out = cmd(["sshd", "-t"])
    if rc:
        _revert_ssh(prev_final, prev_cutover,
                    f"sshd -t failed; reverted drop-in:\n{out.strip()}")
    rc, out = cmd(["systemctl", "reload", ssh_unit()], check=False)
    if rc:
        _revert_ssh(prev_final, prev_cutover,
                    f"sshd reload failed; reverted drop-in:\n{out.strip()}")
    if not (_port_listening(new_port) and _port_listening(old_port)):
        _revert_ssh(prev_final, prev_cutover,
                    f"sshd did not listen on both ports ({old_port}, {new_port})")

    token = secrets.token_hex(8)
    _save_cutover({
        "old_port": old_port,
        "new_port": new_port,
        "prepared_at": now(),
        "watchdog_id": token,
        "rollback_seconds": rollback_seconds,
        "previous_final": prev_final.decode() if prev_final is not None else None,
        "previous_cutover": (prev_cutover.decode()
                             if prev_cutover is not None else None),
    })
    _spawn_cutover_watchdog(rollback_seconds, token)
    log(f"ssh: prepared dual-port cutover {old_port} -> {new_port} (both live)")
    log(f"ssh: auto-rollback in {rollback_seconds}s if not committed")
    log("ssh: verify a FRESH login on the new port, then run "
        "ssh-cutover-commit --confirm-login (or ssh-cutover-rollback)")


def ssh_cutover_commit(m: dict, backups) -> None:
    state = _load_cutover()
    if not state:
        die("no prepared ssh cutover found (run ssh-cutover-prepare first)")
    new_port = str(m["ssh"]["port"])
    if str(state["new_port"]) != new_port:
        die(f"manifest port {new_port} no longer matches prepared cutover "
            f"{state['new_port']}; run ssh-cutover-rollback first")
    src = VPS_DATA / m["ssh"]["hardening_file"]
    if not src.is_file():
        die("hardening file missing; cannot commit ssh cutover")

    prev_final = (state.get("previous_final") or "").encode() \
        if state.get("previous_final") is not None else None
    prev_cutover = CUTOVER_DROPIN.read_bytes() if CUTOVER_DROPIN.is_file() else None
    backups.take(FINAL_DROPIN)
    _write_dropin(FINAL_DROPIN, render_dropin(m, src.read_text()))
    CUTOVER_DROPIN.unlink(missing_ok=True)
    rc, out = cmd(["sshd", "-t"])
    if rc:
        _revert_ssh(prev_final, prev_cutover,
                    f"sshd -t failed during commit; reverted:\n{out.strip()}")
    rc, out = cmd(["systemctl", "reload", ssh_unit()], check=False)
    if rc or not _port_listening(new_port):
        _revert_ssh(prev_final, prev_cutover,
                    f"ssh commit failed on port {new_port}; reverted:\n{out.strip()}")
    CUTOVER_STATE.unlink(missing_ok=True)
    log(f"ssh: cutover committed on port {new_port}; old firewall rule left "
        "for manual cleanup")


def ssh_cutover_rollback() -> None:
    state = _load_cutover()
    if not state:
        die("no prepared ssh cutover found")
    prev_final = (state.get("previous_final") or "").encode() \
        if state.get("previous_final") is not None else None
    prev_cutover = (state.get("previous_cutover") or "").encode() \
        if state.get("previous_cutover") is not None else None
    rc, out = _revert_ssh(prev_final, prev_cutover)
    if rc:
        die(f"sshd -t failed after rollback:\n{out.strip()}")
    CUTOVER_STATE.unlink(missing_ok=True)
    log(f"ssh: rolled back to port {state['old_port']}")


def op_ssh_cutover_prepare(args) -> None:
    if not is_root():
        die("ssh cutover needs root")
    seconds = int(getattr(args, "rollback_seconds", 600) or 0)
    if seconds < 0:
        die("rollback seconds must be >= 0")
    ssh_cutover_prepare(load_manifest(),
                        Backups(dt.datetime.now().strftime("%Y%m%d-%H%M%S")),
                        rollback_seconds=seconds)


def op_ssh_cutover_commit(args) -> None:
    if not getattr(args, "confirm_login", False):
        die("refusing ssh commit without --confirm-login; "
            "test a fresh SSH session first")
    if not is_root():
        die("ssh cutover needs root")
    ssh_cutover_commit(load_manifest(),
                       Backups(dt.datetime.now().strftime("%Y%m%d-%H%M%S")))


def op_ssh_cutover_rollback(args) -> None:
    if not is_root():
        die("ssh cutover needs root")
    ssh_cutover_rollback()


def op_ssh_cutover_watchdog(args) -> None:
    seconds = int(args.seconds)
    if seconds < 0:
        die("invalid watchdog interval")
    time.sleep(seconds)
    state = _load_cutover()
    if state and str(state.get("watchdog_id", "")) == str(args.id):
        ssh_cutover_rollback()


def step_ssh(m, dry, backups) -> None:
    if dry:
        log(f"ssh: would prepare two-phase cutover to port {m['ssh']['port']}")
        return
    ssh_cutover_prepare(m, backups)


def step_services(m, dry) -> None:
    for s in m.get("services", {}).get("enable", []):
        if dry:
            if cmd(["systemctl", "is-enabled", s], quiet=True)[0] != 0:
                log(f"services: would enable --now {s}")
            continue
        rc, _ = cmd(["systemctl", "enable", "--now", s], check=False)
        log(f"service {s}: {'ok' if rc == 0 else 'SKIPPED (check manually)'}",
            "INFO" if rc == 0 else "WARN")


def step_mise(m, dry) -> None:
    tools = m.get("packages", {}).get("mise", {}).get("tools", [])
    if not tools:
        return
    user = m["target"]["user"]
    home = m["target"]["home"]
    if dry:
        log(f"mise: would install {tools} as {user}")
        return
    if not shutil.which("mise"):
        log("mise not installed, skipping tools", "WARN")
        return
    failed = []
    for tool in tools:
        spec = str(tool)
        if spec.startswith("-") or not re.fullmatch(r"[A-Za-z0-9_.@+-]+", spec):
            log(f"mise: unsafe tool spec skipped: {spec!r}", "WARN")
            continue
        rc, out = cmd(["mise", "install", spec], as_user=user,
                      env={"HOME": home}, cwd=home, check=False)
        if rc:
            failed.append(f"{spec}: {out.strip().splitlines()[-1] if out.strip() else 'failed'}")
    log(f"mise install ({', '.join(tools)}): {'ok' if not failed else 'FAILED'}",
        "INFO" if not failed else "WARN")
    if failed:
        log("; ".join(failed)[:200], "WARN")


def step_binaries(m, dry) -> None:
    user, home = m["target"]["user"], m["target"]["home"]
    for b in m.get("binaries", []):
        install = b.get("install", "").strip()
        target = expand(b["path"], home)
        if target.exists():
            continue
        if not install:
            log(f"binary {b['name']}: no install command configured "
                f"(set [[binaries]].install in manifest.toml)", "WARN")
            continue
        if dry:
            log(f"binaries: would run install command for {b['name']}")
            continue
        rc, out = cmd(["sh", "-c", install], as_user=user,
                      env={"HOME": home}, check=False)
        log(f"binary {b['name']}: {'ok' if rc == 0 else 'FAILED'} {out.strip()[:120]}",
            "INFO" if rc == 0 else "WARN")


def step_repos(m, dry) -> None:
    home = m["target"]["home"]
    user = m["target"]["user"]
    for r in m.get("repos", []):
        p = expand(r["path"], home)
        want_commit = str(r.get("commit", ""))
        if p.exists():
            st = git_repo_state(p)
            if want_commit and st["commit"] and st["commit"] != want_commit:
                log(f"repo {r['path']}: at {st['commit'][:8]}, "
                    f"source {want_commit[:8]} (left as-is)", "WARN")
            continue
        if dry:
            log(f"repos: would clone {r['url']} -> {p}"
                + (f" at {want_commit[:8]}" if want_commit else ""))
            continue
        branch = str(r.get("branch", "main"))
        url = str(r["url"])
        if branch.startswith("-") or url.startswith("-"):
            die(f"unsafe repo definition: branch={branch!r} url={url!r}")
        if want_commit and not re.fullmatch(r"[0-9a-fA-F]{7,40}", want_commit):
            die(f"unsafe repo commit: {want_commit!r}")
        rc, out = cmd(["git", "clone", "-b", branch, "--", url, str(p)],
                      as_user=user, env={"HOME": home}, check=False)
        if rc:
            log(f"repo {r['path']} not cloned (deploy key may not be on GitHub yet): "
                f"{out.strip().splitlines()[-1] if out.strip() else ''}", "WARN")
            continue
        log(f"cloned {r['path']}")
        if want_commit:
            rc2, out2 = cmd(["git", "-C", str(p), "checkout", "-B", branch,
                             want_commit], as_user=user, env={"HOME": home},
                            check=False)
            log(f"repo {r['path']} commit {want_commit[:8]}: "
                f"{'ok' if rc2 == 0 else out2.strip()[:80]}",
                "INFO" if rc2 == 0 else "WARN")


def run_hook(path: str, dry: bool) -> None:
    p = REPO / path
    if not p.is_file():
        return
    if dry:
        log(f"hook: would run {path}")
        return
    log(f"hook {path}: running as root from {REPO}")
    os.chmod(p, 0o755)
    rc, out = cmd([str(p)], cwd=REPO, check=False)
    log(f"hook {path}: rc={rc}\n{out.strip()}", "INFO" if rc == 0 else "ERROR")
    if rc:
        die(f"hook {path} failed with exit code {rc}")


def step_hooks(m, dry) -> None:
    run_hook(m.get("hooks", {}).get("pre_apply", "hooks/pre-apply.sh"), dry)


# ------------------------------------------------- required toolchain / deps
MANAGER_ORDER = ("mise", "node", "npm", "pipx", "cargo", "yarn", "pnpm")


def declared_mise_tools(m: dict) -> list[str]:
    pkgs = m.get("packages", {}) or {}
    mise = pkgs.get("mise", {}) or {}
    return [str(t).strip() for t in (mise.get("tools", []) or [])
            if str(t).strip()]


def required_managers(m: dict) -> list[str]:
    """Read the manifest first: which managers must exist before replay?"""
    req: set[str] = set()
    pkgs = m.get("packages", {}) or {}
    for rec in pkgs.get("records", []) or []:
        installer = str(rec.get("installer", ""))
        if installer in ("npm", "pipx", "cargo"):
            req.add(installer)
    tools = declared_mise_tools(m)
    if tools:
        req.add("mise")
    if any(t.startswith("node@") for t in tools):
        req.add("node")
    for dep in m.get("project_deps", []) or []:
        manager = str(dep.get("manager", ""))
        if manager in ("npm", "yarn", "pnpm", "cargo"):
            req.add(manager)
    return [name for name in MANAGER_ORDER if name in req]


def manager_available(name: str, m: dict, home: str) -> bool:
    if name == "mise":
        return shutil.which("mise") is not None
    if name in ("node", "npm"):
        return tool_available("npm", home, prefer_mise=True)
    if name in ("yarn", "pnpm"):
        return (tool_available(name, home, prefer_mise=True)
                or tool_available("corepack", home, prefer_mise=True))
    return tool_available(name, home, prefer_mise=True)


def manager_install_steps(name: str, m: dict, home: str) -> list[dict]:
    """Fixed, validated recipes. No free-form commands are read from the manifest."""
    user = str(m.get("target", {}).get("user", ""))
    env = {"HOME": home}
    apt_env = {"DEBIAN_FRONTEND": "noninteractive"}
    if name == "mise":
        return [{"label": "apt-get install -y mise",
                 "argv": ["apt-get", "install", "-y", "mise"], "env": apt_env}]
    if name in ("node", "npm"):
        node_spec = next((t for t in declared_mise_tools(m)
                          if t.startswith("node@")), "")
        if node_spec:
            return [{"label": f"mise install {node_spec}",
                     "argv": ["mise", "install", node_spec],
                     "as_user": user, "env": env}]
        return [{"label": "apt-get install -y npm",
                 "argv": ["apt-get", "install", "-y", "npm"], "env": apt_env}]
    if name in ("pipx", "cargo"):
        return [{"label": f"apt-get install -y {name}",
                 "argv": ["apt-get", "install", "-y", name], "env": apt_env}]
    if name in ("yarn", "pnpm"):
        if tool_available("corepack", home, prefer_mise=True):
            return [
                {"label": "corepack enable",
                 "argv": tool_argv("corepack", ["enable"], home, True),
                 "as_user": user, "env": env},
                {"label": f"corepack prepare {name}@stable --activate",
                 "argv": tool_argv("corepack",
                                   ["prepare", f"{name}@stable", "--activate"],
                                   home, True),
                 "as_user": user, "env": env},
            ]
        return [{"label": f"npm install -g {name}",
                 "argv": tool_argv("npm", ["install", "-g", name], home, True),
                 "as_user": user, "env": env}]
    return []


def _confirm(message: str, assume_yes: bool = False) -> bool:
    if assume_yes:
        return True
    try:
        answer = input(f"{message} [y/N]: ").strip().lower()
    except EOFError:
        return False
    return answer in ("y", "yes")


def _run_install_steps(name: str, steps: list[dict]) -> bool:
    for step in steps:
        log(f"toolchain: {step['label']}")
        rc, out = cmd(step["argv"], as_user=step.get("as_user"),
                      env=step.get("env"), check=False)
        if rc:
            log(f"toolchain: {name} FAILED: {out.strip()[:160]}", "WARN")
            return False
    return True


def op_ensure_toolchain(args) -> int:
    m = getattr(args, "manifest_obj", None) or load_manifest()
    home = str(m.get("target", {}).get("home") or invoking_home())
    assume_yes = bool(getattr(args, "yes", False))
    names = required_managers(m)
    log(f"toolchain required: {', '.join(names) if names else '(none)'}")
    missing = []
    for name in names:
        if manager_available(name, m, home):
            log(f"toolchain: {name} available")
            continue
        steps = manager_install_steps(name, m, home)
        if not steps:
            log(f"toolchain: no safe recipe for {name}", "WARN")
            missing.append(name)
            continue
        print(f"\n{name} is required by the manifest. Recipe:")
        for step in steps:
            print("  " + shlex.join(str(a) for a in step["argv"]))
        if not _confirm(f"Install {name}?", assume_yes):
            log(f"toolchain: {name} skipped by user", "WARN")
            missing.append(name)
            continue
        if not _run_install_steps(name, steps):
            missing.append(name)
            continue
        if not manager_available(name, m, home):
            log(f"toolchain: {name} still unavailable after install", "WARN")
            missing.append(name)
        else:
            log(f"toolchain: {name} installed")
    if missing:
        log(f"toolchain incomplete: {', '.join(missing)}", "ERROR")
        return 1
    log("toolchain ready; dependent installs may proceed")
    return 0


def refresh_project_deps(m: dict) -> list[dict]:
    """Re-detect project types on this box after repos are cloned."""
    home = str(m.get("target", {}).get("home") or invoking_home())
    detected = detect_project_deps(home, m.get("repos", []) or [])
    if detected:
        m["project_deps"] = detected
    return list(m.get("project_deps", []) or [])


def install_project_deps(m: dict, kinds: tuple[str, ...],
                         assume_yes: bool = False) -> int:
    home = str(m.get("target", {}).get("home") or invoking_home())
    user = str(m.get("target", {}).get("user", ""))
    env = {"HOME": home}
    deps = [d for d in refresh_project_deps(m)
            if str(d.get("kind", "")) in kinds]
    if not deps:
        log(f"project deps: no {','.join(kinds)} projects detected")
        return 0
    failed = 0
    for dep in deps:
        repo = str(dep.get("repo", ""))
        path = project_path(dep, home)
        argv = project_install_argv(dep, home)
        if not path or not path.is_dir() or not argv:
            log(f"project deps: {repo} unavailable on this box, skipping", "WARN")
            continue
        manager = str(dep.get("manager", ""))
        if manager and not manager_available(manager, m, home):
            steps = manager_install_steps(manager, m, home)
            print(f"\n{manager} is required for {repo}. Recipe:")
            for step in steps:
                print("  " + shlex.join(str(a) for a in step["argv"]))
            if not steps or not _confirm(f"Install {manager}?", assume_yes):
                log(f"project deps: {manager} unavailable for {repo}, skipping",
                    "WARN")
                failed += 1
                continue
            if not _run_install_steps(manager, steps):
                failed += 1
                continue
        if not _confirm(f"Install dependencies in {repo} ({shlex.join(argv)})?",
                        assume_yes):
            log(f"project deps: {repo} skipped by user")
            continue
        log(f"project deps: {repo} -> {shlex.join(argv)}")
        rc, out = cmd(argv, cwd=str(path), as_user=user, env=env, check=False)
        log(f"project deps: {repo} {'ok' if rc == 0 else 'FAILED'} "
            f"{out.strip()[:160]}", "INFO" if rc == 0 else "WARN")
        if rc:
            failed += 1
    return 1 if failed else 0


def op_install_node_deps(args) -> int:
    m = getattr(args, "manifest_obj", None) or load_manifest()
    return install_project_deps(m, ("node",), bool(getattr(args, "yes", False)))


def op_install_cargo_deps(args) -> int:
    m = getattr(args, "manifest_obj", None) or load_manifest()
    return install_project_deps(m, ("rust",), bool(getattr(args, "yes", False)))


STEP_ORDER = ["hooks", "packages", "users", "binaries", "dotfiles", "system",
              "firewall", "ssh", "services", "mise", "repos"]


def op_apply(args) -> int:
    if not args.dry_run:
        need_root()
    if getattr(args, "ssh_port", None) is not None and not 1 <= args.ssh_port <= 65535:
        die(f"invalid ssh port: {args.ssh_port}")
    m = getattr(args, "manifest_obj", None) or load_manifest()
    user = m["target"]["user"]
    if args.hostname:
        m["target"]["hostname"] = args.hostname
    if args.ssh_port is not None:
        m["ssh"]["port"] = str(args.ssh_port)
    selected = [s.strip() for s in args.only.split(",")] if args.only else STEP_ORDER
    unknown = [s for s in selected if s not in STEP_ORDER]
    if unknown:
        die(f"unknown --only step(s): {', '.join(unknown)}. Choose from {', '.join(STEP_ORDER)}")

    log(f"apply target: {user}@{m['target']['hostname']}  dry={args.dry_run}")
    if not args.dry_run and "users" not in selected:
        missing_users = [u["name"] for u in effective_users(m)
                         if not user_exists(u["name"])]
        if missing_users:
            die(f"users {', '.join(missing_users)} do not exist; "
                "include 'users' in --only or create them first")

    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backups = Backups(stamp)

    steps = {
        "hooks": step_hooks, "packages": step_packages, "users": step_users,
        "binaries": step_binaries, "dotfiles": step_dotfiles,
        "system": step_system_files, "firewall": step_firewall, "ssh": step_ssh,
        "services": step_services, "mise": step_mise, "repos": step_repos,
    }
    try:
        for name in STEP_ORDER:
            if name in selected:
                log(f"--- step: {name} ---")
                if name in ("users", "dotfiles", "system", "ssh"):
                    steps[name](m, args.dry_run, backups)
                else:
                    steps[name](m, args.dry_run)
    except BaseException as exc:
        backups.save()
        log("apply aborted; any backups taken are indexed for rollback", "ERROR")
        if isinstance(exc, SystemExit):
            raise
        raise

    if not args.dry_run:
        backups.save()
        if "hooks" in selected:
            run_hook(m.get("hooks", {}).get("post_apply", "hooks/post-apply.sh"), False)
        verify_rc = 0
        if not args.no_verify:
            verify_rc = op_verify(argparse.Namespace(manifest_obj=m))
            if verify_rc:
                log("apply completed but verify reported failures", "WARN")
        log(f"apply complete. rollback with: sudo vpsclone rollback --stamp {stamp}")
        return verify_rc
    log("dry run complete - no changes made")
    return 0


# -------------------------------------------------------------- verify
def op_verify(args) -> int:
    m = getattr(args, "manifest_obj", None) or load_manifest()
    home = m["target"]["home"]
    checks = []

    def ck(name, ok, detail="", warn=False):
        checks.append((name, bool(ok), detail, warn))

    ck("root privileges", is_root())
    dots = Path(home) / ".config/dots/dots"
    ck("dotS installed", dots.exists(), str(dots), warn=True)

    for label, ok, detail, warn in check_convergence(m):
        ck(label, ok, detail, warn)

    print("\nVERIFY\n")
    fails = 0
    for name, ok, detail, warn in checks:
        mark = "PASS" if ok else ("WARN" if warn else "FAIL")
        if not ok and not warn:
            fails += 1
        print(f"  [{mark}] {name:<26} {detail}")
    print()
    if fails:
        log(f"verify: {fails} check(s) failed", "ERROR")
        return 1
    log("verify: all critical checks passed")
    return 0


# -------------------------------------------------------------- keygen
def validate_key_name(name: str) -> str:
    reserved = {"config", "authorized_keys", "known_hosts", "environment"}
    if (not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or name in (".", "..")
            or name.startswith("-") or name in reserved or name.endswith(".pub")):
        die(f"invalid key name {name!r}: reserved name or unsafe characters")
    return name


def validate_ssh_target(target: str) -> str:
    if not target or target.startswith("-") or any(c.isspace() for c in target):
        die(f"invalid ssh target {target!r}")
    return target


def op_keygen(args) -> None:
    name = validate_key_name(args.name or "deploy-github")
    who = os.environ.get("SUDO_USER") or getpass.getuser()
    comment = args.comment or f"{who}@{socket.gethostname()}"
    sshdir = DATA_HOME / ".ssh"
    assert_no_symlink_components(sshdir, root=DATA_HOME)
    sshdir.mkdir(mode=0o700, exist_ok=True)
    os.chmod(sshdir, 0o700)
    key = sshdir / name
    pub = Path(str(key) + ".pub")
    if key.exists() and not args.force:
        die(f"{key} exists (use --force to replace)")
    log("ssh-keygen will ask for a passphrase twice - input is hidden.")
    rc, _ = cmd(["ssh-keygen", "-t", "ed25519", "-a", "100", "-C", comment,
                 "-f", str(key)], capture=False)
    if rc or not key.exists() or not pub.exists():
        die("key generation failed")
    os.chmod(key, 0o600)
    os.chmod(pub, 0o644)
    log(f"generated {key}")

    if args.save_pub:
        dst = VPS_DATA / "ssh" / f"{name}.pub"
        dst.parent.mkdir(parents=True, exist_ok=True)
        assert_no_symlink_components(dst, root=VPS_DATA)
        shutil.copy2(pub, dst)
        log(f"saved public half to {dst} (in the data dir)")

    print("\n=== COPY THIS INTO GITHUB -> Settings -> SSH and GPG keys -> New SSH key ===")
    print(pub.read_text().strip())
    print("=============================================================================\n")

    if args.target:
        target = validate_ssh_target(args.target)
        log(f"copying key to {target}")
        cmd(["ssh", target, "mkdir", "-p", "~/.ssh"], check=True)
        cmd(["ssh", target, "chmod", "700", "~/.ssh"], check=True)
        cmd(["scp", "-p", str(key), f"{target}:.ssh/{name}"], check=True)
        cmd(["scp", "-p", str(pub), f"{target}:.ssh/{name}.pub"], check=True)
        entry = (
            "\n# managed by vpsclone keygen\n"
            "Host github.com\n"
            "    HostName github.com\n"
            "    User git\n"
            f"    IdentityFile ~/.ssh/{name}\n"
            "    IdentitiesOnly yes\n"
            "    AddKeysToAgent yes\n"
        )
        rc, _ = cmd(["ssh", target, "grep -q '^Host github.com$' ~/.ssh/config"], quiet=True)
        if rc:
            cmd(["ssh", target, "cat >> ~/.ssh/config && chmod 600 ~/.ssh/config"],
                input_text=entry, check=True)
        else:
            log("keygen: github.com host block already present on target")
        cmd(["ssh", target, "chmod", "600", f"~/.ssh/{name}"], check=True)
        log(f"key installed on {target}. Add the pubkey above, then test:")
        log(f"  ssh -T git@github.com   (from {target})")


# -------------------------------------------------------------- bundle
BUNDLE_README = """\
VPS MIRROR BUNDLE
=================

The archive has two trees:

  vps-mirror/       code and docs (safe to commit)
  vps-mirror-data/  captured files, mirror.toml, manifest.toml, reports

On the FRESH Ubuntu box (as root):

  1. apt-get update && apt-get install -y python3 git rsync openssh-server
  2. tar xzf vps-mirror-*.tar.gz -C /opt/
  3. cd /opt/vps-mirror && chmod +x vpsclone bootstrap.sh
  4. ./bootstrap.sh

bootstrap.sh installs vps-mirror-data into the invoking user's ~/.vps-data,
even when it is run with sudo. You can also run the steps by hand:

  install -d -m 0700 ~/.vps-data
  cp -a ../vps-mirror-data/. ~/.vps-data/
  sudo python3 vpsclone apply

Then, from your LOCAL machine, generate + ship the deploy key:

  python3 vpsclone keygen --target user@new-vps

Add the printed public key to GitHub, then on the VPS:

  ssh -T git@github.com
  python3 vpsclone apply --only=repos

Secrets, vaults and backups are NOT in this bundle. Private keys are generated
locally and scp'd separately. See README.md for the full playbook.
"""


def _bundle_entries(root: Path, prefix: str, skip: set[str],
                    pats: list[str]) -> list[tuple[Path, str]]:
    """Collect and validate regular files from one bundle source tree."""
    entries: list[tuple[Path, str]] = []
    if not root.exists():
        return entries
    for p in sorted(root.rglob("*")):
        rel = p.relative_to(root)
        if any(part in skip for part in rel.parts) or p.is_symlink():
            continue
        if not p.is_file():
            continue
        name = p.name
        if name.endswith((".tar.gz", ".tgz", ".gpg", ".key", ".pem", ".bak")):
            continue
        if name.startswith("id_") and not name.endswith(".pub"):
            continue
        if is_denied(str(rel), pats) or is_denied(str(p.resolve()), pats):
            die(f"refusing to bundle denied file: {rel}")
        entries.append((p, f"{prefix}/{rel}"))
    return entries


def op_bundle(args) -> None:
    pats = load_denylist()
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    if not (VPS_DATA / "mirror.toml").is_file() or not MANIFEST.is_file():
        die(f"no captured data in {VPS_DATA} - run `audit` first")
    out = Path(args.output) if args.output else VPS_DATA / f"vps-mirror-{stamp}.tar.gz"
    assert_no_symlink_components(out)
    if out.is_symlink() or (out.exists() and not out.is_file()):
        die(f"refusing unsafe bundle output path: {out}")

    # Validate every member before creating the archive. tarfile.add() on a
    # directory recurses, which would otherwise include denied files before the
    # loop ever reaches them.
    entries = _bundle_entries(REPO, "vps-mirror",
                              {".git", "__pycache__", ".vps-data"}, pats)
    entries += _bundle_entries(VPS_DATA, "vps-mirror-data",
                               {"vault", "backups", "keys", "secrets", ".vault",
                                "ssh-cutover.json"}, pats)

    try:
        with tarfile.open(out, "w:gz") as tf:
            for p, arc in entries:
                tf.add(p, arcname=arc, recursive=False)
            data = BUNDLE_README.encode()
            info = tarfile.TarInfo("vps-mirror/BUNDLE_README.txt")
            info.size = len(data)
            info.mode = 0o644
            tf.addfile(info, io.BytesIO(data))
    except BaseException:
        out.unlink(missing_ok=True)
        raise

    size = out.stat().st_size / 1024
    log(f"bundle: {out} ({size:.0f} KiB)")
    log(f"ship it: scp {out} root@new-vps:/opt/")


# ------------------------------------------------------------ remote driver
def remote_ssh_argv(target: str, port: str | int, command: str,
                    tty: bool = False) -> list[str]:
    argv = ["ssh", "-p", str(port), "-o", "StrictHostKeyChecking=ask"]
    if tty:
        argv.append("-tt")
    return [*argv, target, command]


def remote_scp_argv(target: str, port: str | int,
                    src: Path, remote_path: str) -> list[str]:
    return ["scp", "-P", str(port), str(src), f"{target}:{remote_path}"]


def op_remote_drive(args) -> int:
    """Bundle locally, ship over ssh, then run target-side drive in a TTY."""
    target = validate_ssh_target(args.target)
    port = str(args.port if args.port is not None else 22)
    if not _valid_port(port):
        die(f"invalid ssh port: {port!r}")

    def run_with_bundle(bundle: Path) -> int:
        assert_regular_file(bundle)
        rc, out = cmd(remote_ssh_argv(
            target, port, "mktemp -d /tmp/vps-mirror-remote.XXXXXX"),
            quiet=True, check=True)
        remote_dir = out.strip()
        if not re.fullmatch(r"/tmp/vps-mirror-remote\.[A-Za-z0-9]{6}", remote_dir):
            die(f"unexpected remote temp dir: {remote_dir!r}")
        cmd(remote_scp_argv(target, port, bundle,
                            f"{remote_dir}/bundle.tar.gz"), check=True)
        script = (
            f"tar xzf {shlex.quote(remote_dir)}/bundle.tar.gz "
            f"-C {shlex.quote(remote_dir)} && "
            f"mkdir -p \"$HOME/.vps-data\" && "
            f"cp -a {shlex.quote(remote_dir)}/vps-mirror-data/. \"$HOME/.vps-data/\" && "
            f"cd {shlex.quote(remote_dir)}/vps-mirror && "
            "sudo python3 vpsclone drive "
            "--plan \"$HOME/.vps-data/mirror.toml\" --tui"
        )
        rc, _ = cmd(remote_ssh_argv(target, port, script, tty=True),
                    capture=False, check=False)
        if not args.no_cleanup:
            cmd(remote_ssh_argv(
                target, port,
                f"rm -rf -- {shlex.quote(remote_dir)}"), quiet=True)
        return rc

    if args.bundle:
        return run_with_bundle(Path(args.bundle).expanduser().absolute())
    with tempfile.TemporaryDirectory(prefix="vps-mirror-remote-") as td:
        bundle = Path(td) / "vps-mirror.tar.gz"
        op_bundle(argparse.Namespace(output=str(bundle)))
        return run_with_bundle(bundle)


# -------------------------------------------------------------- rollback
def op_rollback(args) -> None:
    need_root()
    if not BACKUP_ROOT.exists() or BACKUP_ROOT.is_symlink():
        die("no backups found")
    dirs = sorted(p for p in BACKUP_ROOT.iterdir()
                  if p.is_dir() and not p.is_symlink())
    if not dirs:
        die("no backups found")
    names = [p.name for p in dirs]
    stamp = args.stamp or names[-1]
    if stamp not in names:
        die(f"unknown backup stamp: {stamp}")
    root = BACKUP_ROOT / stamp
    idx = root / "index.json"
    assert_regular_file(idx, root=BACKUP_ROOT)
    items = json.loads(idx.read_text())
    if not isinstance(items, list):
        die(f"invalid backup index in {idx}")

    validated = []
    for item in items:
        if not isinstance(item, dict) or "backup" not in item or "original" not in item:
            die(f"invalid backup entry in {idx}")
        src, dst = Path(item["backup"]), Path(item["original"])
        if not src.is_absolute() or not dst.is_absolute():
            die(f"backup index paths must be absolute: {item}")
        try:
            src.relative_to(BACKUP_ROOT)
        except ValueError:
            die(f"backup path outside {BACKUP_ROOT}: {src}")
        assert_regular_file(src, root=BACKUP_ROOT)
        assert_no_symlink_components(dst)
        validated.append((src, dst))

    ssh_touched = False
    for src, dst in reversed(validated):
        write_bytes_no_symlink(dst, src.read_bytes(),
                               mode=stat.S_IMODE(src.stat().st_mode))
        os.chmod(dst, stat.S_IMODE(src.stat().st_mode))
        log(f"restored {dst}")
        ssh_touched = ssh_touched or str(dst).startswith("/etc/ssh/")
    log(f"rollback from {stamp} complete")
    if ssh_touched:
        cmd(["sshd", "-t"], check=False)
        cmd(["systemctl", "reload", ssh_unit()], check=False)


# -------------------------------------------------------------- sync-data
def op_sync_data(args) -> None:
    m = load_manifest()
    d = m.get("data", {})
    paths = list(args.paths) if getattr(args, "paths", None) else list(d.get("paths", []))
    if not paths:
        log("no data paths configured in manifest.toml [data] paths = [...]")
        return
    if args.destination is None:
        die("sync-data needs --destination user@host:/path")
    for p in paths:
        src = expand(p, m["target"]["home"])
        if not src.exists():
            log(f"skip missing {src}", "WARN")
            continue
        argv = ["rsync", "-a", "--info=progress2"]
        if args.dry_run:
            argv.append("-n")
        for ex in d.get("exclude", []):
            argv += ["--exclude", ex]
        for ex in args.exclude:
            argv += ["--exclude", ex]
        operand = str(src) + ("/" if src.is_dir() else "")
        argv += ["--", operand, args.destination]
        cmd(argv, check=False)


# -------------------------------------------------------------- vault
# Secrets live here, never in the repo. The repo only knows the command names.
DEFAULT_VAULT_DIR = VPS_DATA / "vault"
VAULT_CONFIG_NAME = "vault.toml"
VAULT_ALIAS_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")


def valid_vault_alias(alias: str) -> bool:
    return isinstance(alias, str) and VAULT_ALIAS_RE.match(alias) is not None

VAULT_CONFIG_TEMPLATE = """\
version = 1
passphrase_file = "keys/passphrase.txt"
archives_dir = "archives"
backups_dir = "backups"
inventory = "inventory.toml"
"""

VAULT_INVENTORY_TEMPLATE = """\
# This inventory lives OUTSIDE the git repo. Never copy it into the mirror.
# Aliases are safe labels; the paths and values below are real and stay here.
version = 1

[targets."github-deploy"]
path = "~/.ssh/deploy-github"
mode = "0600"

[identities."vps-login"]
path = "~/.config/vps-mirror-vault/identity/vps-login"
value = "example-user"
mode = "0600"
"""

VAULT_README = """\
# vps-mirror vault

This directory is intentionally **outside** the git repo and outside
`vpsclone bundle`. Nothing in here should ever be committed or transferred via
the mirror.

- `inventory.toml` contains real paths and identity values. Keep it here only.
- `keys/passphrase.txt` is the GPG symmetric passphrase. Keep it here only,
  mode 0600.
- `archives/` contains encrypted tarballs only. Safest to copy these to offline
  media or a separate private store.
- `bin/pack.sh` and `bin/unpack.sh` are thin wrappers with no embedded secrets.

Typical flow:

    # 1. edit inventory.toml to point at your real files / identity values
    # 2. pack (prints aliases only, never contents)
    ./bin/pack.sh --dry-run
    ./bin/pack.sh

    # 3. restore on the target (copies real paths from THIS inventory)
    ./bin/unpack.sh --dry-run
    ./bin/unpack.sh --yes

Other commands:

    vpsclone vault-list   --vault-dir __VAULT__
    vpsclone vault-verify --vault-dir __VAULT__

Restore never follows symlinks, validates archive members, backs up anything it
would overwrite into `backups/`, and asks for confirmation unless `--yes` is
given. Encryption uses GPG symmetric encryption with the local passphrase file.
"""


def vault_dir_arg(args) -> Path:
    raw = getattr(args, "vault_dir", None) or DEFAULT_VAULT_DIR
    return Path(raw).expanduser().absolute()


def vault_path(vdir: Path, value: str) -> Path:
    p = Path(value).expanduser()
    return p if p.is_absolute() else vdir / p


def vault_expand(value: str) -> Path:
    p = expand(value, str(Path.home()))
    if not p.is_absolute():
        die(f"vault inventory paths must be absolute or start with ~/: {value}")
    return p


def vault_load_config(vdir: Path) -> dict:
    p = vdir / VAULT_CONFIG_NAME
    if not p.is_file():
        die(f"no vault at {vdir} - run `vpsclone vault-scaffold --dir ...`")
    assert_no_symlink_components(vdir)
    assert_regular_file(p, root=vdir)
    with p.open("rb") as f:
        cfg = tomllib.load(f)
    if cfg.get("version") != 1:
        die("unsupported vault config version")
    return cfg


def vault_backend(cfg: dict, vdir: Path) -> tuple[list[str], list[str]]:
    """Return (encrypt-template, decrypt-template) for GPG symmetric crypto."""
    if not shutil.which("gpg"):
        die("gpg backend needs `gpg` installed")
    passfile = vault_path(vdir, cfg.get("passphrase_file", "keys/passphrase.txt"))
    assert_regular_file(passfile, root=vdir)
    base = ["gpg", "--batch", "--yes", "--pinentry-mode", "loopback",
            "--passphrase-file", str(passfile)]
    return (base + ["-o", "__OUT__", "-c", "__IN__"],
            base + ["-o", "__OUT__", "-d", "__IN__"])


def vault_run(template: list[str], src: Path, dst: Path) -> None:
    argv = [str(dst) if a == "__OUT__" else str(src) if a == "__IN__" else a
            for a in template]
    cmd(argv, check=True, quiet=True)


def vault_inventory(vdir: Path, cfg: dict) -> list[dict]:
    p = vault_path(vdir, cfg.get("inventory", "inventory.toml"))
    assert_no_symlink_components(vdir)
    assert_regular_file(p, root=vdir)
    with p.open("rb") as f:
        inv = tomllib.load(f)
    if inv.get("version") != 1:
        die("unsupported vault inventory version")
    items = []
    seen = set()
    for kind, table in (("target", inv.get("targets", {})),
                        ("identity", inv.get("identities", {}))):
        if not isinstance(table, dict):
            die(f"vault inventory [{kind}s] must be a table")
        for alias, spec in table.items():
            if not valid_vault_alias(alias):
                die(f"invalid vault alias: {alias}")
            key = (kind, alias)
            if key in seen:
                die(f"duplicate vault alias: {kind}/{alias}")
            seen.add(key)
            if not isinstance(spec, dict):
                die(f"vault item {alias} must be a table")
            raw_path = spec.get("path")
            if not isinstance(raw_path, str) or not raw_path.strip():
                die(f"vault item {alias} needs a path")
            mode_raw = str(spec.get("mode", "0600"))
            try:
                mode = int(mode_raw, 8)
            except ValueError:
                die(f"vault item {alias} has invalid mode: {mode_raw}")
            if not 0 <= mode <= 0o777:
                die(f"vault item {alias} mode out of range: {mode_raw}")
            value = spec.get("value")
            if value is not None and not isinstance(value, str):
                die(f"vault identity {alias} value must be a string")
            if kind == "identity" and value is None:
                die(f"vault identity {alias} needs a value")
            items.append({"kind": kind, "alias": alias, "path": vault_expand(raw_path),
                          "mode": mode, "value": value})
    if not items:
        die("vault inventory has no items")
    return items


def vault_member(kind: str, alias: str) -> str:
    return f"{'targets' if kind == 'target' else 'identities'}/{alias}"


def vault_add(tf: tarfile.TarFile, name: str, data: bytes, mode: int) -> None:
    ti = tarfile.TarInfo(name)
    ti.size = len(data)
    ti.mode = mode
    ti.mtime = int(dt.datetime.now().timestamp())
    ti.uid = ti.gid = 0
    tf.addfile(ti, io.BytesIO(data))


def vault_archive(vdir: Path, cfg: dict, explicit: str | None = None) -> Path:
    if explicit:
        p = Path(explicit).expanduser().absolute()
        assert_regular_file(p)
        return p
    d = vault_path(vdir, cfg.get("archives_dir", "archives"))
    assert_no_symlink_components(d, root=vdir)
    candidates = [p for p in d.glob("secrets-*.gpg")
                  if p.is_file() and not p.is_symlink()]
    if not candidates:
        die(f"no vault archives in {d}")
    return max(candidates, key=lambda p: p.stat().st_mtime)


def vault_read_archive(vdir: Path, cfg: dict, archive: Path):
    """Decrypt and validate; returns (meta, {member-name: bytes}). Never extracts."""
    _, dec = vault_backend(cfg, vdir)
    assert_regular_file(archive)
    with tempfile.TemporaryDirectory(prefix="vault-read-", dir=vdir) as td:
        tar_path = Path(td) / "secrets.tar.gz"
        vault_run(dec, archive, tar_path)
        meta = None
        blobs = {}
        total = 0
        with tarfile.open(tar_path, "r:gz") as tf:
            members = tf.getmembers()
            expected = set()
            for m in members:
                if not m.isfile() or m.name.startswith("/") or ".." in Path(m.name).parts:
                    die("vault archive contains an unsafe member")
                if m.name == "meta.json":
                    continue
                kind, sep, alias = m.name.partition("/")
                if sep != "/" or kind not in ("targets", "identities"):
                    die(f"vault archive has unknown member: {m.name}")
                if not valid_vault_alias(alias):
                    die(f"vault archive has invalid alias: {alias}")
                if m.size > 100 * 1024 * 1024:
                    die("vault archive member is too large")
                total += m.size
                if total > 500 * 1024 * 1024:
                    die("vault archive is too large")
                expected.add(m.name)
            mf = tf.extractfile("meta.json")
            if mf is None:
                die("vault archive is missing meta.json")
            meta = json.loads(mf.read().decode())
            if meta.get("version") != 1 or not isinstance(meta.get("items"), list):
                die("vault archive metadata is invalid")
            listed = set()
            for ent in meta["items"]:
                kind = ent.get("kind")
                alias = ent.get("alias")
                if kind not in ("target", "identity") or not valid_vault_alias(alias):
                    die("vault archive metadata has an invalid item")
                listed.add(vault_member(kind, alias))
            if listed != expected:
                die("vault archive metadata does not match its members")
            for m in members:
                if m.name == "meta.json":
                    continue
                f = tf.extractfile(m)
                blobs[m.name] = f.read() if f else b""
        return meta, blobs


def add_git_excludes() -> None:
    """Local-only guard: keep vault artifacts out of git even if moved inside."""
    gitdir = REPO / ".git"
    if not gitdir.exists():
        return
    info = gitdir / "info"
    info.mkdir(parents=True, exist_ok=True)
    p = info / "exclude"
    lines = p.read_text(errors="replace").splitlines() if p.exists() else []
    additions = [x for x in ("/vault/", "/secrets/", "/.vault/", "*.gpg")
                 if x not in lines]
    if additions:
        with p.open("a") as f:
            f.write("\n# vps-mirror vault (local guard)\n")
            f.write("\n".join(additions) + "\n")


def op_vault_scaffold(args) -> None:
    vdir = Path(args.dir).expanduser().absolute()
    cfgp = vdir / VAULT_CONFIG_NAME
    if cfgp.exists() and not args.force:
        die(f"vault already exists at {vdir} (use --force to refresh generated files)")
    try:
        vdir.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as e:
        die(f"cannot create vault dir {vdir}: {e}")
    os.chmod(vdir, 0o700)
    assert_no_symlink_components(vdir)
    for name in ("keys", "archives", "backups", "bin"):
        p = vdir / name
        p.mkdir(exist_ok=True, mode=0o700)
        os.chmod(p, 0o700)
        assert_no_symlink_components(p, root=vdir)

    # --force refreshes generated wrappers only. Keys and inventory are
    # user-owned data: rotating the passphrase makes existing archives
    # undecryptable and overwriting the inventory destroys real paths.
    if not shutil.which("gpg"):
        die("gpg backend needs `gpg` installed")
    passfile = vdir / "keys/passphrase.txt"
    if passfile.exists():
        assert_regular_file(passfile, root=vdir)
    else:
        atomic_write_text(passfile, secrets.token_urlsafe(32) + "\n", mode=0o600)

    if not cfgp.exists():
        atomic_write_text(cfgp, VAULT_CONFIG_TEMPLATE, mode=0o600)
    invp = vdir / "inventory.toml"
    if not invp.exists():
        atomic_write_text(invp, VAULT_INVENTORY_TEMPLATE, mode=0o600)

    vpsclone = shlex.quote(str(Path(__file__).resolve()))
    for filename, subcommand in (("pack.sh", "vault-pack"),
                                 ("unpack.sh", "vault-unpack")):
        body = (
            "#!/bin/sh\n"
            "set -eu\n"
            'VAULT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)\n'
            f'exec {vpsclone} {subcommand} --vault-dir "$VAULT_DIR" "$@"\n'
        )
        atomic_write_text(vdir / "bin" / filename, body, mode=0o755)

    atomic_write_text(vdir / "README.md",
                      VAULT_README.replace("__VAULT__", str(vdir)), mode=0o644)
    add_git_excludes()
    log(f"vault: scaffolded {vdir} (backend: gpg)")
    log("vault: edit inventory.toml, then run bin/pack.sh")


def op_vault_pack(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    enc, _ = vault_backend(cfg, vdir)
    items = vault_inventory(vdir, cfg)

    if args.dry_run:
        for i in items:
            log(f"vault: would pack {i['kind']}:{i['alias']}")
        log(f"vault: dry-run complete ({len(items)} items)")
        return

    payload = []
    for i in items:
        if i["kind"] == "target":
            src = i["path"]
            assert_regular_file(src)
            data = src.read_bytes()
        else:
            data = i["value"].encode()
        payload.append((i, data))

    archives = vault_path(vdir, cfg.get("archives_dir", "archives"))
    archives.mkdir(parents=True, exist_ok=True, mode=0o700)
    assert_no_symlink_components(archives, root=vdir)
    stamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    out = (Path(args.output).expanduser().absolute() if args.output
           else archives / f"secrets-{stamp}.gpg")
    if out.exists():
        die(f"refusing to overwrite existing archive: {out}")
    if args.output:
        assert_no_symlink_components(out)
    else:
        assert_no_symlink_components(out, root=vdir)

    with tempfile.TemporaryDirectory(prefix="vault-pack-", dir=archives) as td:
        tar_path = Path(td) / "secrets.tar.gz"
        meta = {
            "version": 1,
            "created": now(),
            "items": [{"kind": i["kind"], "alias": i["alias"],
                       "mode": oct(i["mode"])} for i, _ in payload],
        }
        with tarfile.open(tar_path, "w:gz") as tf:
            vault_add(tf, "meta.json", json.dumps(meta).encode(), 0o600)
            for i, data in payload:
                vault_add(tf, vault_member(i["kind"], i["alias"]), data, i["mode"])
        vault_run(enc, tar_path, out)
    os.chmod(out, 0o600)
    log(f"vault: wrote {out} ({len(payload)} items)")


def op_vault_unpack(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    archive = vault_archive(vdir, cfg, args.archive)
    items = vault_inventory(vdir, cfg)
    meta, blobs = vault_read_archive(vdir, cfg, archive)

    item_map = {(i["kind"], i["alias"]): i for i in items}
    restore = []
    for ent in meta["items"]:
        kind, alias = ent.get("kind"), ent.get("alias")
        if kind not in ("target", "identity") or not isinstance(alias, str):
            die("vault archive metadata has an invalid item")
        key = (kind, alias)
        if key not in item_map:
            die(f"archive item {alias} is missing from this vault inventory")
        member = vault_member(kind, alias)
        if member not in blobs:
            die(f"archive member missing: {member}")
        restore.append((item_map[key], blobs[member]))
    if not restore:
        die("vault archive has no items")

    if args.dry_run:
        for i, _ in restore:
            log(f"vault: would restore {i['kind']}:{i['alias']}")
        log(f"vault: dry-run complete ({len(restore)} items)")
        return

    if not args.yes:
        try:
            answer = input(f"Restore {len(restore)} vault item(s) from "
                           f"{archive.name}? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            die("aborted")

    backups = vault_path(vdir, cfg.get("backups_dir", "backups"))
    stamp = dt.datetime.now().strftime("%Y%m%dT%H%M%S")
    for i, data in restore:
        dst = i["path"]
        if dst.exists() or dst.is_symlink():
            bdir = backups / stamp
            bdir.mkdir(parents=True, exist_ok=True, mode=0o700)
            bp = bdir / f"{i['kind']}-{i['alias']}"
            assert_no_symlink_components(bp, root=vdir)
            st = dst.lstat()
            if st and stat.S_ISREG(st.st_mode):
                write_bytes_no_symlink(bp, dst.read_bytes(),
                                       mode=stat.S_IMODE(st.st_mode))
        write_bytes_no_symlink(dst, data, mode=i["mode"])
        log(f"vault: restored {i['kind']}:{i['alias']}")
    log(f"vault: restore complete ({len(restore)} items)")


def op_vault_list(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    items = vault_inventory(vdir, cfg)
    print(f"VAULT {vdir}")
    for i in items:
        present = (i["kind"] == "identity" or
                   (i["path"].is_file() and not i["path"].is_symlink()))
        print(f"  [{'ok' if present else 'MISSING':<7}] "
              f"{i['kind']:<8} {i['alias']:<24} {oct(i['mode'])}")


def op_vault_verify(args) -> None:
    vdir = vault_dir_arg(args)
    cfg = vault_load_config(vdir)
    archive = vault_archive(vdir, cfg, args.archive)
    meta, blobs = vault_read_archive(vdir, cfg, archive)
    print(f"VAULT ARCHIVE {archive.name}")
    print(f"  items:   {len(meta['items'])}")
    print(f"  payload: {len(blobs) - 1 if 'meta.json' in blobs else len(blobs)} file(s)")
    log("vault: archive verified")


# -------------------------------------------------------------- doctor
def op_doctor(args) -> int:
    rows = [
        ("root", is_root(), "needed for apply"),
        ("python3 >= 3.11", sys.version_info >= (3, 11), sys.version.split()[0]),
        ("apt / dpkg", shutil.which("apt-get") is not None, ""),
        ("git", shutil.which("git") is not None, ""),
        ("rsync", shutil.which("rsync") is not None, ""),
        ("openssh-server", Path("/etc/ssh/sshd_config").exists(), ""),
        ("manifest present", MANIFEST.exists(), str(MANIFEST)),
    ]
    print("\nDOCTOR\n")
    bad = 0
    for name, ok, detail in rows:
        if not ok:
            bad += 1
        print(f"  [{'PASS' if ok else 'FAIL'}] {name:<20} {detail}")
    _, disk = cmd(["df", "-h", "/"], quiet=True)
    print("\n" + disk.strip() + "\n")
    if bad:
        log(f"doctor: {bad} problem(s)", "ERROR")
        return 1
    log("doctor: ready")
    return 0


